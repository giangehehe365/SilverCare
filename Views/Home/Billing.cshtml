    async function openInvoiceDetail(invoiceId) {
        const inv = invoicesCache.find(i => i.id === invoiceId);
        if (!inv) return;
        activeInvoiceId = invoiceId;

        document.getElementById("detail-invoice-code").innerText = inv.code || ("#" + inv.id);
        document.getElementById("detail-resident-name").innerText = inv.residentName;
        document.getElementById("detail-period").innerText = `${String(inv.month).padStart(2, "0")}/${inv.year}`;
        document.getElementById("detail-due-date").innerText = inv.dueDate ? formatDateVN(inv.dueDate) : "Không có";
        document.getElementById("detail-note-text").innerText = inv.note || "Không có";
        document.getElementById("detail-status-badge").innerHTML = `<span class="bil-badge ${statusBadgeClass(inv.status)}">${inv.status}</span>`;

        const { data: items } = await window.sb
            .from("invoice_items")
            .select("description, quantity, unit_price, amount")
            .eq("invoice_id", invoiceId)
            .order("invoice_item_id");

        document.getElementById("detail-items-body").innerHTML = (items || []).map(it => `
            <tr><td>${escapeHtml(it.description)}</td><td>${it.quantity}</td><td>${formatVND(it.unit_price)}</td><td>${formatVND(it.amount)}</td></tr>
        `).join("");
        document.getElementById("detail-total-display").innerText = formatVND(inv.total);

        await loadAndRenderPayments(invoiceId);

        const canPay = inv.status !== "Đã thanh toán" && inv.status !== "Đã hủy";
        const familySection = document.getElementById("family-payment-section");
        if (familySection) {
            familySection.style.display = (window.currentUser && window.currentUser.role === "family" && canPay) ? "block" : "none";
        }
        // Hóa đơn đã thanh toán bị khóa ở tầng DB (trigger trg_protect_paid_invoice
        // chặn cả admin) — ẩn luôn nút Sửa/Xóa ở đây để không hiện lỗi khó hiểu.
        const isPaid = inv.status === "Đã thanh toán";
        document.getElementById("btn-delete-invoice").style.display = isPaid ? "none" : "";
        document.getElementById("btn-edit-invoice").style.display = isPaid ? "none" : "";

        if (window.currentUser) applyDataRolesWithin(invoiceDetailModal, window.currentUser.role);
        invoiceDetailModal.classList.add("active");
    }

    async function loadAndRenderPayments(invoiceId) {
        const { data } = await window.sb
            .from("payments")
            .select("payment_id, amount, method, status, transaction_ref, paid_at, profiles(full_name)")
            .eq("invoice_id", invoiceId)
            .order("paid_at", { ascending: false });

        const list = document.getElementById("detail-payments-list");
        const empty = document.getElementById("detail-payments-empty");

        if (!data || data.length === 0) {
            list.innerHTML = "";
            empty.style.display = "block";
            return;
        }
        empty.style.display = "none";

        const isStaff = window.currentUser && ["admin", "manager"].indexOf(window.currentUser.role) !== -1;
        list.innerHTML = data.map(p => {
            const badgeClass = p.status === "Thành công" ? "bil-badge-success" : (p.status === "Thất bại" ? "bil-badge-failed" : "bil-badge-pending");
            const confirmBtn = (isStaff && p.status === "Chờ xác nhận")
                ? `<button type="button" data-action="confirm-payment" data-id="${p.payment_id}" style="margin-left:8px; border:none; background:none; color:var(--color-primary); font-weight:600; cursor:pointer;">Xác nhận</button>`
                : "";
            // Nút đối soát thủ công: dùng khi IPN của VNPay chưa gọi về được —
            // chủ động hỏi thẳng VNPay qua API querydr thay vì ngồi chờ.
            const syncBtn = (p.method === "VNPay" && p.status === "Chờ xác nhận" && p.transaction_ref)
                ? `<button type="button" data-action="sync-vnpay" data-txnref="${escapeHtml(p.transaction_ref)}" style="margin-left:8px; border:none; background:none; color:#667085; font-weight:600; cursor:pointer;">Đồng bộ với VNPay</button>`
                : "";
            return `<div class="bil-payment-row">
                <span>${formatDateVN((p.paid_at || "").substring(0, 10))} &middot; ${escapeHtml(p.method)} &middot; ${escapeHtml(p.profiles ? p.profiles.full_name : "")}${p.transaction_ref ? " &middot; " + escapeHtml(p.transaction_ref) : ""}</span>
                <span>${formatVND(p.amount)} <span class="bil-badge ${badgeClass}">${p.status}</span>${confirmBtn}${syncBtn}</span>
            </div>`;
        }).join("");
    }

    async function syncVnpayStatus(transactionRef, btnEl) {
        if (!transactionRef) return;
        const originalText = btnEl.textContent;
        btnEl.disabled = true;
        btnEl.textContent = "Đang đồng bộ...";

        const { data, error } = await window.sb.functions.invoke("vnpay-query-status", {
            body: { transaction_ref: transactionRef }
        });

        btnEl.disabled = false;
        btnEl.textContent = originalText;

        if (error || !data || data.error) {
            alert("Không thể đồng bộ: " + ((data && data.error) || (error && error.message) || "Lỗi không xác định"));
            return;
        }

        if (data.status === "Chờ xác nhận") {
            showToast(data.message || "VNPay vẫn chưa xử lý xong giao dịch này.");
            return;
        }

        showToast(data.status === "Thành công" ? "Đã đồng bộ: thanh toán thành công!" : "Đã đồng bộ: giao dịch thất bại.");
        await loadInvoices();
        if (activeInvoiceId) await openInvoiceDetail(activeInvoiceId);
    }

    async function confirmPayment(paymentId) {
        if (!confirm("Xác nhận đã nhận được khoản thanh toán này?")) return;
        const { error } = await window.sb.from("payments").update({ status: "Thành công" }).eq("payment_id", paymentId);
        if (error) { alert("Không thể xác nhận: " + error.message); return; }
        showToast("Đã xác nhận thanh toán.");
        await loadInvoices();
        await openInvoiceDetail(activeInvoiceId);
    }

    document.getElementById("btn-close-invoice-detail").addEventListener("click", closeInvoiceDetailModal);
    invoiceDetailModal.addEventListener("click", function (e) { if (e.target === invoiceDetailModal) closeInvoiceDetailModal(); });

    document.getElementById("btn-pay-vnpay").addEventListener("click", async function () {
        if (!activeInvoiceId) return;
        const btn = this;
        const statusMsg = document.getElementById("vnpay-status-msg");
        btn.disabled = true;
        statusMsg.style.display = "block";
        statusMsg.textContent = "Đang tạo liên kết thanh toán VNPay...";

        const returnUrl = window.location.origin + window.location.pathname + "?vnpay_return=1&invoice_id=" + activeInvoiceId;
        const { data, error } = await window.sb.functions.invoke("vnpay-create-payment", {
            body: { invoice_id: activeInvoiceId, return_url: returnUrl }
        });

        if (error || !data || data.error || !data.paymentUrl) {
            const msg = (data && data.error) || (error && error.message) || "Không thể tạo liên kết thanh toán.";
            statusMsg.textContent = "Lỗi: " + msg;
            btn.disabled = false;
            return;
        }

        statusMsg.textContent = "Đang chuyển tới trang thanh toán VNPay (sandbox)...";
        window.location.href = data.paymentUrl;
    });

    document.getElementById("btn-delete-invoice").addEventListener("click", async function () {
        if (!activeInvoiceId) return;
        if (!confirm("Xóa hóa đơn này? Toàn bộ dòng mục và lịch sử thanh toán liên quan cũng sẽ bị xóa.")) return;

        const { error } = await window.sb.from("invoices").delete().eq("invoice_id", activeInvoiceId);
        if (error) { alert("Không thể xóa: " + error.message); return; }

        closeInvoiceDetailModal();
        showToast("Đã xóa hóa đơn.");
