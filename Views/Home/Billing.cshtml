    // Sau khi VNPay chuyển trình duyệt về đây, KHÔNG tin bất kỳ tham số nào
    // trên URL (người dùng có thể tự sửa vnp_ResponseCode=00 trên thanh địa
    // chỉ). Trạng thái thật chỉ do vnpay-ipn ghi vào DB. Vì IPN có thể chưa
    // được VNPay gọi kịp (hoặc chưa cấu hình xong ở phía VNPay), ở đây CHỦ
    // ĐỘNG gọi thẳng vnpay-query-status để tự đối soát — không ngồi chờ thụ
    // động — nên người dùng không cần tự bấm nút "Đồng bộ với VNPay" nữa.
    async function handleVnpayReturn() {
        const params = new URLSearchParams(window.location.search);
        if (params.get("vnpay_return") !== "1") return;
        const invoiceId = parseInt(params.get("invoice_id"), 10);

        // Xóa query string khỏi URL để không xử lý lại nếu người dùng F5
        history.replaceState(null, "", window.location.pathname);

        if (!invoiceId) return;
        showToast("Đang xác nhận kết quả thanh toán VNPay...");

        const { data: pendingPays } = await window.sb
            .from("payments")
            .select("transaction_ref, status")
            .eq("invoice_id", invoiceId)
            .eq("method", "VNPay")
            .order("payment_id", { ascending: false })
            .limit(1);
        const txnRef = pendingPays && pendingPays[0] ? pendingPays[0].transaction_ref : null;

        let finalStatus = null;
        for (let i = 0; i < 5; i++) {
            await new Promise((r) => setTimeout(r, 1500));

            // Ưu tiên hỏi thẳng VNPay (đường chủ động) — nếu IPN đã tự cập
            // nhật trước đó thì query-status trả về ngay trạng thái đã có,
            // không gọi lại VNPay lần nữa.
            if (txnRef) {
                const { data: syncData } = await window.sb.functions.invoke("vnpay-query-status", { body: { transaction_ref: txnRef } });
                if (syncData && syncData.status === "Thành công") { finalStatus = "success"; break; }
                if (syncData && syncData.status === "Thất bại") { finalStatus = "failed"; break; }
            }
        }

        await loadInvoices();
        await openInvoiceDetail(invoiceId);

        if (finalStatus === "success") {
            showToast("Thanh toán VNPay thành công!");
        } else if (finalStatus === "failed") {
            showToast("Thanh toán VNPay không thành công.");
        } else {
            showToast("Chưa nhận được xác nhận từ VNPay — bấm \"Đồng bộ với VNPay\" trong vài phút nữa để kiểm tra lại.");
        }
    }
</script>
}
