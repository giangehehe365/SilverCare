                    name, description: description || null, monthly_price: price, is_active: isActive
                }).eq("service_package_id", editingPackageId);
                if (error) throw error;
            } else {
                const { error } = await window.sb.from("service_packages").insert({
                    name, description: description || null, monthly_price: price, is_active: isActive
                });
                if (error) throw error;
            }

            closePackageModal();
            showToast("Đã lưu gói dịch vụ.");
            await loadPackagesCache();
            renderPackagesTable();
