@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dashboard";

    // Dynamic dates in Vietnamese formatting
    var now = DateTime.Now;
    var dayOfWeekVi = now.DayOfWeek switch
    {
        DayOfWeek.Sunday => "Chủ Nhật",
        DayOfWeek.Monday => "Thứ Hai",
        DayOfWeek.Tuesday => "Thứ Ba",
        DayOfWeek.Wednesday => "Thứ Tư",
        DayOfWeek.Thursday => "Thứ Năm",
        DayOfWeek.Friday => "Thứ Sáu",
        DayOfWeek.Saturday => "Thứ Bảy",
        _ => ""
    };
    var dateString = $"{dayOfWeekVi}, {now.Day} Tháng {now.Month}, {now.Year}";
}

<style>
    /* Dashboard Todo Items */
    .dash-todo-list {
        display: flex;
        flex-direction: column;
    }

    .dash-todo-item {
        display: grid;
        grid-template-columns: 65px 1fr auto;
        align-items: center;
        padding: 16px 0;
        border-bottom: 1px solid #f2f4f7;
        transition: background-color 0.15s ease;
    }

    .dash-todo-item:last-child {
        border-bottom: none;
    }

    .dash-todo-time {
        font-size: 14px;
        font-weight: 600;
        color: #475467;
    }

    .dash-todo-info {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .dash-todo-title {
        font-size: 15px;
        font-weight: 600;
        color: #101828;
    }

    .dash-todo-meta {
        font-size: 13px;
        color: #667085;
    }

    .dash-todo-badge {
        font-size: 12px;
        padding: 6px 14px;
        border-radius: 12px;
        white-space: nowrap;
    }

    .badge-dash-todo {
        background-color: #f2f4f7;
        color: #475467;
        font-weight: 500;
    }

    .badge-dash-pending {
        background-color: #fef0c7;
        color: #b54708;
        font-weight: 600;
    }

    /* Dashboard Activities List */
    .dash-activity-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .dash-activity-item {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .dash-activity-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .dash-activity-icon.icon-blue {
        background-color: #e0f2fe;
        color: #0ba5ec;
    }

    .dash-activity-icon.icon-green {
        background-color: #ecfdf3;
        color: #12b76a;
    }

    .dash-activity-icon.icon-orange {
        background-color: #fffaeb;
        color: #f79009;
    }

    .dash-activity-icon.icon-red {
        background-color: #fef3f2;
        color: #f04438;
    }

    .dash-activity-icon.icon-gray {
        background-color: #f2f4f7;
        color: #667085;
    }

    .dash-activity-icon svg {
        width: 20px;
        height: 20px;
        stroke: currentColor;
        stroke-width: 2;
        fill: none;
    }

    .dash-activity-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .dash-activity-title {
        font-size: 14px;
        font-weight: 600;
        color: #101828;
    }

    .dash-activity-meta {
        font-size: 12px;
        color: #667085;
    }
</style>

<div class="welcome-banner">
    <h1 class="welcome-title">Xin chào, <span data-user-fullname>---</span> 👋</h1>
    <p class="welcome-subtitle">@dateString</p>
</div>

<!-- KPI Cards -->
<section class="kpi-grid">
    <!-- Card 1: Tổng số người cao tuổi -->
    <div class="kpi-card">
        <div class="kpi-header">
            <div class="kpi-icon-wrapper kpi-icon-blue">
                <!-- Users Icon -->
                <svg viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </div>
        </div>
        <div class="kpi-body">
            <span class="kpi-value" id="kpi-elderly-count">3</span>
            <span class="kpi-title">Tổng số người cao tuổi</span>
        </div>
        <div class="kpi-footer" id="kpi-elderly-footer">Số hồ sơ trong Hồ sơ người cao tuổi</div>
    </div>

    <!-- Card 2: Đã hoàn thành hôm nay -->
    <div class="kpi-card">
        <div class="kpi-header">
            <div class="kpi-icon-wrapper kpi-icon-green">
                <!-- Check Circle Icon -->
                <svg viewBox="0 0 24 24">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
            </div>
        </div>
        <div class="kpi-body">
            <span class="kpi-value" id="kpi-completed-count">1</span>
            <span class="kpi-title">Đã hoàn thành hôm nay</span>
        </div>
        <div class="kpi-footer" id="kpi-completed-rate">20% tỷ lệ hoàn thành</div>
    </div>

    <!-- Card 3: Cảnh báo sức khỏe -->
    <div class="kpi-card" onclick="location.href='@Url.Action("Notifications", "Home")'" style="cursor: pointer;" title="Xem chi tiết Cảnh báo & Thông báo">
        <div class="kpi-header">
            <div class="kpi-icon-wrapper kpi-icon-red">
                <!-- Alert Triangle Icon -->
                <svg viewBox="0 0 24 24">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                    <line x1="12" y1="9" x2="12" y2="13" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
            </div>
        </div>
        <div class="kpi-body">
            <span class="kpi-value" id="kpi-health-alerts-count">3</span>
            <span class="kpi-title">Cảnh báo sức khỏe</span>
        </div>
        <div class="kpi-footer" id="kpi-health-alerts-footer">1 mức cao, 2 trung bình</div>
    </div>

    <!-- Card 4: Lịch chăm sóc hôm nay -->
    <div class="kpi-card">
        <div class="kpi-header">
            <div class="kpi-icon-wrapper kpi-icon-orange">
                <!-- Calendar Icon -->
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </div>
        </div>
        <div class="kpi-body">
            <span class="kpi-value" id="kpi-total-schedule">5</span>
            <span class="kpi-title">Lịch chăm sóc hôm nay</span>
        </div>
        <div class="kpi-footer" id="kpi-uncompleted-text">4 chưa thực hiện</div>
    </div>
</section>

<!-- Main Grid Section -->
<div class="dashboard-grid">
    <!-- Left Column -->
    <div class="dashboard-col-left">
        <!-- 1. Theo dõi sức khỏe 7 ngày gần đây -->
        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <h2 class="dashboard-card-title">Theo dõi sức khỏe 7 ngày gần đây</h2>
                <a href="@Url.Action("Health", "Home")" class="dashboard-card-link">Xem chi tiết &rarr;</a>
            </div>
            <div class="chart-container-inner">
                <svg viewBox="0 0 700 230" class="chart-svg-graphic">
                    <!-- Grid horizontal lines -->
                    <line x1="50" y1="30" x2="680" y2="30" class="chart-grid-line" />
                    <line x1="50" y1="70" x2="680" y2="70" class="chart-grid-line" />
                    <line x1="50" y1="110" x2="680" y2="110" class="chart-grid-line" />
                    <line x1="50" y1="150" x2="680" y2="150" class="chart-grid-line" />
                    
                    <!-- Y Axis labels -->
                    <text x="40" y="34" text-anchor="end" class="chart-axis-text">160</text>
                    <text x="40" y="74" text-anchor="end" class="chart-axis-text">120</text>
                    <text x="40" y="114" text-anchor="end" class="chart-axis-text">80</text>
                    <text x="40" y="154" text-anchor="end" class="chart-axis-text">40</text>
                    <text x="40" y="194" text-anchor="end" class="chart-axis-text">0</text>
                    
                    <!-- Y Axis Line -->
                    <line x1="50" y1="10" x2="50" y2="190" class="chart-axis-line" />
                    
                    <!-- X Axis Line -->
                    <line x1="50" y1="190" x2="680" y2="190" class="chart-axis-line" />
                    
                    <!-- X Axis labels -->
                    <g id="dash-chart-x-labels"></g>

                    <!-- Trend lines (trung bình toàn trung tâm mỗi ngày) -->
                    <path id="dash-path-sys" stroke="#f04438" stroke-width="2.5" fill="none" />
                    <path id="dash-path-dia" stroke="#f79009" stroke-width="2.5" fill="none" />
                    <path id="dash-path-hr" stroke="#12b76a" stroke-width="2.5" fill="none" />
                </svg>
                
                <div class="chart-legend">
                    <div class="chart-legend-item">
                        <span class="chart-legend-color" style="background-color: #f04438;"></span>
                        <span>Huyết áp tâm thu</span>
                    </div>
                    <div class="chart-legend-item">
                        <span class="chart-legend-color" style="background-color: #f79009;"></span>
                        <span>Huyết áp tâm trương</span>
                    </div>
                    <div class="chart-legend-item">
                        <span class="chart-legend-color" style="background-color: #12b76a;"></span>
                        <span>Nhịp tim</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Việc cần làm hôm nay (Chỉ lấy những việc chưa hoàn thành từ Lịch chăm sóc) -->
        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <h2 class="dashboard-card-title">Việc cần làm hôm nay</h2>
                <a href="@Url.Action("Schedule", "Home")" class="dashboard-card-link">Xem tất cả &rarr;</a>
            </div>

            <!-- Dynamic Uncompleted Tasks Container -->
            <div class="dash-todo-list" id="dash-todo-container">
                <!-- Populated dynamically: Only todo & pending tasks -->
            </div>

            <!-- Empty state when all tasks are done -->
            <div class="empty-state" id="dash-todo-empty" style="display: none;">
                <svg viewBox="0 0 24 24">
                    <polyline points="9 11 12 14 22 4" />
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                </svg>
                <p class="empty-state-text">Không có công việc cần thực hiện hôm nay (Đã hoàn thành tất cả).</p>
            </div>
        </div>

        <!-- 3. Cảnh báo sức khỏe -->
        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <h2 class="dashboard-card-title">Cảnh báo sức khỏe</h2>
                <a href="@Url.Action("Notifications", "Home")" class="dashboard-card-link">Xem tất cả &rarr;</a>
            </div>
            
            <!-- Dynamic Health Alerts List -->
            <div class="dash-activity-list" id="dash-alerts-container">
                <!-- Dynamically populated from today's updates -->
            </div>

            <!-- Empty state when no alerts for today -->
            <div class="empty-state" id="dash-alerts-empty" style="display: none;">
                <svg viewBox="0 0 24 24">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                <p class="empty-state-text">Không có cảnh báo sức khỏe bất thường trong ngày hôm nay.</p>
            </div>
        </div>

        <!-- 4. Hoạt động gần đây (Ở dưới cùng Dashboard) -->
        <div class="dashboard-card" id="recent-activities-card">
            <div class="dashboard-card-header">
                <h2 class="dashboard-card-title">Hoạt động gần đây</h2>
            </div>
            <div class="dash-activity-list" id="dash-activity-container">
                <!-- Dynamically populated from recent activities -->
            </div>
        </div>
    </div>

    <!-- Right Column -->
    <div class="dashboard-col-right">
        <!-- AI Assistant Card -->
        <div class="ai-assistant-card">
            <div class="ai-header">
                <div class="ai-header-icon">
                    <!-- Robot/AI Icon -->
                    <svg viewBox="0 0 24 24">
                        <rect x="3" y="11" width="18" height="10" rx="2" />
                        <circle cx="12" cy="5" r="2" />
                        <path d="M12 7v4" />
                        <line x1="8" y1="16" x2="8" y2="16.01" />
                        <line x1="16" y1="16" x2="16" y2="16.01" />
                    </svg>
                </div>
                <div class="ai-title-wrapper">
                    <h2 class="ai-title">AI Assistant</h2>
                    <span class="ai-subtitle">Hỗ trợ phát hiện xu hướng bất thường</span>
                </div>
            </div>
            <div class="ai-actions">
                <button class="ai-btn" onclick="location.href='@Url.Action("Health", "Home")'">
                    <span>Phân tích xu hướng sức khỏe</span>
                    <!-- Right Arrow Icon -->
                    <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6" /></svg>
                </button>
                <button class="ai-btn" onclick="location.href='@Url.Action("Schedule", "Home")'">
                    <span>Gợi ý lịch chăm sóc tối ưu</span>
                    <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6" /></svg>
                </button>
                <button class="ai-btn" onclick="location.href='@Url.Action("Residents", "Home")'">
                    <span>Tra cứu hồ sơ người cao tuổi</span>
                    <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6" /></svg>
                </button>
                <button class="ai-btn" onclick="location.href='@Url.Action("Health", "Home")'">
                    <span>Cảnh báo nguy cơ sức khỏe</span>
                    <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6" /></svg>
                </button>
            </div>
        </div>

        <!-- Quick Statistics Card -->
        <div class="stats-card">
            <h2 class="stats-title">Thống kê nhanh</h2>
            <div class="stats-list">
                <!-- Stat 1: Tỷ lệ hoàn thành -->
                <div class="stats-item">
                    <div class="stats-label-wrapper">
                        <span>Tỷ lệ hoàn thành</span>
                        <span class="stats-value" id="stats-complete-pct">20%</span>
                    </div>
                    <div class="stats-progress-track">
                        <div class="stats-progress-bar progress-blue" id="stats-complete-bar" style="width: 20%;"></div>
                    </div>
                </div>

                <!-- Stat 2: Tuân thủ thuốc -->
                <div class="stats-item">
                    <div class="stats-label-wrapper">
                        <span>Tuân thủ thuốc (hôm nay)</span>
                        <span class="stats-value" id="stats-meds-pct">--%</span>
                    </div>
                    <div class="stats-progress-track">
                        <div class="stats-progress-bar progress-green" id="stats-meds-bar" style="width: 0%;"></div>
                    </div>
                </div>

                <!-- Stat 3: Cảnh báo xử lý -->
                <div class="stats-item">
                    <div class="stats-label-wrapper">
                        <span>Cảnh báo đã xử lý</span>
                        <span class="stats-value" id="stats-alerts-handled">100%</span>
                    </div>
                    <div class="stats-progress-track">
                        <div class="stats-progress-bar progress-orange" id="stats-alerts-bar" style="width: 100%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            const now = new Date();

            function toIso(d) {
                return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
            }

            function formatTimeVN(iso) {
                if (!iso) return "";
                const d = new Date(iso);
                return `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
            }

            const todayIso = toIso(now);

            function getActivityIconSvg(iconType) {
                if (iconType === "check") {
                    return `<svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>`;
                } else if (iconType === "alert") {
                    return `<svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>`;
                } else if (iconType === "clock") {
                    return `<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>`;
                }
                return `<svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>`;
            }

            // ==========================================================================
            // 1. TỔNG SỐ NGƯỜI CAO TUỔI
            // ==========================================================================
            async function loadElderlyCount() {
                const { count } = await window.sb
                    .from("residents")
                    .select("resident_id", { count: "exact", head: true })
                    .eq("is_active", true);
                const el = document.getElementById("kpi-elderly-count");
                if (el) el.innerText = count || 0;
            }

            // ==========================================================================
            // 2. LỊCH CHĂM SÓC HÔM NAY (KPI + "Việc cần làm hôm nay")
            // ==========================================================================
            async function loadTodaySchedule() {
                let query = window.sb
                    .from("care_schedules")
                    .select("care_schedule_id, schedule_name, start_time, status, resident_id, residents(full_name, rooms(room_code))")
                    .eq("schedule_date", todayIso);

                if (window.currentUser && window.currentUser.role === "staff") {
                    query = query.eq("assigned_staff_id", window.currentUser.id);
                }

                const { data, error } = await query;
                const tasks = error ? [] : (data || []);

                const total = tasks.length;
                const completed = tasks.filter(t => t.status === "Hoàn thành").length;
                const uncompleted = total - completed;
                const rate = total > 0 ? Math.round((completed / total) * 100) : 0;

                const set = (id, text) => { const el = document.getElementById(id); if (el) el.innerText = text; };
                set("kpi-completed-count", completed);
                set("kpi-completed-rate", `${rate}% tỷ lệ hoàn thành`);
                set("kpi-total-schedule", total);
                set("kpi-uncompleted-text", `${uncompleted} chưa thực hiện`);
                set("stats-complete-pct", `${rate}%`);
                const bar = document.getElementById("stats-complete-bar");
                if (bar) bar.style.width = `${rate}%`;

                const container = document.getElementById("dash-todo-container");
                const emptyState = document.getElementById("dash-todo-empty");
                const todo = tasks
                    .filter(t => t.status !== "Hoàn thành")
                    .sort((a, b) => (a.start_time || "").localeCompare(b.start_time || ""));

                if (container) {
                    container.innerHTML = "";
                    if (todo.length === 0) {
                        if (emptyState) emptyState.style.display = "flex";
                    } else {
                        if (emptyState) emptyState.style.display = "none";
                        todo.forEach(t => {
                            const badge = t.status === "Đang thực hiện"
                                ? `<span class="dash-todo-badge badge-dash-pending">Đang thực hiện</span>`
                                : `<span class="dash-todo-badge badge-dash-todo">Chưa thực hiện</span>`;
                            const room = t.residents && t.residents.rooms ? t.residents.rooms.room_code : "---";
                            const name = t.residents ? t.residents.full_name : "";
                            const time = t.start_time ? t.start_time.substring(0, 5) : "--:--";

                            const el = document.createElement("div");
                            el.className = "dash-todo-item";
                            el.innerHTML = `
                                <span class="dash-todo-time">${time}</span>
                                <div class="dash-todo-info">
                                    <span class="dash-todo-title">${t.schedule_name}</span>
                                    <span class="dash-todo-meta">${name} &middot; Phòng ${room}</span>
                                </div>
                                <div class="dash-todo-action">${badge}</div>
                            `;
                            container.appendChild(el);
                        });
                    }
                }
            }

            // ==========================================================================
            // 3. CẢNH BÁO SỨC KHỎE ĐANG MỞ
            // ==========================================================================
            async function loadHealthAlerts() {
                const { data, error } = await window.sb
                    .from("health_alerts")
                    .select("alert_id, title, severity, created_at, residents(full_name, rooms(room_code))")
                    .eq("status", "Chưa xử lý")
                    .order("created_at", { ascending: false });

                const alerts = error ? [] : (data || []);
                const high = alerts.filter(a => a.severity === "Cao").length;
                const medium = alerts.filter(a => a.severity === "Trung bình").length;

                const set = (id, text) => { const el = document.getElementById(id); if (el) el.innerText = text; };
                set("kpi-health-alerts-count", alerts.length);
                set("kpi-health-alerts-footer", `${high} mức cao, ${medium} trung bình`);

                const container = document.getElementById("dash-alerts-container");
                const emptyState = document.getElementById("dash-alerts-empty");
                if (container) {
                    container.innerHTML = "";
                    if (alerts.length === 0) {
                        if (emptyState) emptyState.style.display = "flex";
                    } else {
                        if (emptyState) emptyState.style.display = "none";
                        alerts.slice(0, 6).forEach(a => {
                            const isHigh = a.severity === "Cao";
                            const room = a.residents && a.residents.rooms ? a.residents.rooms.room_code : "---";
                            const name = a.residents ? a.residents.full_name : "Người cao tuổi";
                            const el = document.createElement("div");
                            el.className = "dash-activity-item";
                            el.innerHTML = `
                                <div class="dash-activity-icon" style="background-color: ${isHigh ? '#fef3f2' : '#fffaeb'}; color: ${isHigh ? '#f04438' : '#f79009'};">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                                        <line x1="12" y1="9" x2="12" y2="13" />
                                        <line x1="12" y1="17" x2="12.01" y2="17" />
                                    </svg>
                                </div>
                                <div class="dash-activity-content">
                                    <span class="dash-activity-title" style="color: ${isHigh ? '#d92d20' : '#b54708'};">${a.title}</span>
                                    <span class="dash-activity-meta">${name} &middot; Phòng ${room} &middot; ${formatTimeVN(a.created_at)}</span>
                                </div>
                            `;
                            container.appendChild(el);
                        });
                    }
                }
            }

            // ==========================================================================
            // 4. BIỂU ĐỒ SỨC KHỎE 7 NGÀY (TRUNG BÌNH TOÀN TRUNG TÂM / NGƯỜI THÂN)
            // ==========================================================================
            async function loadHealthTrendChart() {
                const sevenDaysAgo = new Date(now);
                sevenDaysAgo.setDate(now.getDate() - 6);
                sevenDaysAgo.setHours(0, 0, 0, 0);

                const { data } = await window.sb
                    .from("health_records")
                    .select("recorded_at, systolic, diastolic, heart_rate")
                    .gte("recorded_at", sevenDaysAgo.toISOString());

                const rows = data || [];
                const days = [];
                for (let i = 6; i >= 0; i--) {
                    const d = new Date(now);
                    d.setDate(now.getDate() - i);
                    days.push(d);
                }

                const xCoords = [50, 155, 260, 365, 470, 575, 680];
                const labelsGroup = document.getElementById("dash-chart-x-labels");
                if (labelsGroup) labelsGroup.innerHTML = "";

                const pts = { sys: [], dia: [], hr: [] };

                days.forEach((d, idx) => {
                    const key = toIso(d);
                    const dayRows = rows.filter(r => (r.recorded_at || "").substring(0, 10) === key);

                    if (labelsGroup) {
                        const label = document.createElementNS("http://www.w3.org/2000/svg", "text");
                        label.setAttribute("x", xCoords[idx]);
                        label.setAttribute("y", "210");
                        label.setAttribute("text-anchor", "middle");
                        label.setAttribute("class", "chart-axis-text");
                        if (idx === 6) {
                            label.setAttribute("font-weight", "700");
                            label.setAttribute("fill", "#0ba5ec");
                        }
                        const dd = String(d.getDate()).padStart(2, "0");
                        const mm = String(d.getMonth() + 1).padStart(2, "0");
                        label.textContent = `${dd}/${mm}`;
                        labelsGroup.appendChild(label);
                    }

                    if (dayRows.length > 0) {
                        const avg = field => dayRows.reduce((s, r) => s + (r[field] || 0), 0) / dayRows.length;
                        pts.sys.push({ x: xCoords[idx], y: 190 - avg("systolic") });
                        pts.dia.push({ x: xCoords[idx], y: 190 - avg("diastolic") });
                        pts.hr.push({ x: xCoords[idx], y: 190 - avg("heart_rate") });
                    }
                });

                function pathFrom(points) {
                    if (points.length === 0) return "";
                    return "M " + points.map(p => `${p.x} ${p.y}`).join(" L ");
                }

                const pathSys = document.getElementById("dash-path-sys");
                const pathDia = document.getElementById("dash-path-dia");
                const pathHr = document.getElementById("dash-path-hr");
                if (pathSys) pathSys.setAttribute("d", pathFrom(pts.sys));
                if (pathDia) pathDia.setAttribute("d", pathFrom(pts.dia));
                if (pathHr) pathHr.setAttribute("d", pathFrom(pts.hr));
            }

            // ==========================================================================
            // 5. THỐNG KÊ NHANH: TUÂN THỦ THUỐC & CẢNH BÁO ĐÃ XỬ LÝ
            // ==========================================================================
            async function loadMedicationComplianceStat() {
                const { data: schedules } = await window.sb
                    .from("medication_schedules")
                    .select("medication_schedule_id")
                    .eq("status", "Đang sử dụng")
                    .lte("start_date", todayIso);

                const dueIds = (schedules || []).map(s => s.medication_schedule_id);
                let given = 0;
                if (dueIds.length > 0) {
                    const { data: admins } = await window.sb
                        .from("medication_administrations")
                        .select("medication_schedule_id")
                        .eq("scheduled_date", todayIso)
                        .in("medication_schedule_id", dueIds);
                    given = (admins || []).length;
                }

                const pct = dueIds.length > 0 ? Math.round((given / dueIds.length) * 100) : 100;
                const pctEl = document.getElementById("stats-meds-pct");
                const barEl = document.getElementById("stats-meds-bar");
                if (pctEl) pctEl.innerText = `${pct}%`;
                if (barEl) barEl.style.width = `${pct}%`;
            }

            async function loadAlertResolutionStat() {
                const { count: totalCount } = await window.sb.from("health_alerts").select("alert_id", { count: "exact", head: true });
                const { count: resolvedCount } = await window.sb.from("health_alerts").select("alert_id", { count: "exact", head: true }).eq("status", "Đã xử lý");
                const pct = totalCount > 0 ? Math.round((resolvedCount / totalCount) * 100) : 100;
                const el = document.getElementById("stats-alerts-handled");
                const bar = document.getElementById("stats-alerts-bar");
                if (el) el.innerText = `${pct}%`;
                if (bar) bar.style.width = `${pct}%`;
            }

            // ==========================================================================
            // 6. HOẠT ĐỘNG GẦN ĐÂY (24 GIỜ QUA — DỮ LIỆU THẬT TỪ NHIỀU BẢNG)
            // ==========================================================================
            async function loadRecentActivities() {
                const sinceIso = new Date(now.getTime() - 24 * 3600 * 1000).toISOString();

                const [resolutionsRes, healthRes, scheduleRes] = await Promise.all([
                    window.sb.from("alert_resolutions")
                        .select("resolved_at, action_taken, profiles(full_name), health_alerts(title, residents(full_name))")
                        .gte("resolved_at", sinceIso).order("resolved_at", { ascending: false }).limit(6),
                    window.sb.from("health_records")
                        .select("recorded_at, systolic, diastolic, residents(full_name), profiles(full_name)")
                        .gte("recorded_at", sinceIso).order("recorded_at", { ascending: false }).limit(6),
                    window.sb.from("care_schedules")
                        .select("updated_at, schedule_name, residents(full_name), profiles(full_name)")
                        .eq("status", "Hoàn thành").gte("updated_at", sinceIso).order("updated_at", { ascending: false }).limit(6)
                ]);

                const items = [];

                (resolutionsRes.data || []).forEach(r => {
                    items.push({
                        time: r.resolved_at,
                        title: `Đã xử lý cảnh báo: ${r.health_alerts ? r.health_alerts.title : ""}`,
                        meta: `${r.health_alerts && r.health_alerts.residents ? r.health_alerts.residents.full_name : ""} &middot; ${r.profiles ? r.profiles.full_name : "Nhân viên"}`,
                        iconType: "check", iconColor: "green"
                    });
                });
                (healthRes.data || []).forEach(r => {
                    items.push({
                        time: r.recorded_at,
                        title: `Đã ghi nhận chỉ số sức khỏe${r.systolic ? ` (${r.systolic}/${r.diastolic} mmHg)` : ""}`,
                        meta: `${r.residents ? r.residents.full_name : ""} &middot; ${r.profiles ? r.profiles.full_name : "Nhân viên"}`,
                        iconType: "pulse", iconColor: "blue"
                    });
                });
                (scheduleRes.data || []).forEach(r => {
                    items.push({
                        time: r.updated_at,
                        title: `Đã hoàn thành: ${r.schedule_name}`,
                        meta: `${r.residents ? r.residents.full_name : ""} &middot; ${r.profiles ? r.profiles.full_name : "Nhân viên"}`,
                        iconType: "check", iconColor: "green"
                    });
                });

                items.sort((a, b) => new Date(b.time) - new Date(a.time));

                const container = document.getElementById("dash-activity-container");
                if (!container) return;
                container.innerHTML = "";

                if (items.length === 0) {
                    container.innerHTML = `<p style="color:#667085; font-size:13.5px; padding:12px 0;">Chưa có hoạt động nào trong 24 giờ qua.</p>`;
                    return;
                }

                items.slice(0, 8).forEach(act => {
                    const el = document.createElement("div");
                    el.className = "dash-activity-item";
                    el.innerHTML = `
                        <div class="dash-activity-icon icon-${act.iconColor}">
                            ${getActivityIconSvg(act.iconType)}
                        </div>
                        <div class="dash-activity-content">
                            <span class="dash-activity-title">${act.title}</span>
                            <span class="dash-activity-meta">${act.meta} &middot; ${formatTimeVN(act.time)}</span>
                        </div>
                    `;
                    container.appendChild(el);
                });
            }

            await Promise.all([
                loadElderlyCount(),
                loadTodaySchedule(),
                loadHealthAlerts(),
                loadHealthTrendChart(),
                loadMedicationComplianceStat(),
                loadAlertResolutionStat(),
                loadRecentActivities()
            ]);
        });
    </script>
}


