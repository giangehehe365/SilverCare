@section Scripts {
    <script>
        let currentTasks = [];
        let currentViewMode = "day"; // day | week | month | custom
        let residentsCache = [];
        let staffCache = [];
        let customRangeStart = null;
        let customRangeEnd = null;

        function toIsoDate(d) {
            return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
        }

        function formatDateShortVN(iso) {
            const parts = iso.split("-");
            return `${parts[2]}/${parts[1]}`;
        }

        // Tính chuỗi ngày tiếng Việt đầy đủ hoàn toàn trong JS (không nhúng chuỗi
        // Razor vào <script> — nhúng trực tiếp sẽ bị Razor HTML-encode ký tự có
        // dấu thành numeric character reference, và .innerText/.textContent
        // không giải mã HTML entity trong chuỗi JS nên hiển thị sai như
        // "Th&#x1EE9; T&#x1B0;..." thay vì "Thứ Tư...").
        function formatFullDateVN(d) {
            const days = ["Chủ Nhật", "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy"];
            return `${days[d.getDay()]}, ${d.getDate()} tháng ${d.getMonth() + 1} năm ${d.getFullYear()}`;
        }

        function getDateRangeForView(mode) {
            const now = new Date();
            if (mode === "day") {
                const iso = toIsoDate(now);
                return { start: iso, end: iso };
            }
            if (mode === "week") {
                const day = now.getDay();
                const diffToMonday = (day === 0 ? -6 : 1 - day);
                const monday = new Date(now);
                monday.setDate(now.getDate() + diffToMonday);
                const sunday = new Date(monday);
                sunday.setDate(monday.getDate() + 6);
                return { start: toIsoDate(monday), end: toIsoDate(sunday) };
            }
            if (mode === "custom" && customRangeStart && customRangeEnd) {
                return { start: customRangeStart, end: customRangeEnd };
            }
            // month
            const first = new Date(now.getFullYear(), now.getMonth(), 1);
            const last = new Date(now.getFullYear(), now.getMonth() + 1, 0);
            return { start: toIsoDate(first), end: toIsoDate(last) };
        }

        function updateHeaderTitle() {
            const header = document.getElementById("schedule-date-header");
            if (!header) return;
            const range = getDateRangeForView(currentViewMode);
            if (currentViewMode === "day") {
                header.innerText = formatFullDateVN(new Date());
            } else if (currentViewMode === "week") {
                header.innerText = `Tuần ${formatDateShortVN(range.start)} - ${formatDateShortVN(range.end)}`;
            } else if (currentViewMode === "custom") {
                header.innerText = `${formatDateShortVN(range.start)} - ${formatDateShortVN(range.end)}`;
            } else {
                const now = new Date();
                header.innerText = `Tháng ${now.getMonth() + 1}/${now.getFullYear()}`;
            }
        }

        // Helper to construct item HTML
        function createTaskHtml(task) {
            let indicatorClass = "indicator-gray";
            if (task.type === "Y tế") {
                indicatorClass = "indicator-yellow";
            } else if (task.type === "Chăm sóc") {
                indicatorClass = "indicator-green";
            }

            const timeLabel = currentViewMode === "day" ? task.time : `${formatDateShortVN(task.date)} ${task.time}`;
            const badgeClass = STATUS_BADGE_CLASS[task.status] || "badge-todo";

            let actionsHtml = `
                <span class="status-badge ${badgeClass}" id="badge-${task.id}">${escapeHtml(task.status)}</span>
                <a href="#" class="btn-detail btn-open-detail">Chi tiết</a>
            `;

            if (canWorkOnTask(task)) {
                if (task.status === "Chưa thực hiện") {
                    actionsHtml += `<a href="#" class="btn-detail btn-start-task" data-id="${task.id}">Bắt đầu</a>`;
                }
                actionsHtml += `
                    <button class="btn-complete" onclick="openResultModal(${task.id})">
                        <svg viewBox="0 0 24 24">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Ghi nhận</span>
                    </button>
                `;
            }
            if (canEditTask(task)) {
                actionsHtml += `<a href="#" class="btn-detail btn-edit-schedule" data-id="${task.id}">Sửa</a>`;
            }
            if (canDeleteTask(task)) {
                actionsHtml += `<a href="#" class="btn-detail btn-delete-schedule" data-id="${task.id}" style="color: #d92d20;">Xóa</a>`;
            }

            return `
            <div class="schedule-item" data-room="${escapeHtml(task.patientRoom)}" data-status="${escapeHtml(task.status)}" data-staff-id="${task.assignedStaffId}" id="task-${task.id}" data-id="${task.id}">
                <span class="schedule-time">${timeLabel}</span>
                <div class="status-indicator ${indicatorClass}" id="indicator-${task.id}"></div>
                <div class="schedule-info">
                    <h3 class="schedule-task-name">${escapeHtml(task.name)}</h3>
                    <p class="schedule-patient-meta">${escapeHtml(task.patientName)} - Phòng ${escapeHtml(task.patientRoom || "---")}</p>
                </div>
                <div class="schedule-actions">
                    ${actionsHtml}
                </div>
            </div>
            `;
        }

        function escapeHtml(text) {
            const div = document.createElement("div");
            div.textContent = text == null ? "" : String(text);
            return div.innerHTML.replace(/"/g, "&quot;");
        }

        // ==========================================
        // QUYỀN THAO TÁC TRÊN TỪNG LỊCH (khớp với RLS + trigger guard_care_schedule)
        // ==========================================
        const FINAL_STATUSES = ["Hoàn thành", "Không thực hiện được", "Đã hủy"];
        const STATUS_BADGE_CLASS = {
            "Chưa thực hiện": "badge-todo",
            "Đang thực hiện": "badge-pending",
            "Hoàn thành": "badge-done",
            "Không thực hiện được": "badge-failed",
            "Đã hủy": "badge-failed"
        };

        function currentRole() {
            return window.currentUser ? window.currentUser.role : null;
        }

        function isManagerRole() {
            return ["admin", "manager"].indexOf(currentRole()) !== -1;
        }

        function isOwnStaffTask(task) {
            return currentRole() === "staff" && task.assignedStaffId === window.currentUser.id;
        }

        // Ghi nhận bắt đầu / kết quả: quản lý hoặc chính nhân viên được giao, lịch chưa chốt
        function canWorkOnTask(task) {
            if (FINAL_STATUSES.indexOf(task.status) !== -1) return false;
            return isManagerRole() || isOwnStaffTask(task);
        }

        // Sửa nội dung: quản lý; nhân viên chỉ với lịch do chính mình tạo và chưa bắt đầu
        function canEditTask(task) {
            if (isManagerRole()) return true;
            return isOwnStaffTask(task) && task.createdBy === window.currentUser.id && task.status === "Chưa thực hiện";
        }

        function canDeleteTask(task) {
            return canEditTask(task);
        }

        // Load and render (Supabase — bảng care_schedules)
        async function loadAndRenderTasks() {
            const range = getDateRangeForView(currentViewMode);
            let query = window.sb
                .from("care_schedules")
                .select("care_schedule_id, schedule_name, schedule_date, start_time, schedule_type, status, note, result_note, created_by, completed_at, resident_id, assigned_staff_id, " +
                    "residents(full_name, rooms(room_code)), " +
                    "assignee:profiles!care_schedules_assigned_staff_id_fkey(full_name), " +
                    "completer:profiles!care_schedules_completed_by_fkey(full_name)")
                .gte("schedule_date", range.start)
                .lte("schedule_date", range.end);

            if (window.currentUser && window.currentUser.role === "staff") {
                query = query.eq("assigned_staff_id", window.currentUser.id);
            }

            const { data, error } = await query;
            if (error) {
                console.error(error);
                currentTasks = [];
            } else {
                currentTasks = (data || []).map(row => ({
                    id: row.care_schedule_id,
                    name: row.schedule_name,
                    date: row.schedule_date,
                    time: row.start_time ? row.start_time.substring(0, 5) : "",
                    residentId: row.resident_id,
                    patientName: row.residents ? row.residents.full_name : "",
                    patientRoom: row.residents && row.residents.rooms ? row.residents.rooms.room_code : "",
                    status: row.status,
                    type: row.schedule_type,
                    note: row.note || "",
                    resultNote: row.result_note || "",
                    createdBy: row.created_by || "",
                    completedAt: row.completed_at,
                    completedByName: row.completer ? row.completer.full_name : "",
                    assignedStaffId: row.assigned_staff_id || "",
                    staffName: row.assignee ? row.assignee.full_name : ""
                }));
            }

            updateHeaderTitle();

            const container = document.getElementById("schedule-items-container");
            if (container) {
                container.innerHTML = "";
                const sorted = [...currentTasks].sort((a, b) => (a.date + a.time).localeCompare(b.date + b.time));
                sorted.forEach(task => {
                    container.insertAdjacentHTML("beforeend", createTaskHtml(task));
                });
            }

            applyFilters();
        }

        // Store total count of items visible under active filters
        function updateCountText() {
            let visibleItems = 0;
            document.querySelectorAll(".schedule-item").forEach(item => {
                if (item.style.display !== "none") visibleItems++;
            });

            const countText = document.getElementById("schedule-count");
            if (countText) {
                countText.innerText = `${visibleItems} lịch`;
            }

            const emptyState = document.getElementById("empty-state");
            const emptyMsg = document.getElementById("empty-schedule-msg");
            if (emptyState) {
                if (visibleItems === 0) {
                    emptyState.style.display = "block";
                    const urlParams = new URLSearchParams(window.location.search);
                    const paramName = urlParams.get('name');
                    const selectedRoom = roomFilter ? roomFilter.value : 'all';
                    if (paramName) {
                        if (emptyMsg) emptyMsg.innerText = `Chưa có lịch chăm sóc của ${paramName}`;
                    } else if (selectedRoom !== 'all') {
                        if (emptyMsg) emptyMsg.innerText = `Chưa có lịch chăm sóc của Phòng ${selectedRoom}`;
                    } else {
                        if (emptyMsg) emptyMsg.innerText = "Không có công việc cần thực hiện hôm nay.";
                    }
                } else {
                    emptyState.style.display = "none";
                }
            }
        }

        // Cập nhật care_schedules và kiểm tra thật sự có dòng nào được ghi: RLS
        // chặn update sẽ không báo lỗi mà chỉ trả về 0 dòng.
        async function updateScheduleRow(taskId, changes) {
            const { data, error } = await window.sb
                .from("care_schedules")
                .update(changes)
                .eq("care_schedule_id", taskId)
                .select("care_schedule_id");
            if (error) throw error;
            if (!data || data.length === 0) {
                throw new Error("Bạn không có quyền cập nhật lịch chăm sóc này.");
            }
        }

        async function startTask(taskId) {
            try {
                await updateScheduleRow(taskId, { status: "Đang thực hiện" });
                showToast("Đã bắt đầu thực hiện.");
                await loadAndRenderTasks();
            } catch (err) {
                console.error(err);
                alert("Không thể cập nhật: " + err.message);
            }
        }

        // ==========================================
        // GHI NHẬN KẾT QUẢ (Hoàn thành / Không thực hiện được — bắt buộc có ghi chú)
        // ==========================================
        const resultModalOverlay = document.getElementById("result-schedule-modal-overlay");
        const resultNoteInput = document.getElementById("result-note-input");
        const resultNoteLabel = document.getElementById("result-note-label");
        const resultReasonGroup = document.getElementById("result-reason-group");
        const resultTaskLabel = document.getElementById("result-task-label");
        const btnResultSave = document.getElementById("btn-result-modal-save");
        let activeResultTaskId = null;

        function getSelectedOutcome() {
            const checked = document.querySelector('input[name="result-outcome"]:checked');
            return checked ? checked.value : "Hoàn thành";
        }

        function syncResultOutcomeUi() {
            const failed = getSelectedOutcome() === "Không thực hiện được";
            resultReasonGroup.style.display = failed ? "block" : "none";
            resultNoteLabel.innerHTML = (failed ? "Lý do không thực hiện được" : "Ghi chú kết quả") + ' <span class="required-asterisk">*</span>';
            resultNoteInput.placeholder = failed
                ? "Ghi rõ lý do và hướng xử lý tiếp theo (VD: cư dân từ chối tắm, sẽ thử lại lúc 16:00)..."
                : "VD: Đã hỗ trợ tắm, da khô, không có vết đỏ; cư dân ăn hết suất...";
        }

        window.openResultModal = function (taskId) {
            const task = currentTasks.find(t => t.id === Number(taskId));
            if (!task || !canWorkOnTask(task)) return;
            activeResultTaskId = task.id;
            resultTaskLabel.innerText = `${task.name} — ${task.patientName} (${formatDateShortVN(task.date)} ${task.time})`;
            document.querySelector('input[name="result-outcome"][value="Hoàn thành"]').checked = true;
            resultNoteInput.value = "";
            syncResultOutcomeUi();
            resultModalOverlay.classList.add("active");
            resultNoteInput.focus();
        };

        function closeResultModal() {
            resultModalOverlay.classList.remove("active");
            activeResultTaskId = null;
        }

        document.querySelectorAll('input[name="result-outcome"]').forEach(r => r.addEventListener("change", syncResultOutcomeUi));
        document.querySelectorAll(".result-reason-chip").forEach(chip => {
            chip.addEventListener("click", function () {
                const reason = this.innerText.trim();
                resultNoteInput.value = resultNoteInput.value.trim()
                    ? `${resultNoteInput.value.trim()}; ${reason}`
                    : reason;
                resultNoteInput.focus();
            });
        });
        document.getElementById("btn-result-modal-close").addEventListener("click", closeResultModal);
        document.getElementById("btn-result-modal-cancel").addEventListener("click", closeResultModal);
        resultModalOverlay.addEventListener("click", function (e) {
            if (e.target === resultModalOverlay) closeResultModal();
        });

        btnResultSave.addEventListener("click", async function () {
            if (!activeResultTaskId) return;
            const outcome = getSelectedOutcome();
            const note = resultNoteInput.value.trim();
            if (note.length < 3) {
                alert(outcome === "Hoàn thành"
                    ? "Vui lòng ghi nhận kết quả thực hiện (tối thiểu vài từ mô tả)."
                    : "Vui lòng ghi rõ lý do không thực hiện được.");
                resultNoteInput.focus();
                return;
            }

            btnResultSave.disabled = true;
            btnResultSave.textContent = "Đang lưu...";
            try {
                await updateScheduleRow(activeResultTaskId, { status: outcome, result_note: note });
                closeResultModal();
                showToast(outcome === "Hoàn thành" ? "Đã ghi nhận hoàn thành!" : "Đã ghi nhận không thực hiện được.");
                await loadAndRenderTasks();
            } catch (err) {
                console.error(err);
                alert("Không thể lưu kết quả: " + err.message);
            } finally {
                btnResultSave.disabled = false;
                btnResultSave.textContent = "Lưu kết quả";
            }
        });

        // Filtering logic (lọc trên tập dữ liệu đã tải từ Supabase)
        const roomFilter = document.getElementById("room-filter");
        const statusFilter = document.getElementById("status-filter");
        const staffFilter = document.getElementById("staff-filter");

        function applyFilters() {
            const selectedRoom = roomFilter.value;
            const selectedStatus = statusFilter.value;
            const selectedStaff = staffFilter ? staffFilter.value : "all";

            document.querySelectorAll(".schedule-item").forEach(item => {
                const room = item.getAttribute("data-room");
                const status = item.getAttribute("data-status");
                const staffId = item.getAttribute("data-staff-id") || "";

                const matchesRoom = (selectedRoom === "all" || room === selectedRoom);
                const matchesStatus = (selectedStatus === "all" || status === selectedStatus);
                const matchesStaff = (selectedStaff === "all" || staffId === selectedStaff);

                item.style.display = (matchesRoom && matchesStatus && matchesStaff) ? "grid" : "none";
            });

            updateCountText();
        }

        if (roomFilter) roomFilter.addEventListener("change", applyFilters);
        if (statusFilter) statusFilter.addEventListener("change", applyFilters);
        if (staffFilter) staffFilter.addEventListener("change", applyFilters);

        // Nạp danh sách nhân viên cho bộ lọc (chỉ hữu ích với Admin/Manager — ô đã
        // bị auth-guard ẩn với các vai trò khác qua data-roles)
        async function populateStaffFilter() {
            if (!staffFilter) return;
            const { data, error } = await window.sb
                .from("profiles")
                .select("id, full_name")
                .in("role", ["admin", "manager", "staff"])
                .eq("is_active", true)
                .order("full_name");

            if (error) {
                console.error(error);
                return;
            }

            (data || []).forEach(p => {
                const opt = document.createElement("option");
                opt.value = p.id;
                opt.innerText = p.full_name;
                staffFilter.appendChild(opt);
            });
        }

        // View toggle: Ngày / Tuần / Tháng — dữ liệu thật theo khoảng ngày tương ứng
        document.querySelectorAll(".view-toggle-btn").forEach(btn => {
            btn.addEventListener("click", async function () {
                document.querySelectorAll(".view-toggle-btn").forEach(b => b.classList.remove("active"));
                this.classList.add("active");
                currentViewMode = this.getAttribute("data-view");
                await loadAndRenderTasks();
            });
        });

        // Bộ lọc khoảng ngày tùy chỉnh (Từ ngày - Đến ngày)
        const rangeFromInput = document.getElementById("range-from");
        const rangeToInput = document.getElementById("range-to");
        const btnApplyRange = document.getElementById("btn-apply-range");

        if (btnApplyRange) {
            btnApplyRange.addEventListener("click", async function () {
                const from = rangeFromInput.value;
                const to = rangeToInput.value;

                if (!from || !to) {
                    alert("Vui lòng chọn đầy đủ Từ ngày và Đến ngày.");
                    return;
                }
                if (from > to) {
                    alert("\"Từ ngày\" phải trước hoặc bằng \"Đến ngày\".");
                    return;
                }

                customRangeStart = from;
                customRangeEnd = to;
                currentViewMode = "custom";
                document.querySelectorAll(".view-toggle-btn").forEach(b => b.classList.remove("active"));
                await loadAndRenderTasks();
            });
        }

        // ==========================================
        // CREATE SCHEDULE MODAL LOGIC
        // ==========================================
        const openModalBtn = document.getElementById("btn-open-create-modal");
        const modalOverlay = document.getElementById("create-schedule-modal-overlay");
        const closeModalBtn = document.getElementById("btn-create-modal-close");
        const cancelModalBtn = document.getElementById("btn-create-modal-cancel");
        const saveModalBtn = document.getElementById("btn-create-modal-save");

        const inputName = document.getElementById("schedule-input-name");
        const selectPatient = document.getElementById("schedule-select-patient");
        const inputDateFrom = document.getElementById("schedule-input-date-from");
        const inputDateTo = document.getElementById("schedule-input-date-to");
        const inputTime = document.getElementById("schedule-input-time");
        const selectType = document.getElementById("schedule-select-type");
        const textareaNote = document.getElementById("schedule-textarea-note");

        // Liệt kê tất cả các ngày (yyyy-mm-dd) trong khoảng [fromIso, toIso], hai đầu bao gồm
        function enumerateDateRange(fromIso, toIso) {
            const dates = [];
            let cursor = new Date(`${fromIso}T00:00:00`);
            const end = new Date(`${toIso}T00:00:00`);
            while (cursor <= end) {
                dates.push(toIsoDate(cursor));
                cursor.setDate(cursor.getDate() + 1);
            }
            return dates;
        }

        // Helper to show custom toast message
        function showToast(message) {
            const toast = document.getElementById("toast-complete");
            const toastText = document.getElementById("toast-message-text");
            if (toast) {
                if (toastText) {
                    toastText.innerText = message;
                    toast.classList.add("active");
                    setTimeout(() => {
                        toast.classList.remove("active");
                    }, 3000);
                }
            }
        }

        const selectStaff = document.getElementById("schedule-select-staff");
        const editSelectPatient = document.getElementById("edit-schedule-select-patient");
        const editSelectStaff = document.getElementById("edit-schedule-select-staff");

        async function ensureResidentsCache() {
            if (residentsCache.length > 0) return residentsCache;
            const { data, error } = await window.sb
                .from("residents")
                .select("resident_id, full_name, rooms(room_code)")
                .eq("is_active", true)
                .order("full_name");

            residentsCache = error ? [] : (data || []).map(r => ({
                residentId: r.resident_id,
                name: r.full_name,
                room: r.rooms ? r.rooms.room_code : "---"
            }));
            return residentsCache;
        }

        async function ensureStaffCache() {
            if (staffCache.length > 0) return staffCache;
            const { data, error } = await window.sb
                .from("profiles")
                .select("id, full_name, role")
                .in("role", ["admin", "manager", "staff"])
                .eq("is_active", true)
                .order("full_name");

            staffCache = error ? [] : (data || []);
            return staffCache;
        }

        async function populateSchedulePatients() {
            await ensureResidentsCache();
            if (selectPatient) {
                selectPatient.innerHTML = `<option value="" disabled selected>-- Chọn --</option>` +
                    residentsCache.map(r => `<option value="${r.residentId}">${r.name} - Phòng ${r.room}</option>`).join("");
            }
        }

        async function populateStaffSelect() {
            await ensureStaffCache();
            if (selectStaff) {
                selectStaff.innerHTML = `<option value="">-- Chưa phân công --</option>` +
                    staffCache.map(s => `<option value="${s.id}">${s.full_name}</option>`).join("");
                // Nhân viên tạo lịch thì lịch luôn giao cho chính mình (DB cũng ép như vậy)
                const staffSelf = currentRole() === "staff";
                if (staffSelf) selectStaff.value = window.currentUser.id;
                selectStaff.disabled = staffSelf;
            }
        }

        async function populateEditSelects() {
            await Promise.all([ensureResidentsCache(), ensureStaffCache()]);
            if (editSelectPatient) {
                editSelectPatient.innerHTML = residentsCache
                    .map(r => `<option value="${r.residentId}">${r.name} - Phòng ${r.room}</option>`).join("");
            }
            if (editSelectStaff) {
                editSelectStaff.innerHTML = `<option value="">-- Chưa phân công --</option>` +
                    staffCache.map(s => `<option value="${s.id}">${s.full_name}</option>`).join("");
            }
        }

        if (openModalBtn && modalOverlay) {
            openModalBtn.addEventListener("click", async function (e) {
                e.preventDefault();

                await populateSchedulePatients();
                await populateStaffSelect();

                // Reset form values
                inputName.value = "";
                selectPatient.selectedIndex = 0;
                selectType.selectedIndex = 0;
                textareaNote.value = "";

                const today = new Date();
                const todayIso = toIsoDate(today);
                inputDateFrom.min = todayIso;
                inputDateTo.min = todayIso;
                inputDateFrom.value = todayIso;
                inputDateTo.value = todayIso;
                inputTime.value = `${String(today.getHours()).padStart(2, "0")}:${String(today.getMinutes()).padStart(2, "0")}`;

                modalOverlay.classList.add("active");
            });

            function closeCreateModal() {
                modalOverlay.classList.remove("active");
            }

            if (closeModalBtn) closeModalBtn.addEventListener("click", closeCreateModal);
            if (cancelModalBtn) cancelModalBtn.addEventListener("click", closeCreateModal);

            modalOverlay.addEventListener("click", function (e) {
                if (e.target === modalOverlay) closeCreateModal();
            });

            // Đến ngày không được nhỏ hơn Từ ngày, và Từ ngày không được chọn ngày quá khứ
            if (inputDateFrom) {
                inputDateFrom.addEventListener("change", function () {
                    if (this.value) {
                        inputDateTo.min = this.value;
                        if (inputDateTo.value && inputDateTo.value < this.value) {
                            inputDateTo.value = this.value;
                        }
                    }
                });
            }

            if (saveModalBtn) {
                saveModalBtn.addEventListener("click", async function () {
                    const name = inputName.value.trim();
                    const residentId = selectPatient.value ? parseInt(selectPatient.value, 10) : null;
                    const staffId = selectStaff.value || null;
                    const dateFrom = inputDateFrom.value;
                    const dateTo = inputDateTo.value;
                    const time = inputTime.value;
                    const type = selectType.value;
                    const note = textareaNote.value.trim();

                    if (!name || !residentId || !dateFrom || !dateTo || !time) {
                        alert("Vui lòng điền đầy đủ các thông tin bắt buộc (*)");
                        return;
                    }

                    const todayIso = toIsoDate(new Date());
                    if (dateFrom < todayIso || dateTo < todayIso) {
                        alert("Không thể tạo lịch chăm sóc cho ngày trong quá khứ.");
                        return;
                    }
                    if (dateFrom > dateTo) {
                        alert("\"Từ ngày\" phải trước hoặc bằng \"Đến ngày\".");
                        return;
                    }

                    const dates = enumerateDateRange(dateFrom, dateTo);

                    saveModalBtn.disabled = true;
                    saveModalBtn.textContent = "Đang lưu...";

                    try {
                        const rows = dates.map(d => ({
                            resident_id: residentId,
                            assigned_staff_id: staffId,
                            schedule_name: name,
                            schedule_date: d,
                            start_time: time + ":00",
                            schedule_type: type,
                            status: "Chưa thực hiện",
                            note: note || null
                        }));

                        const { error } = await window.sb.from("care_schedules").insert(rows);
                        if (error) throw error;

                        closeCreateModal();
                        showToast(dates.length > 1
                            ? `Đã lưu lịch chăm sóc cho ${dates.length} ngày!`
                            : "Đã lưu lịch chăm sóc!");
                        await loadAndRenderTasks();
                    } catch (err) {
                        console.error(err);
                        alert("Không thể lưu lịch: " + err.message);
                    } finally {
                        saveModalBtn.disabled = false;
                        saveModalBtn.textContent = "Lưu lịch";
                    }
                });
            }
        }

        // ==========================================
        // EDIT / DELETE SCHEDULE LOGIC
        // ==========================================
        const editModalOverlay = document.getElementById("edit-schedule-modal-overlay");
        const btnEditModalClose = document.getElementById("btn-edit-modal-close");
        const btnEditModalCancel = document.getElementById("btn-edit-modal-cancel");
        const btnEditModalSave = document.getElementById("btn-edit-modal-save");

        const editInputName = document.getElementById("edit-schedule-input-name");
        const editInputDate = document.getElementById("edit-schedule-input-date");
        const editInputTime = document.getElementById("edit-schedule-input-time");
        const editSelectType = document.getElementById("edit-schedule-select-type");
        const editSelectStatus = document.getElementById("edit-schedule-select-status");
        const editTextareaNote = document.getElementById("edit-schedule-textarea-note");
        const editTextareaResult = document.getElementById("edit-schedule-textarea-result");

        let activeEditTaskId = null;

        function closeEditScheduleModal() {
            if (editModalOverlay) editModalOverlay.classList.remove("active");
            activeEditTaskId = null;
        }

        async function openEditScheduleModal(taskId) {
            const task = currentTasks.find(t => t.id === taskId);
            if (!task || !canEditTask(task)) return;
            activeEditTaskId = taskId;

            await populateEditSelects();

            editInputName.value = task.name || "";
            editSelectPatientValue(task.residentId);
            if (editSelectStaff) editSelectStaff.value = task.assignedStaffId || "";
            editInputDate.value = task.date || "";
            editInputTime.value = task.time || "";
            editSelectType.value = task.type || "Chăm sóc";
            editSelectStatus.value = task.status || "Chưa thực hiện";
            editTextareaNote.value = task.note || "";
            editTextareaResult.value = task.resultNote || "";

            // Nhân viên: không đổi người phụ trách; trạng thái/kết quả ghi nhận qua nút "Ghi nhận"
            const staffSelf = currentRole() === "staff";
            if (editSelectStaff) editSelectStaff.disabled = staffSelf;
            editSelectStatus.disabled = staffSelf;
            editTextareaResult.closest(".schedule-form-group").style.display = staffSelf ? "none" : "";

            if (editModalOverlay) editModalOverlay.classList.add("active");
        }

        function editSelectPatientValue(residentId) {
            if (editSelectPatient && residentId) editSelectPatient.value = residentId;
        }

        if (btnEditModalClose) btnEditModalClose.addEventListener("click", closeEditScheduleModal);
        if (btnEditModalCancel) btnEditModalCancel.addEventListener("click", closeEditScheduleModal);
        if (editModalOverlay) {
            editModalOverlay.addEventListener("click", function (e) {
                if (e.target === editModalOverlay) closeEditScheduleModal();
            });
        }

        if (btnEditModalSave) {
            btnEditModalSave.addEventListener("click", async function () {
                if (!activeEditTaskId) return;

                const name = editInputName.value.trim();
                const residentId = editSelectPatient && editSelectPatient.value ? parseInt(editSelectPatient.value, 10) : null;
                const staffId = editSelectStaff ? (editSelectStaff.value || null) : null;
                const date = editInputDate.value;
                const time = editInputTime.value;
                const type = editSelectType.value;
                const status = editSelectStatus.value;
                const note = editTextareaNote.value.trim();
                const resultNote = editTextareaResult.value.trim();

                if (!name || !residentId || !date || !time) {
                    alert("Vui lòng điền đầy đủ các thông tin bắt buộc (*)");
                    return;
                }
                if ((status === "Hoàn thành" || status === "Không thực hiện được") && resultNote.length < 3) {
                    alert("Vui lòng nhập Kết quả / lý do khi chốt lịch ở trạng thái \"" + status + "\".");
                    editTextareaResult.focus();
                    return;
                }

                btnEditModalSave.disabled = true;
                btnEditModalSave.textContent = "Đang lưu...";

                try {
                    const changes = {
                        resident_id: residentId,
                        schedule_name: name,
                        schedule_date: date,
                        start_time: time + ":00",
                        schedule_type: type,
                        note: note || null
                    };
                    if (isManagerRole()) {
                        changes.assigned_staff_id = staffId;
                        changes.status = status;
                        changes.result_note = resultNote || null;
                    }
                    await updateScheduleRow(activeEditTaskId, changes);

                    closeEditScheduleModal();
                    showToast("Đã cập nhật lịch chăm sóc!");
                    await loadAndRenderTasks();
                } catch (err) {
                    console.error(err);
                    alert("Không thể lưu thay đổi: " + err.message);
                } finally {
                    btnEditModalSave.disabled = false;
                    btnEditModalSave.textContent = "Lưu thay đổi";
                }
            });
        }

        async function deleteSchedule(taskId) {
            const task = currentTasks.find(t => t.id === taskId);
            const label = task ? `"${task.name}" (${task.patientName})` : "lịch chăm sóc này";
            if (!confirm(`Bạn có chắc chắn muốn xóa ${label}? Hành động này không thể hoàn tác.`)) return;

            const { data, error } = await window.sb.from("care_schedules").delete().eq("care_schedule_id", taskId).select("care_schedule_id");
            if (error) {
                alert("Không thể xóa: " + error.message);
                return;
            }
            if (!data || data.length === 0) {
                alert("Bạn không có quyền xóa lịch chăm sóc này (chỉ xóa được lịch do chính mình tạo và chưa bắt đầu).");
                return;
            }

            showToast("Đã xóa lịch chăm sóc.");
            await loadAndRenderTasks();
        }

        // Event delegation cho nút Bắt đầu/Sửa/Xóa trên từng dòng danh sách
        document.addEventListener("click", function (e) {
            const startBtn = e.target.closest(".btn-start-task");
            if (startBtn) {
                e.preventDefault();
                startTask(parseInt(startBtn.getAttribute("data-id"), 10));
                return;
            }
            const editBtn = e.target.closest(".btn-edit-schedule");
            if (editBtn) {
                e.preventDefault();
                openEditScheduleModal(parseInt(editBtn.getAttribute("data-id"), 10));
                return;
            }
            const deleteBtn = e.target.closest(".btn-delete-schedule");
            if (deleteBtn) {
                e.preventDefault();
                deleteSchedule(parseInt(deleteBtn.getAttribute("data-id"), 10));
            }
        });

        // ==========================================
        // DETAIL SCHEDULE MODAL LOGIC
        // ==========================================
        let activeDetailTaskId = null;

        function formatDateTimeVN(iso) {
            if (!iso) return "";
            const d = new Date(iso);
            return `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")} ${String(d.getDate()).padStart(2, "0")}/${String(d.getMonth() + 1).padStart(2, "0")}`;
        }

        function showDetailModal(taskId) {
            const task = currentTasks.find(t => t.id === Number(taskId));
            if (!task) return;

            activeDetailTaskId = task.id;

            document.getElementById("detail-val-name").innerText = task.name;
            document.getElementById("detail-val-time").innerText = `${formatDateShortVN(task.date)} ${task.time}`;
            document.getElementById("detail-val-patient").innerText = task.patientName;
            document.getElementById("detail-val-room").innerText = task.patientRoom ? `Phòng ${task.patientRoom}` : "---";
            document.getElementById("detail-val-status").innerText = task.status;
            document.getElementById("detail-val-note").innerText = task.note || "Không có";

            const staffRow = document.getElementById("detail-row-staff");
            if (staffRow) document.getElementById("detail-val-staff").innerText = task.staffName || "Chưa phân công";

            // Show or hide Note row based on content
            const noteSection = document.getElementById("detail-row-note");
            if (noteSection) {
                noteSection.style.display = task.note ? "block" : "none";
            }

            // Kết quả thực hiện / lý do không thực hiện được
            const resultSection = document.getElementById("detail-row-result");
            if (resultSection) {
                const hasResult = !!task.resultNote;
                resultSection.style.display = hasResult ? "block" : "none";
                document.getElementById("detail-label-result").innerText =
                    task.status === "Không thực hiện được" ? "Lý do không thực hiện được" : "Kết quả thực hiện";
                document.getElementById("detail-val-result").innerText = task.resultNote;
                document.getElementById("detail-val-completed-meta").innerText = task.completedAt
                    ? `Ghi nhận bởi ${task.completedByName || "---"} lúc ${formatDateTimeVN(task.completedAt)}`
                    : "";
            }

            // Các nút thao tác theo quyền thực tế trên lịch này
            const completeBtn = document.getElementById("btn-detail-modal-complete");
            if (completeBtn) completeBtn.style.display = canWorkOnTask(task) ? "inline-flex" : "none";
            const editBtnEl = document.getElementById("btn-detail-modal-edit");
            if (editBtnEl) editBtnEl.style.display = canEditTask(task) ? "" : "none";
            const deleteBtnEl = document.getElementById("btn-detail-modal-delete");
            if (deleteBtnEl) deleteBtnEl.style.display = canDeleteTask(task) ? "" : "none";

            // Show modal
            const detailModal = document.getElementById("detail-schedule-modal-overlay");
            if (detailModal) {
                detailModal.classList.add("active");
            }
        }

        function closeDetailModal() {
            const detailModal = document.getElementById("detail-schedule-modal-overlay");
            if (detailModal) {
                detailModal.classList.remove("active");
            }
            activeDetailTaskId = null;
        }

        const closeDetailBtn = document.getElementById("btn-detail-modal-close");
        const closeDetailFooterBtn = document.getElementById("btn-detail-modal-close-footer");
        const detailModalOverlay = document.getElementById("detail-schedule-modal-overlay");
        const completeDetailBtn = document.getElementById("btn-detail-modal-complete");

        if (closeDetailBtn) closeDetailBtn.addEventListener("click", closeDetailModal);
        if (closeDetailFooterBtn) closeDetailFooterBtn.addEventListener("click", closeDetailModal);
        if (detailModalOverlay) {
            detailModalOverlay.addEventListener("click", function(e) {
                if (e.target === detailModalOverlay) {
                    closeDetailModal();
                }
            });
        }

        if (completeDetailBtn) {
            completeDetailBtn.addEventListener("click", function() {
                if (activeDetailTaskId) {
                    const id = activeDetailTaskId;
                    closeDetailModal();
                    openResultModal(id);
                }
            });
        }

        const editDetailBtn = document.getElementById("btn-detail-modal-edit");
        const deleteDetailBtn = document.getElementById("btn-detail-modal-delete");

        if (editDetailBtn) {
            editDetailBtn.addEventListener("click", function () {
                if (!activeDetailTaskId) return;
                const id = parseInt(activeDetailTaskId, 10);
                closeDetailModal();
                openEditScheduleModal(id);
            });
        }

        if (deleteDetailBtn) {
            deleteDetailBtn.addEventListener("click", async function () {
                if (!activeDetailTaskId) return;
                const id = parseInt(activeDetailTaskId, 10);
                closeDetailModal();
                await deleteSchedule(id);
            });
        }

        // Event delegation for "Chi tiết" button (các nút Sửa/Xóa/Bắt đầu cũng dùng
        // class .btn-detail để lấy style nên phải lọc riêng .btn-open-detail)
        document.addEventListener("click", function(e) {
            if (e.target.classList.contains("btn-open-detail")) {
                e.preventDefault();
                const item = e.target.closest(".schedule-item");
                if (item) {
                    const id = item.getAttribute("data-id") || item.getAttribute("id").replace("task-", "");
                    showDetailModal(id);
                }
            }
        });

        // Nạp danh sách phòng thật từ Supabase cho bộ lọc
        async function populateRoomFilter() {
            const { data, error } = await window.sb
                .from("rooms")
                .select("room_code")
                .eq("is_active", true)
                .order("room_code");

            if (error || !roomFilter) return;

            (data || []).forEach(r => {
                const opt = document.createElement("option");
                opt.value = r.room_code;
                opt.innerText = `Phòng ${r.room_code}`;
                roomFilter.appendChild(opt);
            });
        }

        // Initial check — chờ auth-guard nạp xong window.currentUser (vai trò quyết
        // định nhân viên chỉ thấy lịch của mình và các nút thao tác được phép)
        document.addEventListener("silvercare:auth-ready", async function () {
            await Promise.all([populateRoomFilter(), populateStaffFilter()]);

            // Check URL parameters for initial room filtering
            const urlParams = new URLSearchParams(window.location.search);
            const paramRoom = urlParams.get('room');
            if (paramRoom && roomFilter) {
                const clean = paramRoom.replace(/\D/g, '');
                roomFilter.value = clean;
            }

            await loadAndRenderTasks();
        });
    </script>
}
