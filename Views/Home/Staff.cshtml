@{
    ViewData["Title"] = "Đăng nhập nhân viên";
}

<div class="login-page">
    <!-- Back Button -->
    <div class="back-navigation">
        <a asp-controller="Home" asp-action="Index" class="back-link">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Quay lại</span>
        </a>
    </div>

    <!-- Logo -->
    <header class="silvercare-header-login">
        <div class="brand">
            <div class="brand-icon">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="white">
                    <path d="M12 21s-7-4.35-9.33-8.36C.5 8.9 2.11 5 5.7 5
                    7.65 5 9.03 6.06 12 9
                    14.97 6.06 16.35 5 18.3 5
                    21.89 5 23.5 8.9 21.33 12.64
                    19 16.65 12 21 12 21z" />
                </svg>
            </div>
            <span class="brand-name">SilverCare</span>
        </div>
        <p class="brand-slogan">
            "Chăm sóc bằng sự tận tâm"
        </p>
    </header>

    <!-- Login Card -->
    <main class="login-card-container">
        <div class="login-card">
            <h2>Đăng nhập nhân viên</h2>

            <div class="alert-danger" id="loginErrorBox" style="display:none;">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="alert-icon">
                    <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span id="loginErrorText">Email hoặc mật khẩu không đúng.</span>
            </div>

            <div id="loginInfoBox" style="display:none; background:#ecfdf3; border:1px solid #a6f4c5; color:#027a48; border-radius:8px; padding:10px 14px; font-size:14px; margin-bottom:16px;"></div>

            <form class="login-form" id="staffLoginForm">
                <div class="form-group">
                    <label for="username">Email</label>
                    <input type="text" id="username" name="username" inputmode="email" autocomplete="username" placeholder="example@silvercare.vn" required />
                </div>
                
                <div class="form-group">
                    <label for="password">Mật khẩu</label>
                    <div class="password-input-wrapper">
                        <input type="password" id="password" name="password" placeholder="••••••••" required />
                        <button type="button" class="toggle-password-btn" id="togglePasswordBtn" onclick="togglePasswordVisibility()">
                            <!-- Eye icon -->
                            <svg id="eyeIcon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                </div>
                
                <div class="form-options">
                    <label class="remember-checkbox-label">
                        <input type="checkbox" name="remember" id="rememberLogin" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                    <a href="#" class="forgot-password-link" id="forgotPasswordLink">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="login-submit-btn">Đăng nhập</button>
            </form>

            <!-- Quên mật khẩu: gửi email đặt lại -->
            <form class="login-form" id="forgotPasswordForm" style="display:none;">
                <p style="font-size:14px; color:#475467; margin:0 0 4px 0;">Nhập email tài khoản, hệ thống sẽ gửi liên kết đặt lại mật khẩu.</p>
                <div class="form-group">
                    <label for="forgotEmail">Email</label>
                    <input type="text" id="forgotEmail" inputmode="email" autocomplete="email" placeholder="example@silvercare.vn" required />
                </div>
                <button type="submit" class="login-submit-btn">Gửi liên kết đặt lại</button>
                <a href="#" class="forgot-password-link" data-back-to-login style="display:block; text-align:center; margin-top:12px;">← Quay lại đăng nhập</a>
            </form>

            <!-- Đặt mật khẩu mới (mở từ liên kết trong email) -->
            <form class="login-form" id="resetPasswordForm" style="display:none;">
                <p style="font-size:14px; color:#475467; margin:0 0 4px 0;">Đặt mật khẩu mới cho tài khoản của bạn.</p>
                <div class="form-group">
                    <label for="newPassword">Mật khẩu mới</label>
                    <input type="password" id="newPassword" autocomplete="new-password" placeholder="Tối thiểu 8 ký tự" required />
                </div>
                <div class="form-group">
                    <label for="confirmPassword">Nhập lại mật khẩu mới</label>
                    <input type="password" id="confirmPassword" autocomplete="new-password" required />
                </div>
                <button type="submit" class="login-submit-btn">Lưu mật khẩu mới</button>
            </form>
        </div>
    </main>

    <!-- Footer -->
    <footer class="login-footer">
        Dành riêng cho nhân viên trung tâm SilverCare
    </footer>

    <!-- Help support button (bottom right) -->
    <div class="help-support-container">
        <button type="button" class="help-btn" title="Hỗ trợ">?</button>
    </div>
</div>

@section Scripts {
    <script>
        function togglePasswordVisibility() {
            var passwordInput = document.getElementById("password");
            var eyeIcon = document.getElementById("eyeIcon");
            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                eyeIcon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            } else {
                passwordInput.type = "password";
                eyeIcon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
            }
        }

        function showLoginError(message) {
            var box = document.getElementById("loginErrorBox");
            var text = document.getElementById("loginErrorText");
            text.textContent = message;
            box.style.display = "flex";
            document.getElementById("loginInfoBox").style.display = "none";
        }

        function showLoginInfo(message) {
            var box = document.getElementById("loginInfoBox");
            box.textContent = message;
            box.style.display = "block";
            document.getElementById("loginErrorBox").style.display = "none";
        }

        function showForm(id) {
            ["staffLoginForm", "forgotPasswordForm", "resetPasswordForm"].forEach(function (formId) {
                document.getElementById(formId).style.display = formId === id ? "" : "none";
            });
        }

        // "Ghi nhớ đăng nhập": không tích thì phiên chỉ sống đến khi đóng trình duyệt —
        // session cookie sc_session_alive mất khi tắt trình duyệt, auth-guard.js thấy
        // vậy sẽ đăng xuất.
        function applyRememberChoice(remember) {
            document.cookie = "sc_session_alive=1; path=/; SameSite=Lax";
            try {
                if (remember) {
                    localStorage.removeItem("sc_session_only");
                } else {
                    localStorage.setItem("sc_session_only", "1");
                }
            } catch (e) {
                console.warn(e);
            }
        }

        document.getElementById("forgotPasswordLink").addEventListener("click", function (e) {
            e.preventDefault();
            document.getElementById("forgotEmail").value = document.getElementById("username").value.trim();
            showForm("forgotPasswordForm");
        });

        document.querySelectorAll("[data-back-to-login]").forEach(function (link) {
            link.addEventListener("click", function (e) {
                e.preventDefault();
                showForm("staffLoginForm");
            });
        });

        document.getElementById("forgotPasswordForm").addEventListener("submit", async function (e) {
            e.preventDefault();
            var btn = this.querySelector(".login-submit-btn");
            var email = document.getElementById("forgotEmail").value.trim();
            if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
                showLoginError("Vui lòng nhập đúng định dạng email.");
                return;
            }
            btn.disabled = true;
            try {
                var { error } = await window.sb.auth.resetPasswordForEmail(email, {
                    redirectTo: window.location.origin + "/Home/Staff"
                });
                if (error) throw error;
                // Không tiết lộ email có tồn tại hay không
                showLoginInfo("Nếu email thuộc một tài khoản trong hệ thống, liên kết đặt lại mật khẩu đã được gửi. Vui lòng kiểm tra hộp thư.");
                showForm("staffLoginForm");
            } catch (err) {
                console.error(err);
                showLoginError("Không thể gửi email đặt lại mật khẩu. Vui lòng thử lại sau hoặc liên hệ quản trị viên.");
            } finally {
                btn.disabled = false;
            }
        });

        // Liên kết khôi phục từ email trả về dạng #access_token=...&type=recovery
        // (client tắt detectSessionInUrl nên tự xử lý ở đây).
        (async function handleRecoveryLink() {
            var hash = new URLSearchParams(window.location.hash.replace(/^#/, ""));
            if (hash.get("error_description")) {
                showLoginError("Liên kết đặt lại mật khẩu không hợp lệ hoặc đã hết hạn. Vui lòng gửi lại.");
                history.replaceState(null, "", window.location.pathname);
                return;
            }
            if (hash.get("type") !== "recovery" || !hash.get("access_token")) return;

            var { error } = await window.sb.auth.setSession({
                access_token: hash.get("access_token"),
                refresh_token: hash.get("refresh_token")
            });
            history.replaceState(null, "", window.location.pathname);
            if (error) {
                showLoginError("Liên kết đặt lại mật khẩu không hợp lệ hoặc đã hết hạn. Vui lòng gửi lại.");
                return;
            }
            showForm("resetPasswordForm");
        })();

        document.getElementById("resetPasswordForm").addEventListener("submit", async function (e) {
            e.preventDefault();
            var btn = this.querySelector(".login-submit-btn");
            var pass = document.getElementById("newPassword").value;
            var confirmPass = document.getElementById("confirmPassword").value;
            if (pass.length < 8) {
                showLoginError("Mật khẩu mới phải có tối thiểu 8 ký tự.");
                return;
            }
            if (pass !== confirmPass) {
                showLoginError("Hai mật khẩu nhập vào không khớp.");
                return;
            }
            btn.disabled = true;
            try {
                var { error } = await window.sb.auth.updateUser({ password: pass });
                if (error) throw error;
                await window.sb.auth.signOut();
                showForm("staffLoginForm");
                showLoginInfo("Đã đặt mật khẩu mới. Vui lòng đăng nhập lại.");
            } catch (err) {
                console.error(err);
                showLoginError("Không thể đặt mật khẩu mới: " + err.message);
            } finally {
                btn.disabled = false;
            }
        });

        document.getElementById("staffLoginForm").addEventListener("submit", async function (e) {
            e.preventDefault();
            var submitBtn = this.querySelector(".login-submit-btn");
            var email = document.getElementById("username").value.trim();
            var password = document.getElementById("password").value;

            document.getElementById("loginErrorBox").style.display = "none";
            submitBtn.disabled = true;
            submitBtn.textContent = "Đang đăng nhập...";

            try {
                var { data, error } = await window.sb.auth.signInWithPassword({ email: email, password: password });
                if (error || !data.session) {
                    showLoginError("Email hoặc mật khẩu không hợp lệ, vui lòng nhập lại");
                    return;
                }

                var { data: profile, error: profileError } = await window.sb
                    .from("profiles")
                    .select("role, is_active")
                    .eq("id", data.user.id)
                    .single();

                if (profileError || !profile || profile.is_active === false) {
                    await window.sb.auth.signOut();
                    showLoginError("Tài khoản không tồn tại hoặc đã bị khóa.");
                    return;
                }

                if (profile.role === "family") {
                    await window.sb.auth.signOut();
                    showLoginError("Tài khoản người nhà vui lòng đăng nhập ở trang \"Người nhà\".");
                    return;
                }

                applyRememberChoice(document.getElementById("rememberLogin").checked);
                window.location.href = "/Home/Dashboard";
            } catch (err) {
                console.error(err);
                showLoginError("Không thể kết nối tới máy chủ. Vui lòng thử lại sau.");
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = "Đăng nhập";
            }
        });
    </script>
}