@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Hồ sơ người cao tuổi";
    ViewData["AllowedRoles"] = "admin,manager,staff,family";
}

<!-- Custom Styles for Residents Page -->
<style>
    .residents-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .residents-title {
        font-size: 24px;
        font-weight: 700;
        color: #101828;
        margin: 0;
    }

    .residents-actions-group {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .btn-secondary-action {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background-color: #ffffff;
        color: #344054;
        border: 1px solid #d0d5dd;
        border-radius: 8px;
        padding: 10px 16px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05);
        text-decoration: none;
    }

    .btn-secondary-action:hover {
        background-color: #f9fafb;
        border-color: #98a2b3;
    }

    .btn-secondary-action svg {
        width: 18px;
        height: 18px;
        stroke: #344054;
        stroke-width: 2;
        fill: none;
    }

    .btn-primary-action {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background-color: var(--color-primary);
        color: #ffffff;
        border: none;
        border-radius: 8px;
        padding: 10px 18px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05);
        text-decoration: none;
    }

    .btn-primary-action:hover {
        background-color: var(--color-primary-hover);
        transform: translateY(-1px);
    }

    .btn-primary-action svg {
        width: 18px;
        height: 18px;
        stroke: currentColor;
        stroke-width: 2.5;
        fill: none;
    }

    /* Filters Section */
    .residents-filters-card {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        box-shadow: 0 1px 3px rgba(16, 24, 40, 0.05);
    }

    .residents-search-wrapper {
        position: relative;
        flex: 1;
        max-width: 480px;
        min-width: 260px;
    }

    .residents-search-wrapper svg {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        stroke: #667085;
        stroke-width: 2;
        fill: none;
    }

    .residents-search-input {
        width: 100%;
        height: 42px;
        background-color: #f9fafb;
        border: 1px solid #d0d5dd;
        border-radius: 8px;
        padding: 0 16px 0 42px;
        font-size: 14px;
        color: #101828;
        transition: all 0.2s ease;
        outline: none;
    }

    .residents-search-input:focus {
        background-color: #ffffff;
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(11, 165, 236, 0.12);
    }

    .residents-search-input::placeholder {
        color: #667085;
    }

    .residents-pills-wrapper {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .resident-pill {
        background-color: #ffffff;
        border: 1px solid #e4e7ec;
        color: #344054;
        border-radius: 20px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .resident-pill:hover:not(.active) {
        background-color: #f9fafb;
        border-color: #d0d5dd;
    }

    .resident-pill.active {
        background-color: var(--color-primary);
        color: #ffffff;
        border-color: var(--color-primary);
        font-weight: 600;
        box-shadow: 0 1px 2px rgba(11, 165, 236, 0.2);
    }

    /* Table Section */
    .residents-table-card {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(16, 24, 40, 0.05);
    }

    .residents-table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .residents-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 14px;
    }

    .residents-table th {
        background-color: #fafbfc;
        padding: 14px 20px;
        font-size: 12px;
        font-weight: 600;
        color: #475467;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid var(--border-color);
        white-space: nowrap;
    }

    .residents-table td {
        padding: 16px 20px;
        border-bottom: 1px solid #f2f4f7;
        color: #344054;
        vertical-align: middle;
    }

    .residents-table tbody tr {
        transition: background-color 0.15s ease;
    }

    .residents-table tbody tr:hover {
        background-color: #f9fafb;
    }

    .cell-id {
        font-weight: 600;
        color: #475467;
        font-size: 13px;
        white-space: nowrap;
    }

    .profile-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .profile-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: #e0f2fe;
        color: #0ba5ec;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 12px;
        flex-shrink: 0;
    }

    .profile-name {
        font-weight: 600;
        color: #101828;
        white-space: nowrap;
    }

    .cell-age, .cell-gender, .cell-room, .cell-blood {
        color: #344054;
        font-weight: 500;
        white-space: nowrap;
    }

    .cell-contact {
        color: #475467;
        font-weight: 500;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Status Badges */
    .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        line-height: 1.2;
    }

    .status-pill-stable {
        background-color: #ecfdf3;
        color: #027a48;
    }

    .status-pill-monitoring {
        background-color: #fef0c7;
        color: #b54708;
    }

    .status-pill-medium {
        background-color: #fffaeb;
        color: #b54708;
    }

    /* Schedule Status & Type Badges */
    .status-badge {
        font-size: 12px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 12px;
        white-space: nowrap;
        display: inline-block;
    }

    .badge-done {
        background-color: #ecfdf3;
        color: #027a48;
    }

    .badge-pending {
        background-color: #fffaeb;
        color: #b54708;
    }

    .badge-todo {
        background-color: #f2f4f7;
        color: #344054;
    }

    .care-type-badge {
        font-size: 11px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 10px;
        display: inline-block;
    }

    .type-medical {
        background-color: #eff8ff;
        color: #175cd3;
    }

    .type-care {
        background-color: #ecfdf3;
        color: #027a48;
    }

    /* Detail Action Link */
    .btn-view-detail {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #0ba5ec;
        font-weight: 600;
        font-size: 13px;
        text-decoration: none;
        cursor: pointer;
        transition: color 0.15s ease;
        white-space: nowrap;
    }

    .btn-view-detail:hover {
        color: #0086c9;
        text-decoration: underline;
    }

    .btn-view-detail svg {
        width: 16px;
        height: 16px;
        stroke: currentColor;
        stroke-width: 2;
        fill: none;
    }

    /* Empty State */
    .empty-residents {
        padding: 48px 24px;
        text-align: center;
        color: #667085;
    }

    .empty-residents svg {
        width: 48px;
        height: 48px;
        stroke: #98a2b3;
        stroke-width: 1.5;
        fill: none;
        margin-bottom: 12px;
    }

    /* Modal Overlay & Containers */
    .res-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(16, 24, 40, 0.6);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 999;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease, visibility 0.2s ease;
        padding: 20px;
        box-sizing: border-box;
    }

    .res-modal-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    .res-modal-container {
        background: #ffffff;
        border-radius: 16px;
        width: 100%;
        max-width: 580px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        transform: scale(0.96);
        transition: transform 0.2s ease;
        overflow: hidden;
    }

    .res-modal-overlay.active .res-modal-container {
        transform: scale(1);
    }

    .res-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 24px;
        border-bottom: 1px solid var(--border-color);
        background-color: #ffffff;
    }

    .res-modal-title {
        font-size: 18px;
        font-weight: 700;
        color: #101828;
        margin: 0;
    }

    .res-modal-close-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 6px;
        border-radius: 6px;
        color: #667085;
        transition: background-color 0.15s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .res-modal-close-btn:hover {
        background-color: #f2f4f7;
        color: #101828;
    }

    .res-modal-close-btn svg {
        width: 20px;
        height: 20px;
        stroke: currentColor;
        stroke-width: 2;
        fill: none;
    }

    .res-modal-body {
        padding: 24px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .res-modal-footer {
        padding: 16px 24px;
        border-top: 1px solid var(--border-color);
        background-color: #fafbfc;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
    }

    /* Form Elements */
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #344054;
    }

    .form-input, .form-select, .form-textarea {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #d0d5dd;
        border-radius: 8px;
        font-size: 14px;
        color: #101828;
        background-color: #ffffff;
        outline: none;
        box-sizing: border-box;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-input:focus, .form-select:focus, .form-textarea:focus {
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(11, 165, 236, 0.12);
    }

    .form-textarea {
        resize: vertical;
        min-height: 70px;
    }

    /* Detail View Styling */
    .detail-card-banner {
        display: flex;
        align-items: center;
        gap: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid #f2f4f7;
    }

    .detail-avatar-lg {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background-color: #e0f2fe;
        color: #0ba5ec;
        font-size: 20px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .detail-name-meta h3 {
        margin: 0 0 6px 0;
        font-size: 18px;
        font-weight: 700;
        color: #101828;
    }

    .detail-tags {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .tag-badge {
        font-size: 12px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 6px;
        background-color: #f2f4f7;
        color: #344054;
    }

    .detail-section-title {
        font-size: 14px;
        font-weight: 700;
        color: #101828;
        margin: 12px 0 8px 0;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .detail-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        background: #f9fafb;
        padding: 16px;
        border-radius: 10px;
        border: 1px solid #eaecf0;
    }

    .detail-info-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .detail-info-label {
        font-size: 12px;
        color: #667085;
        font-weight: 500;
    }

    .detail-info-value {
        font-size: 14px;
        color: #101828;
        font-weight: 600;
    }

    /* Toast Notification */
    .toast-popup {
        position: fixed;
        bottom: 28px;
        right: 28px;
        background-color: #101828;
        color: #ffffff;
        padding: 12px 20px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        font-weight: 500;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
        z-index: 1000;
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        pointer-events: none;
    }

    .toast-popup.show {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<!-- Header -->
<div class="residents-header">
    <h1 class="residents-title">Hồ sơ người cao tuổi</h1>
    <div class="residents-actions-group" data-roles="admin,manager,staff">
        <!-- Import Excel -->
        <button class="btn-secondary-action" id="btn-import-excel">
            <svg viewBox="0 0 24 24">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <span>Import Excel</span>
        </button>

        <!-- Thêm hồ sơ mới -->
        <button class="btn-primary-action" id="btn-open-create-modal">
            <svg viewBox="0 0 24 24">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Thêm hồ sơ mới</span>
        </button>
    </div>
</div>

<!-- Filters Panel -->
<div class="residents-filters-card">
    <!-- Search Input -->
    <div class="residents-search-wrapper">
        <svg viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" class="residents-search-input" id="residents-search" placeholder="Tìm theo tên, ID, phòng..." />
    </div>

    <!-- Filter Pills -->
    <div class="residents-pills-wrapper">
        <button class="resident-pill active" data-filter="all">Tất cả</button>
        <button class="resident-pill" data-filter="Đang ổn định">Đang ổn định</button>
        <button class="resident-pill" data-filter="Cần theo dõi">Cần theo dõi</button>
        <button class="resident-pill" data-filter="Trung bình">Trung bình</button>
    </div>
</div>

<!-- Table Card -->
<div class="residents-table-card">
    <div class="residents-table-responsive">
        <table class="residents-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>HỌ TÊN</th>
                    <th>TUỔI</th>
                    <th>GIỚI TÍNH</th>
                    <th>PHÒNG</th>
                    <th>NHÓM MÁU</th>
                    <th>TÌNH TRẠNG</th>
                    <th>NGƯỜI LIÊN HỆ</th>
                    <th style="width: 120px; text-align: right;"></th>
                </tr>
            </thead>
            <tbody id="residents-table-body">
                <!-- Dynamically populated from JavaScript / nguoinha.sql -->
            </tbody>
        </table>
    </div>

    <!-- Empty State -->
    <div class="empty-residents" id="residents-empty-state" style="display: none;">
        <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <p>Không tìm thấy hồ sơ người cao tuổi phù hợp.</p>
    </div>
</div>

<!-- ==========================================================================
   MODAL: THÊM HỒ SƠ MỚI
   ========================================================================== -->
<div class="res-modal-overlay" id="create-resident-modal">
    <div class="res-modal-container">
        <div class="res-modal-header">
            <h2 class="res-modal-title">Thêm hồ sơ người cao tuổi</h2>
            <button class="res-modal-close-btn" id="btn-close-create-modal" title="Đóng">
                <svg viewBox="0 0 24 24">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <div class="res-modal-body">
            <div class="form-group">
                <label class="form-label" for="inp-fullname">Họ và tên <span style="color: #f04438;">*</span></label>
                <input type="text" class="form-input" id="inp-fullname" placeholder="VD: Nguyễn Văn An" required />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="inp-age">Tuổi <span style="color: #f04438;">*</span></label>
                    <input type="number" class="form-input" id="inp-age" placeholder="78" min="50" max="120" required />
                </div>
                <div class="form-group">
                    <label class="form-label" for="inp-gender">Giới tính</label>
                    <select class="form-select" id="inp-gender">
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="inp-room">Phòng <span style="color: #f04438;">*</span></label>
                    <select class="form-select" id="inp-room" required>
                        <option value="">Đang tải danh sách phòng...</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="inp-blood">Nhóm máu</label>
                    <select class="form-select" id="inp-blood">
                        <option value="A+">A+</option>
                        <option value="B+">B+</option>
                        <option value="O+" selected>O+</option>
                        <option value="AB+">AB+</option>
                        <option value="A-">A-</option>
                        <option value="B-">B-</option>
                        <option value="O-">O-</option>
                        <option value="AB-">AB-</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="inp-status">Tình trạng sức khỏe</label>
                <select class="form-select" id="inp-status">
                    <option value="Đang ổn định" selected>Đang ổn định</option>
                    <option value="Cần theo dõi">Cần theo dõi</option>
                    <option value="Trung bình">Trung bình</option>
                </select>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="inp-family-name">Họ tên người nhà <span style="color: #f04438;">*</span></label>
                    <input type="text" class="form-input" id="inp-family-name" placeholder="VD: Nguyễn Văn Hải" required />
                </div>
                <div class="form-group">
                    <label class="form-label" for="inp-family-phone">Số điện thoại <span style="color: #f04438;">*</span></label>
                    <input type="tel" class="form-input" id="inp-family-phone" placeholder="0909090909" required />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="inp-family-rel">Mối quan hệ</label>
                    <select class="form-select" id="inp-family-rel">
                        <option value="Con trai">Con trai</option>
                        <option value="Con gái">Con gái</option>
                        <option value="Chồng">Chồng</option>
                        <option value="Vợ">Vợ</option>
                        <option value="Cháu">Cháu</option>
                        <option value="Khác">Khác</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="inp-admission">Ngày tiếp nhận</label>
                    <input type="date" class="form-input" id="inp-admission" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="inp-family-address">Địa chỉ người nhà</label>
                <input type="text" class="form-input" id="inp-family-address" placeholder="123 Nguyễn Trãi, Quận 1, TP. HCM" />
            </div>

            <div class="form-group">
                <label class="form-label" for="inp-notes">Ghi chú bệnh nền / sức khỏe</label>
