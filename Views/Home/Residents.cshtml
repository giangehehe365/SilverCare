            if (btnCloseCareSchedule) btnCloseCareSchedule.addEventListener("click", closeCareScheduleModal);
            if (btnCloseCareScheduleFooter) btnCloseCareScheduleFooter.addEventListener("click", closeCareScheduleModal);
            if (careScheduleModal) {
                careScheduleModal.addEventListener("click", function(e) {
                    if (e.target === careScheduleModal) closeCareScheduleModal();
                });
            }

            // ==========================================================================
            // CREATE MODAL LOGIC
            // ==========================================================================
            const createModal = document.getElementById("create-resident-modal");
            const btnOpenCreate = document.getElementById("btn-open-create-modal");
            const btnCloseCreate = document.getElementById("btn-close-create-modal");
            const btnCancelCreate = document.getElementById("btn-cancel-create-modal");
            const btnSaveResident = document.getElementById("btn-save-new-resident");

            async function openCreateModal() {
                // Reset form
                document.getElementById("inp-fullname").value = "";
                document.getElementById("inp-age").value = "";
                document.getElementById("inp-gender").value = "Nam";
                document.getElementById("inp-blood").value = "O+";
                document.getElementById("inp-status").value = "Đang ổn định";
                document.getElementById("inp-family-name").value = "";
                document.getElementById("inp-family-phone").value = "";
                document.getElementById("inp-family-rel").value = "Con trai";
                document.getElementById("inp-family-address").value = "";
                document.getElementById("inp-admission").valueAsDate = new Date();
                document.getElementById("inp-notes").value = "";

                const roomSelect = document.getElementById("inp-room");
                roomSelect.innerHTML = '<option value="">Đang tải danh sách phòng...</option>';

                createModal.classList.add("active");

                const rooms = await loadAvailableRooms();
                if (rooms.length === 0) {
                    roomSelect.innerHTML = '<option value="">Không còn phòng trống</option>';
                } else {
                    roomSelect.innerHTML = rooms
                        .map(r => `<option value="${r.room_id}">${r.room_code}${r.room_name ? " - " + r.room_name : ""} (còn trống)</option>`)
                        .join("");
                }
            }

            function closeCreateModal() {
                createModal.classList.remove("active");
            }

            if (btnOpenCreate) btnOpenCreate.addEventListener("click", openCreateModal);
            if (btnCloseCreate) btnCloseCreate.addEventListener("click", closeCreateModal);
            if (btnCancelCreate) btnCancelCreate.addEventListener("click", closeCreateModal);
            if (createModal) {
                createModal.addEventListener("click", function(e) {
                    if (e.target === createModal) closeCreateModal();
                });
            }

            if (btnSaveResident) {
                btnSaveResident.addEventListener("click", async function () {
                    const name = document.getElementById("inp-fullname").value.trim();
                    const age = parseInt(document.getElementById("inp-age").value);
                    const gender = document.getElementById("inp-gender").value;
                    const roomId = document.getElementById("inp-room").value;
                    const blood = document.getElementById("inp-blood").value;
                    const status = document.getElementById("inp-status").value;
                    const familyName = document.getElementById("inp-family-name").value.trim();
                    const familyPhone = document.getElementById("inp-family-phone").value.trim();
                    const familyRel = document.getElementById("inp-family-rel").value;
                    const familyAddress = document.getElementById("inp-family-address").value.trim();
                    const admissionVal = document.getElementById("inp-admission").value;
                    const notes = document.getElementById("inp-notes").value.trim();

                    if (!name || isNaN(age) || !roomId || !familyName || !familyPhone) {
                        alert("Vui lòng điền đầy đủ các thông tin bắt buộc (*)");
                        return;
                    }

                    btnSaveResident.disabled = true;
                    btnSaveResident.textContent = "Đang lưu...";

                    try {
                        await createResident({
                            name,
                            age,
                            gender,
                            roomId: parseInt(roomId, 10),
                            blood,
                            status,
                            familyName,
                            familyPhone,
                            familyRel,
                            familyAddress,
                            admissionIso: admissionVal,
                            notes
                        });

                        closeCreateModal();
                        await loadResidents();
                        renderTable();
                        showToast(`Đã thêm hồ sơ thành công cho: ${name}`);
                    } catch (err) {
                        console.error(err);
                        alert("Không thể lưu hồ sơ: " + err.message);
                    } finally {
                        btnSaveResident.disabled = false;
                        btnSaveResident.textContent = "Lưu hồ sơ";
                    }
                });
            }

            // ==========================================================================
            // EDIT MODAL LOGIC
            // ==========================================================================
            const editModal = document.getElementById("edit-resident-modal");
            const btnCloseEdit = document.getElementById("btn-close-edit-modal");
            const btnCancelEdit = document.getElementById("btn-cancel-edit-modal");
            const btnSaveEditResident = document.getElementById("btn-save-edit-resident");
            const editFamilyProfileSelect = document.getElementById("edit-family-profile");
            let activeEditResident = null;

            async function openEditModal(id) {
                const res = currentResidents.find(r => r.id === id);
                if (!res) return;
                activeEditResident = res;

                document.getElementById("edit-fullname").value = res.name || "";
                document.getElementById("edit-age").value = res.age || "";
                document.getElementById("edit-gender").value = res.gender || "Nam";
                document.getElementById("edit-blood").value = res.blood || "O+";
                document.getElementById("edit-status").value = res.status || "Đang ổn định";
                document.getElementById("edit-family-rel").value = res.familyRel || "Con trai";
                document.getElementById("edit-family-phone").value = res.familyPhone || "";
                document.getElementById("edit-family-address").value = res.familyAddress || "";
                document.getElementById("edit-admission").value = res.admissionDateIso || "";
                document.getElementById("edit-notes").value = res.notes || "";

                const roomSelect = document.getElementById("edit-room");
                roomSelect.innerHTML = '<option value="">Đang tải danh sách phòng...</option>';
                editFamilyProfileSelect.innerHTML = '<option value="">Đang tải danh sách tài khoản...</option>';

                editModal.classList.add("active");

                const [rooms] = await Promise.all([
                    loadRoomsForEdit(res.residentId, res.roomId),
                    loadFamilyProfiles()
                ]);

                roomSelect.innerHTML = rooms
                    .map(r => `<option value="${r.room_id}" ${r.room_id === res.roomId ? "selected" : ""}>${r.room_code}${r.room_name ? " - " + r.room_name : ""}</option>`)
                    .join("");

                editFamilyProfileSelect.innerHTML = '<option value="">-- Chọn tài khoản người nhà --</option>' +
                    familyProfilesCache
                        .map(p => `<option value="${p.id}" ${p.id === res.familyProfileId ? "selected" : ""}>${p.full_name}${p.email ? " (" + p.email + ")" : ""}</option>`)
                        .join("");
            }

            function closeEditModal() {
                editModal.classList.remove("active");
            }

            if (btnCloseEdit) btnCloseEdit.addEventListener("click", closeEditModal);
            if (btnCancelEdit) btnCancelEdit.addEventListener("click", closeEditModal);
            if (editModal) {
                editModal.addEventListener("click", function (e) {
                    if (e.target === editModal) closeEditModal();
                });
            }

            // Tự điền số điện thoại từ tài khoản được chọn nếu ô đang trống
            if (editFamilyProfileSelect) {
                editFamilyProfileSelect.addEventListener("change", function () {
                    const profile = familyProfilesCache.find(p => p.id === this.value);
                    const phoneInput = document.getElementById("edit-family-phone");
                    if (profile && profile.phone && !phoneInput.value.trim()) {
                        phoneInput.value = profile.phone;
                    }
                });
            }

            if (btnSaveEditResident) {
                btnSaveEditResident.addEventListener("click", async function () {
                    if (!activeEditResident) return;

                    const name = document.getElementById("edit-fullname").value.trim();
                    const age = parseInt(document.getElementById("edit-age").value);
                    const gender = document.getElementById("edit-gender").value;
                    const roomId = document.getElementById("edit-room").value;
                    const blood = document.getElementById("edit-blood").value;
                    const status = document.getElementById("edit-status").value;
                    const familyProfileId = editFamilyProfileSelect.value;
                    const familyRel = document.getElementById("edit-family-rel").value;
                    const familyPhone = document.getElementById("edit-family-phone").value.trim();
                    const familyAddress = document.getElementById("edit-family-address").value.trim();
                    const admissionVal = document.getElementById("edit-admission").value;
                    const notes = document.getElementById("edit-notes").value.trim();

                    if (!name || isNaN(age) || !roomId || !familyProfileId) {
                        alert("Vui lòng điền đầy đủ các thông tin bắt buộc (*), bao gồm chọn tài khoản người nhà liên hệ.");
                        return;
                    }

                    btnSaveEditResident.disabled = true;
                    btnSaveEditResident.textContent = "Đang lưu...";

                    try {
                        await updateResident(activeEditResident.residentId, activeEditResident.familyMemberId, {
                            name,
                            age,
                            gender,
                            roomId: parseInt(roomId, 10),
                            blood,
                            status,
                            familyProfileId,
                            familyRel,
                            familyPhone,
                            familyAddress,
                            admissionIso: admissionVal,
                            notes
                        });

                        closeEditModal();
                        await loadResidents();
                        renderTable();
                        showToast(`Đã cập nhật hồ sơ: ${name}`);
                    } catch (err) {
                        console.error(err);
                        alert("Không thể lưu thay đổi: " + err.message);
                    } finally {
                        btnSaveEditResident.disabled = false;
                        btnSaveEditResident.textContent = "Lưu thay đổi";
                    }
                });
            }

            // ==========================================================================
            // IMPORT EXCEL MODAL LOGIC
            // ==========================================================================
            const importModal = document.getElementById("import-excel-modal");
            const btnOpenImport = document.getElementById("btn-import-excel");
            const btnCloseImport = document.getElementById("btn-close-import-modal");
            const btnCancelImport = document.getElementById("btn-cancel-import");
            const btnSubmitImport = document.getElementById("btn-submit-import");

            function openImportModal() {
                document.getElementById("import-file-name").style.display = "none";
                document.getElementById("excel-file-input").value = "";
                importModal.classList.add("active");
            }

            function closeImportModal() {
                importModal.classList.remove("active");
            }

            if (btnOpenImport) btnOpenImport.addEventListener("click", openImportModal);
            if (btnCloseImport) btnCloseImport.addEventListener("click", closeImportModal);
            if (btnCancelImport) btnCancelImport.addEventListener("click", closeImportModal);
            if (importModal) {
                importModal.addEventListener("click", function(e) {
                    if (e.target === importModal) closeImportModal();
                });
            }

            window.handleExcelSelect = function(e) {
                const file = e.target.files[0];
                if (file) {
                    const label = document.getElementById("import-file-name");
                    label.innerText = `Đã chọn: ${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
                    label.style.display = "block";
                }
            };

            if (btnSubmitImport) {
                btnSubmitImport.addEventListener("click", function() {
                    const fileInput = document.getElementById("excel-file-input");
                    if (!fileInput.files || fileInput.files.length === 0) {
                        alert("Vui lòng chọn một file Excel hoặc CSV để tải lên!");
                        return;
                    }
                    closeImportModal();
                    showToast("Đã xử lý và import dữ liệu Excel thành công!");
                });
            }

            // ==========================================================================
            // SEARCH & FILTER LISTENERS
            // ==========================================================================
            document.querySelectorAll(".resident-pill").forEach(pill => {
                pill.addEventListener("click", function () {
                    document.querySelectorAll(".resident-pill").forEach(p => p.classList.remove("active"));
                    this.classList.add("active");
                    renderTable();
                });
            });

            const searchInp = document.getElementById("residents-search");
            if (searchInp) {
                searchInp.addEventListener("input", renderTable);
            }

            // Initialize
            await loadResidents();
            renderTable();

            // Auto-open detail modal if navigated with residentId/id
            const urlParams = new URLSearchParams(window.location.search);
            const targetResId = urlParams.get('residentId') || urlParams.get('id');
            const targetName = urlParams.get('name');
            if (targetResId || targetName) {
                setTimeout(() => {
                    let target = null;
                    if (targetResId) {
                        target = currentResidents.find(r => r.id === targetResId);
                    }
                    if (!target && targetName) {
                        target = currentResidents.find(r => r.name.toLowerCase().includes(targetName.toLowerCase()));
                    }
                    if (target) {
                        openDetailModal(target.id);
                    }
                }, 200);
            }
        });
    </script>
}
