            if (btnCloseDetail) btnCloseDetail.addEventListener("click", closeDetailModal);
            if (btnCloseDetailFooter) btnCloseDetailFooter.addEventListener("click", closeDetailModal);
            if (detailModal) {
                detailModal.addEventListener("click", function(e) {
                    if (e.target === detailModal) closeDetailModal();
                });
            }

            const btnDetailEdit = document.getElementById("btn-detail-edit");
            if (btnDetailEdit) {
                btnDetailEdit.addEventListener("click", function () {
                    if (!activeDetailResident) return;
                    closeDetailModal();
                    openEditModal(activeDetailResident.id);
                });
            }

            // ==========================================================================
            // CARE SCHEDULE POPUP MODAL LOGIC
            // ==========================================================================
            const careScheduleModal = document.getElementById("resident-care-schedule-modal");
            const btnOpenCareSchedule = document.getElementById("btn-detail-schedule");
            const btnCloseCareSchedule = document.getElementById("btn-close-care-schedule-modal");
            const btnCloseCareScheduleFooter = document.getElementById("btn-close-care-schedule-footer");
            const careScheduleList = document.getElementById("care-schedule-list");
            const careScheduleResidentName = document.getElementById("care-schedule-resident-name");
            const careScheduleResidentMeta = document.getElementById("care-schedule-resident-meta");
            const btnCareScheduleViewFull = document.getElementById("btn-care-schedule-view-full");

            function openCareScheduleModal(res) {
                if (!res) return;

                if (careScheduleResidentName) careScheduleResidentName.innerText = res.name;
                if (careScheduleResidentMeta) careScheduleResidentMeta.innerHTML = `Mã: ${res.id} &middot; Phòng ${res.room}`;
                if (btnCareScheduleViewFull) {
                    const cleanRoom = res.room ? res.room.replace(/\D/g, '') : '';
                    btnCareScheduleViewFull.href = `@Url.Action("Schedule", "Home")?room=${encodeURIComponent(cleanRoom)}&name=${encodeURIComponent(res.name)}`;
                }

                // Get tasks from localStorage or default
                let allTasks = [];
                const savedTasks = localStorage.getItem("silvercare_schedules_v2");
                if (savedTasks) {
                    try {
                        allTasks = JSON.parse(savedTasks);
                    } catch (e) {
                        allTasks = [...defaultCareTasks];
                    }
                } else {
                    allTasks = [...defaultCareTasks];
                }

                // Filter tasks matching this resident
                const resNameNorm = res.name.toLowerCase().trim();
                const resRoomNorm = res.room ? res.room.replace(/\D/g, '').trim() : '';

                const matchedTasks = allTasks.filter(t => {
                    const tName = (t.patientName || "").toLowerCase().trim();
                    const tRoom = (t.patientRoom || "").replace(/\D/g, '').trim();

                    if (tName === resNameNorm) return true;
                    if (tName && resNameNorm && (tName.includes(resNameNorm) || resNameNorm.includes(tName))) return true;
                    if (resRoomNorm && tRoom && resRoomNorm === tRoom && tName.includes(resNameNorm.split(' ').pop())) return true;
                    return false;
                });

                if (matchedTasks.length > 0) {
                    // Sort by time
                    matchedTasks.sort((a, b) => (a.time || "").localeCompare(b.time || ""));

                    careScheduleList.innerHTML = matchedTasks.map(task => {
                        const isDone = task.status === "done";
                        const isPending = task.status === "pending";
                        const badgeClass = isDone ? "badge-done" : (isPending ? "badge-pending" : "badge-todo");
                        const badgeText = isDone ? "Hoàn thành" : (isPending ? "Đang chờ" : "Chưa thực hiện");
                        const typeClass = task.type === "Y tế" ? "type-medical" : "type-care";

                        return `
                            <div class="care-task-card" style="background: #ffffff; border: 1px solid #eaecf0; border-radius: 10px; padding: 14px 16px; display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; box-shadow: 0 1px 2px rgba(16,24,40,0.04);">
                                <div style="display: flex; gap: 12px; align-items: flex-start;">
                                    <div style="background: #f0f9ff; color: #026aa2; font-weight: 700; font-size: 13px; padding: 6px 10px; border-radius: 8px; border: 1px solid #b9e6fe; white-space: nowrap;">
                                        ${task.time}
                                    </div>
                                    <div>
                                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                            <span style="font-weight: 600; color: #101828; font-size: 14px;">${task.name}</span>
                                            <span class="care-type-badge ${typeClass}">
                                                ${task.type || "Chăm sóc"}
                                            </span>
                                        </div>
                                        ${task.note ? `
                                            <div style="font-size: 12px; color: #475467; margin-top: 5px; display: flex; align-items: center; gap: 4px;">
                                                <svg viewBox="0 0 24 24" style="width: 13px; height: 13px; stroke: #98a2b3; fill: none; stroke-width: 2; flex-shrink: 0;"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                                <span>${task.note}</span>
                                            </div>
                                        ` : ''}
                                    </div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
                                    <span class="status-badge ${badgeClass}">
                                        ${badgeText}
                                    </span>
                                </div>
                            </div>
                        `;
                    }).join("");
                } else {
                    // Empty state matching prompt requirement exactly: "Chưa có lịch chăm sóc của ..."
                    careScheduleList.innerHTML = `
                        <div class="care-schedule-empty" style="text-align: center; padding: 36px 16px;">
                            <div style="width: 56px; height: 56px; border-radius: 50%; background: #f2f4f7; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px;">
                                <svg viewBox="0 0 24 24" style="width: 28px; height: 28px; stroke: #667085; stroke-width: 1.8; fill: none;">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                            </div>
                            <div style="font-size: 16px; font-weight: 700; color: #101828; margin-bottom: 6px;">
                                Chưa có lịch chăm sóc của ${res.name}
                            </div>
                            <div style="font-size: 13px; color: #667085; max-width: 380px; margin: 0 auto 16px auto; line-height: 1.5;">
                                Hiện tại chưa có công việc hoặc lịch chăm sóc nào được lên lịch cho người cao tuổi này trong hôm nay.
                            </div>
                            <a href="@Url.Action("Schedule", "Home")" class="btn-primary-action" style="font-size: 13px; padding: 8px 16px; display: inline-flex; text-decoration: none;">
                                + Tạo lịch chăm sóc
                            </a>
                        </div>
                    `;
                }

                careScheduleModal.classList.add("active");
            }

            function closeCareScheduleModal() {
                careScheduleModal.classList.remove("active");
            }

            if (btnOpenCareSchedule) {
