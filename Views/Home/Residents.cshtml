            // ==========================================================================
            // IMPORT / EXPORT EXCEL (SheetJS)
            // Cùng một bộ cột cho file export, file mẫu và file import, để có thể
            // export -> sửa trong Excel -> import lại (cập nhật theo Mã hồ sơ).
            // ==========================================================================
            const EXCEL_COLUMNS = [
                { key: "code", header: "Mã hồ sơ", width: 12 },
                { key: "name", header: "Họ và tên", width: 26 },
                { key: "age", header: "Tuổi", width: 8 },
                { key: "gender", header: "Giới tính", width: 10 },
                { key: "room", header: "Phòng", width: 10 },
                { key: "blood", header: "Nhóm máu", width: 10 },
                { key: "status", header: "Tình trạng sức khỏe", width: 20 },
                { key: "admission", header: "Ngày nhập viện", width: 15 },
                { key: "notes", header: "Ghi chú", width: 30 },
                { key: "familyName", header: "Họ tên người nhà", width: 24 },
                { key: "familyRel", header: "Mối quan hệ", width: 14 },
                { key: "familyPhone", header: "SĐT người nhà", width: 15 },
                { key: "familyAddress", header: "Địa chỉ người nhà", width: 34 }
            ];
            // Chỉ có trong file export, bị bỏ qua khi import
            const EXPORT_ONLY_COLUMNS = [{ key: "active", header: "Trạng thái hồ sơ", width: 18 }];
            const VALID_BLOOD_TYPES = ["A+", "B+", "O+", "AB+", "A-", "B-", "O-", "AB-"];
            const VALID_STATUSES = ["Đang ổn định", "Cần theo dõi", "Trung bình"];

            function normalizeKey(s) {
                return String(s == null ? "" : s)
                    .normalize("NFD").replace(/[̀-ͯ]/g, "")
                    .replace(/đ/gi, "d")
                    .replace(/[^a-z0-9]/gi, "")
                    .toLowerCase();
            }

            const HEADER_LOOKUP = { hoten: "name", maphong: "room", sodienthoai: "familyPhone", sdt: "familyPhone", tinhtrang: "status" };
            EXCEL_COLUMNS.forEach(c => { HEADER_LOOKUP[normalizeKey(c.header)] = c.key; });

            function pad2(n) { return String(n).padStart(2, "0"); }

            function todayStamp() {
                const d = new Date();
                return `${d.getFullYear()}${pad2(d.getMonth() + 1)}${pad2(d.getDate())}`;
            }

            function cellText(v) {
                return v == null ? "" : String(v).trim();
            }

            // Ô ngày có thể là số serial của Excel hoặc chuỗi dd/mm/yyyy / yyyy-mm-dd
            function parseExcelDate(v) {
                if (cellText(v) === "") return { iso: null };
                let y, m, d;
                if (typeof v === "number") {
                    const parsed = XLSX.SSF.parse_date_code(v);
                    if (!parsed) return { error: "Ngày nhập viện không hợp lệ" };
                    y = parsed.y; m = parsed.m; d = parsed.d;
                } else {
                    const s = cellText(v);
                    let match = s.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})$/);
                    if (match) {
                        d = +match[1]; m = +match[2]; y = +match[3];
                    } else if ((match = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/))) {
                        y = +match[1]; m = +match[2]; d = +match[3];
                    } else {
                        return { error: `Ngày nhập viện "${s}" không đúng định dạng dd/mm/yyyy` };
                    }
                }
                const dt = new Date(y, m - 1, d);
                if (dt.getFullYear() !== y || dt.getMonth() !== m - 1 || dt.getDate() !== d) {
                    return { error: "Ngày nhập viện không tồn tại" };
                }
                return { iso: `${y}-${pad2(m)}-${pad2(d)}` };
            }

            // Excel hay làm mất số 0 đầu khi ô SĐT là kiểu số
            function normalizePhone(v) {
                let s = cellText(v).replace(/\s+/g, "");
                if (typeof v === "number" && /^\d{9}$/.test(s)) s = "0" + s;
                return s;
            }

            function normalizeGender(v) {
                const k = normalizeKey(v);
                if (!k) return { value: null };
                if (["nam", "male", "m"].includes(k)) return { value: "Nam" };
                if (["nu", "female", "f"].includes(k)) return { value: "Nữ" };
                return { error: `Giới tính "${cellText(v)}" không hợp lệ (Nam/Nữ)` };
            }

            function normalizeBlood(v) {
                const s = cellText(v).toUpperCase().replace(/\s+/g, "");
                if (!s) return { value: null };
                if (VALID_BLOOD_TYPES.includes(s)) return { value: s };
                return { error: `Nhóm máu "${cellText(v)}" không hợp lệ` };
            }

            function normalizeStatus(v) {
                const k = normalizeKey(v);
                if (!k) return { value: null };
                const found = VALID_STATUSES.find(s => normalizeKey(s) === k);
                if (found) return { value: found };
                return { error: `Tình trạng "${cellText(v)}" không hợp lệ (${VALID_STATUSES.join(" / ")})` };
            }

            function ensureXlsxLoaded() {
                if (typeof XLSX !== "undefined") return true;
                alert("Không tải được thư viện Excel. Vui lòng kiểm tra kết nối mạng và thử lại.");
                return false;
            }

            // ---------- EXPORT ----------
            function exportResidentsToExcel() {
                if (!ensureXlsxLoaded()) return;
                const list = getVisibleResidents();
                if (list.length === 0) {
                    showToast("Không có hồ sơ nào để xuất.");
                    return;
                }

                const cols = EXCEL_COLUMNS.concat(EXPORT_ONLY_COLUMNS);
                const rows = list.map(res => ({
                    code: res.id,
                    name: res.name,
                    age: res.age,
                    gender: res.gender,
                    room: res.room,
                    blood: res.blood,
                    status: res.status,
                    admission: res.admissionDate,
                    notes: res.notes,
                    familyName: res.familyName,
                    familyRel: res.familyRel,
                    familyPhone: res.familyPhone,
                    familyAddress: res.familyAddress,
                    active: res.isActive ? "Đang hoạt động" : "Ngừng hoạt động"
                }));

                const aoa = [cols.map(c => c.header)].concat(rows.map(r => cols.map(c => r[c.key] == null ? "" : r[c.key])));
                const ws = XLSX.utils.aoa_to_sheet(aoa);
                ws["!cols"] = cols.map(c => ({ wch: c.width }));
                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, "Hồ sơ người cao tuổi");
                XLSX.writeFile(wb, `DanhSachHoSo_${todayStamp()}.xlsx`);
                showToast(`Đã xuất ${list.length} hồ sơ ra file Excel.`);
            }

            function downloadImportTemplate() {
                if (!ensureXlsxLoaded()) return;
                const sample = {
                    code: "", name: "Nguyễn Văn An", age: 78, gender: "Nam", room: "201", blood: "O+",
                    status: "Đang ổn định", admission: "01/09/2026", notes: "",
                    familyName: "Nguyễn Văn Hải", familyRel: "Con trai", familyPhone: "0909090909",
                    familyAddress: "123 Nguyễn Trãi, Quận 1, TP. HCM"
                };
                const ws = XLSX.utils.aoa_to_sheet([
                    EXCEL_COLUMNS.map(c => c.header),
                    EXCEL_COLUMNS.map(c => sample[c.key])
                ]);
                ws["!cols"] = EXCEL_COLUMNS.map(c => ({ wch: c.width }));
                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, "Mẫu import");
                XLSX.writeFile(wb, "MauImportHoSo.xlsx");
            }

            const btnExportExcel = document.getElementById("btn-export-excel");
            if (btnExportExcel) btnExportExcel.addEventListener("click", exportResidentsToExcel);

            const btnDownloadTemplate = document.getElementById("btn-download-template");
            if (btnDownloadTemplate) {
                btnDownloadTemplate.addEventListener("click", function (e) {
                    e.preventDefault();
                    downloadImportTemplate();
                });
            }

            // ---------- IMPORT ----------
            const importModal = document.getElementById("import-excel-modal");
            const btnOpenImport = document.getElementById("btn-import-excel");
            const btnCloseImport = document.getElementById("btn-close-import-modal");
            const btnCancelImport = document.getElementById("btn-cancel-import");
            const btnSubmitImport = document.getElementById("btn-submit-import");
            const importPreview = document.getElementById("import-preview");
            let importPlan = [];      // các dòng hợp lệ, sẵn sàng ghi
            let importRunning = false;

            function resetImportState() {
                importPlan = [];
                importPreview.style.display = "none";
                importPreview.innerHTML = "";
                btnSubmitImport.disabled = true;
                btnSubmitImport.textContent = "Nhập dữ liệu";
            }

            function openImportModal() {
                document.getElementById("import-file-name").style.display = "none";
                document.getElementById("excel-file-input").value = "";
                resetImportState();
                importModal.classList.add("active");
            }

            function closeImportModal() {
                if (importRunning) return;
                importModal.classList.remove("active");
            }

            if (btnOpenImport) btnOpenImport.addEventListener("click", openImportModal);
            if (btnCloseImport) btnCloseImport.addEventListener("click", closeImportModal);
            if (btnCancelImport) btnCancelImport.addEventListener("click", closeImportModal);
            if (importModal) {
                importModal.addEventListener("click", function(e) {
                    if (e.target === importModal) closeImportModal();
                });
            }

            // Đọc + kiểm tra toàn bộ file, chưa ghi gì vào CSDL
            async function buildImportPlan(file) {
                const buffer = await file.arrayBuffer();
                const wb = XLSX.read(buffer, { type: "array" });
                const sheet = wb.Sheets[wb.SheetNames[0]];
                const rawRows = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: "", raw: true, blankrows: false });
                if (rawRows.length < 2) {
                    return { fatal: "File không có dòng dữ liệu nào (dòng đầu tiên phải là tiêu đề cột)." };
                }

                const colKeys = rawRows[0].map(h => HEADER_LOOKUP[normalizeKey(h)] || null);
                const missing = ["name", "age", "room"]
                    .filter(k => !colKeys.includes(k))
                    .map(k => EXCEL_COLUMNS.find(c => c.key === k).header);
                if (missing.length > 0) {
                    return { fatal: `File thiếu cột bắt buộc: ${missing.join(", ")}. Hãy dùng "Tải file mẫu".` };
                }

                const { data: rooms, error: roomsError } = await window.sb
                    .from("rooms")
                    .select("room_id, room_code, capacity")
                    .eq("is_active", true);
                if (roomsError) throw roomsError;

                const roomByCode = {};
                (rooms || []).forEach(r => { roomByCode[normalizeKey(r.room_code)] = r; });

                // Số chỗ đã dùng mỗi phòng, cập nhật dần theo từng dòng import
                const occupancy = {};
                currentResidents.forEach(r => {
                    if (r.isActive && r.roomId) occupancy[r.roomId] = (occupancy[r.roomId] || 0) + 1;
                });

                const residentByCode = {};
                currentResidents.forEach(r => { residentByCode[normalizeKey(r.id)] = r; });

                const seenCodes = {};
                const valid = [];
                const invalid = [];

                for (let i = 1; i < rawRows.length; i++) {
                    const raw = {};
                    colKeys.forEach((key, idx) => { if (key) raw[key] = rawRows[i][idx]; });
                    if (Object.values(raw).every(v => cellText(v) === "")) continue;

                    const rowNum = i + 1;
                    const errors = [];
                    const code = cellText(raw.code);
                    const existing = code ? residentByCode[normalizeKey(code)] : null;

                    if (code) {
                        const k = normalizeKey(code);
                        if (seenCodes[k]) errors.push(`Mã hồ sơ ${code} trùng với dòng ${seenCodes[k]}`);
                        else seenCodes[k] = rowNum;
                    }

                    const name = cellText(raw.name);
                    if (!name) errors.push("Thiếu Họ và tên");

                    const ageText = cellText(raw.age);
                    const age = /^\d+$/.test(ageText) ? parseInt(ageText, 10) : NaN;
                    if (isNaN(age)) errors.push("Thiếu hoặc sai Tuổi");
                    else if (age < 50 || age > 120) errors.push("Tuổi phải từ 50 đến 120");

                    const roomText = cellText(raw.room);
                    const room = roomText ? roomByCode[normalizeKey(roomText)] : null;
                    if (!roomText) errors.push("Thiếu Phòng");
                    else if (!room) errors.push(`Phòng "${roomText}" không tồn tại hoặc đã ngừng sử dụng`);

                    const gender = normalizeGender(raw.gender);
                    const blood = normalizeBlood(raw.blood);
                    const status = normalizeStatus(raw.status);
                    const admission = parseExcelDate(raw.admission);
                    [gender, blood, status, admission].forEach(r => { if (r.error) errors.push(r.error); });

                    const familyName = cellText(raw.familyName);
                    const familyPhone = normalizePhone(raw.familyPhone);
                    const familyRel = cellText(raw.familyRel);
                    const familyAddress = cellText(raw.familyAddress);
                    if (!familyName && (familyPhone || familyRel || familyAddress) && !(existing && existing.familyMemberId)) {
                        errors.push("Có thông tin người nhà nhưng thiếu Họ tên người nhà");
                    }

                    // Kiểm tra sức chứa khi thêm mới hoặc chuyển sang phòng khác
                    const movesIntoRoom = room && (!existing || !existing.isActive || existing.roomId !== room.room_id);
                    if (errors.length === 0 && movesIntoRoom && (occupancy[room.room_id] || 0) >= room.capacity) {
                        errors.push(`Phòng ${room.room_code} đã đủ ${room.capacity} người`);
                    }

                    if (errors.length > 0) {
                        invalid.push({ rowNum, name, errors });
                        continue;
                    }

                    if (movesIntoRoom) {
                        occupancy[room.room_id] = (occupancy[room.room_id] || 0) + 1;
                        if (existing && existing.isActive && existing.roomId) occupancy[existing.roomId]--;
                    }

                    valid.push({
                        rowNum,
                        action: existing ? "update" : "create",
                        existing,
                        data: {
                            code, name, age,
                            roomId: room.room_id,
                            gender: gender.value,
                            blood: blood.value,
                            status: status.value,
                            admissionIso: admission.iso,
                            notes: cellText(raw.notes),
                            familyName, familyPhone, familyRel, familyAddress
                        }
                    });
                }

                return { valid, invalid };
            }

            function renderImportErrorTable(rows) {
                return `<div style="max-height: 200px; overflow-y: auto; border: 1px solid #fecdca; border-radius: 8px;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 12.5px;">
                        <thead><tr style="background: #fef3f2; color: #b42318; text-align: left;">
                            <th style="padding: 6px 10px;">Dòng</th><th style="padding: 6px 10px;">Họ tên</th><th style="padding: 6px 10px;">Lỗi</th>
                        </tr></thead>
                        <tbody>${rows.map(r => `<tr style="border-top: 1px solid #fee4e2;">
                            <td style="padding: 6px 10px; white-space: nowrap;">${r.rowNum}</td>
                            <td style="padding: 6px 10px;">${escapeHtml(r.name || "")}</td>
                            <td style="padding: 6px 10px; color: #b42318;">${r.errors.map(escapeHtml).join("<br>")}</td>
                        </tr>`).join("")}</tbody>
                    </table>
                </div>`;
            }

            function showImportMessage(html) {
                importPreview.style.display = "block";
                importPreview.innerHTML = html;
            }

            function showImportFatal(msg) {
                showImportMessage(`<div style="color: #b42318; background: #fef3f2; border-radius: 8px; padding: 10px 12px; font-size: 13px;">${escapeHtml(msg)}</div>`);
            }

            function renderImportPreview(result) {
                const creates = result.valid.filter(r => r.action === "create").length;
                const updates = result.valid.length - creates;
                let html = `<div style="font-size: 13.5px; color: #344054; margin-bottom: 8px;">
                        <b style="color: #027a48;">${result.valid.length}</b> dòng hợp lệ
                        (${creates} thêm mới, ${updates} cập nhật) ·
                        <b style="color: ${result.invalid.length ? "#b42318" : "#344054"};">${result.invalid.length}</b> dòng lỗi
                    </div>`;
                if (result.invalid.length > 0) {
                    html += renderImportErrorTable(result.invalid);
                    if (result.valid.length > 0) {
                        html += `<div style="font-size: 12px; color: #667085; margin-top: 6px;">Các dòng lỗi sẽ được bỏ qua. Sửa file rồi import lại nếu cần.</div>`;
                    }
                }
                showImportMessage(html);
            }

            window.handleExcelSelect = async function(e) {
                const file = e.target.files[0];
                resetImportState();
                if (!file) return;

                const label = document.getElementById("import-file-name");
                label.innerText = `Đã chọn: ${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
                label.style.display = "block";

                if (file.size > 10 * 1024 * 1024) {
                    showImportFatal("File vượt quá 10MB.");
                    return;
                }
                if (typeof XLSX === "undefined") {
                    showImportFatal("Không tải được thư viện Excel. Vui lòng kiểm tra kết nối mạng và thử lại.");
                    return;
                }

                showImportMessage(`<div style="font-size: 13px; color: #667085;">Đang đọc và kiểm tra file...</div>`);
                try {
                    const result = await buildImportPlan(file);
                    if (result.fatal) {
                        showImportFatal(result.fatal);
                        return;
                    }
                    renderImportPreview(result);
                    if (result.valid.length > 0) {
                        importPlan = result.valid;
                        btnSubmitImport.disabled = false;
                        btnSubmitImport.textContent = `Nhập ${importPlan.length} hồ sơ`;
                    }
                } catch (err) {
                    console.error(err);
                    showImportFatal("Không đọc được file: " + err.message);
                }
            };

            // Cập nhật hồ sơ đã có theo Mã hồ sơ — ô trống trong file giữ nguyên giá trị cũ
            async function applyImportUpdate(res, d) {
                const residentPatch = {
                    full_name: d.name,
                    age: d.age,
                    room_id: d.roomId,
                    updated_at: new Date().toISOString()
                };
                if (d.gender) residentPatch.gender = d.gender;
                if (d.blood) residentPatch.blood_type = d.blood;
                if (d.status) residentPatch.status = d.status;
                if (d.admissionIso) residentPatch.admission_date = d.admissionIso;
                if (d.notes) residentPatch.notes = d.notes;

                const { error } = await window.sb.from("residents").update(residentPatch).eq("resident_id", res.residentId);
                if (error) throw error;

                const familyPatch = {};
                if (d.familyName) familyPatch.full_name = d.familyName;
                if (d.familyRel) familyPatch.relationship = d.familyRel;
                if (d.familyPhone) familyPatch.phone = d.familyPhone;
                if (d.familyAddress) familyPatch.address = d.familyAddress;
                if (Object.keys(familyPatch).length === 0) return;

                if (res.familyMemberId) {
                    const { error: famError } = await window.sb.from("family_members").update(familyPatch).eq("family_member_id", res.familyMemberId);
                    if (famError) throw famError;
                } else if (d.familyName) {
                    const { error: famError } = await window.sb.from("family_members").insert(
                        Object.assign({ resident_id: res.residentId, is_primary_contact: true }, familyPatch)
                    );
                    if (famError) throw famError;
                }
            }

            if (btnSubmitImport) {
                btnSubmitImport.addEventListener("click", async function() {
                    if (importPlan.length === 0 || importRunning) return;

                    importRunning = true;
                    btnSubmitImport.disabled = true;
                    btnCancelImport.disabled = true;

                    let created = 0, updated = 0;
                    const failures = [];

                    for (let i = 0; i < importPlan.length; i++) {
                        const row = importPlan[i];
                        btnSubmitImport.textContent = `Đang nhập ${i + 1}/${importPlan.length}...`;
                        try {
                            if (row.action === "update") {
                                await applyImportUpdate(row.existing, row.data);
                                updated++;
                            } else {
                                await createResident(Object.assign({}, row.data, {
                                    code: row.data.code || undefined,
                                    status: row.data.status || "Đang ổn định"
                                }));
                                created++;
                            }
                        } catch (err) {
                            console.error(err);
                            failures.push({ rowNum: row.rowNum, name: row.data.name, errors: [err.message] });
                        }
                    }

                    importRunning = false;
                    importPlan = [];
                    btnCancelImport.disabled = false;
                    btnSubmitImport.textContent = "Nhập dữ liệu";

                    await loadResidents();
                    renderTable();

                    const summary = `Đã nhập ${created + updated} hồ sơ (${created} thêm mới, ${updated} cập nhật)`;
                    if (failures.length === 0) {
                        closeImportModal();
                        showToast(summary);
                    } else {
                        showToast(`${summary}, ${failures.length} dòng lỗi`);
                        showImportMessage(
                            `<div style="font-size: 13.5px; color: #344054; margin-bottom: 8px;">${escapeHtml(summary)}. Các dòng sau không lưu được:</div>` +
                            renderImportErrorTable(failures)
                        );
                    }
                });
            }

            // ==========================================================================
            // SEARCH & FILTER LISTENERS
            // ==========================================================================
            document.querySelectorAll(".resident-pill").forEach(pill => {
                pill.addEventListener("click", function () {
                    document.querySelectorAll(".resident-pill").forEach(p => p.classList.remove("active"));
                    this.classList.add("active");
                    renderTable();
                });
            });

            const searchInp = document.getElementById("residents-search");
            if (searchInp) {
                searchInp.addEventListener("input", renderTable);
            }

            // Initialize
            await loadResidents();
            renderTable();

            // Auto-open detail modal if navigated with residentId/id
            const urlParams = new URLSearchParams(window.location.search);
            const targetResId = urlParams.get('residentId') || urlParams.get('id');
            const targetName = urlParams.get('name');
            if (targetResId || targetName) {
                setTimeout(() => {
                    let target = null;
                    if (targetResId) {
                        target = currentResidents.find(r => r.id === targetResId);
                    }
                    if (!target && targetName) {
                        target = currentResidents.find(r => r.name.toLowerCase().includes(targetName.toLowerCase()));
                    }
                    if (target) {
                        openDetailModal(target.id);
                    }
                }, 200);
            }
        });
    </script>
}
