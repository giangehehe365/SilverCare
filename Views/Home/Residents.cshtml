@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/xlsx@@0.18.5/dist/xlsx.full.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            // Dữ liệu cư dân giờ lấy thật từ Supabase (bảng residents/rooms/family_members).
            // Row Level Security quyết định ai thấy dòng nào — Family chỉ thấy resident liên kết với mình.
            let currentResidents = [];

            function formatDateVN(iso) {
                if (!iso) return "";
                const parts = iso.split("-");
                if (parts.length !== 3) return iso;
                return `${parts[2]}/${parts[1]}/${parts[0]}`;
            }

            function formatVND(n) {
                return (n || 0).toLocaleString("vi-VN") + " đ";
            }

            function escapeHtml(str) {
                const div = document.createElement("div");
                div.innerText = str == null ? "" : String(str);
                return div.innerHTML;
            }

            function mapResidentRow(row) {
                const contacts = row.family_members || [];
                const primary = contacts.find(f => f.is_primary_contact) || contacts[0] || {};
                return {
                    residentId: row.resident_id,
                    id: row.resident_code,
                    initials: computeInitials(row.full_name),
                    name: row.full_name,
                    age: row.age,
                    gender: row.gender,
                    roomId: row.room_id,
                    room: row.rooms ? row.rooms.room_code : "",
                    blood: row.blood_type,
                    status: row.status,
                    isActive: row.is_active !== false,
                    familyMemberId: primary.family_member_id || null,
                    familyProfileId: primary.profile_id || null,
                    familyName: primary.full_name,
                    familyPhone: primary.phone,
                    familyRel: primary.relationship,
                    familyAddress: primary.address,
                    admissionDate: formatDateVN(row.admission_date),
                    admissionDateIso: row.admission_date,
                    notes: row.notes
                };
            }

            // Sync resident status with health vitals from Health tracking
            // Mapping: Bình thường --> Đang ổn định, Trung bình --> Trung bình, Cao --> Cần theo dõi
            function getUpdatedStatusFromHealth(resId, defaultStatus) {
                const now = new Date();
                const todayKey = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
                
                let update = null;
                try {
                    const rawV4 = localStorage.getItem("silvercare_health_records_v4");
                    if (rawV4) {
                        const records = JSON.parse(rawV4);
                        if (records[resId]?.[todayKey]) {
                            update = records[resId][todayKey];
                        }
                    }
                } catch(e) {}

                if (!update) {
                    const rawHealth = localStorage.getItem("silvercare_health_today_updates_v3") || localStorage.getItem("silvercare_health_today_updates_v2");
                    if (rawHealth) {
                        try {
                            const healthData = JSON.parse(rawHealth);
                            const rowId = resId === "NCT001" ? "row-1" : (resId === "NCT002" ? "row-2" : (resId === "NCT003" ? "row-3" : ""));
                            update = healthData[resId] || (rowId ? healthData[rowId] : null);
                        } catch (e) {}
                    }
                }

                if (update && typeof update.sys === "number") {
                    const bpDiff = update.sys - update.dia;
                    if (update.sys >= 140 || update.dia >= 90 || bpDiff <= 20 || update.hr > 100 || update.hr < 50 || update.temp >= 38.5 || update.temp < 35.0) {
                        return "Cần theo dõi"; // Cao
                    }
                    if ((update.sys >= 120 && update.sys <= 139) || (update.dia >= 80 && update.dia <= 89) || (update.hr >= 91 && update.hr <= 100) || (update.hr >= 50 && update.hr <= 59) || (update.temp >= 37.5 && update.temp <= 38.4)) {
                        return "Trung bình"; // Trung bình
                    }
                    return "Đang ổn định"; // Bình thường
                }
                return defaultStatus;
            }

            // Tải danh sách cư dân thật từ Supabase (kèm phòng + người liên hệ chính)
            async function loadResidents() {
                const { data, error } = await window.sb
                    .from("residents")
                    .select(
                        "resident_id, resident_code, full_name, age, gender, blood_type, status, admission_date, notes, room_id, is_active, rooms(room_code, room_name), family_members(family_member_id, profile_id, full_name, relationship, phone, address, is_primary_contact)"
                    )
                    .order("resident_id");

                if (error) {
                    console.error(error);
                    showToast("Không tải được danh sách cư dân: " + error.message);
                    currentResidents = [];
                    return;
                }

                currentResidents = (data || []).map(mapResidentRow);

                // Trạng thái hiển thị có thể bị ghi đè tạm thời bởi chỉ số sức khỏe
                // trong localStorage cho tới khi module Sức khỏe được chuyển sang Supabase.
                currentResidents.forEach(res => {
                    res.status = getUpdatedStatusFromHealth(res.id, res.status);
                });

                try {
                    localStorage.setItem("silvercare_elderly_profiles_v3", JSON.stringify(currentResidents));
                } catch (e) {}
            }

            // Danh sách phòng còn chỗ trống, dùng cho dropdown ở modal Thêm hồ sơ
            async function loadAvailableRooms() {
                const { data: rooms, error: roomsError } = await window.sb
                    .from("rooms")
                    .select("room_id, room_code, room_name, capacity")
                    .eq("is_active", true)
                    .order("room_code");

                if (roomsError) {
                    console.error(roomsError);
                    return [];
                }

                const { data: occupants, error: occError } = await window.sb
                    .from("residents")
                    .select("room_id")
                    .eq("is_active", true);

                if (occError) console.error(occError);

                const occupancy = {};
                (occupants || []).forEach(r => {
                    if (r.room_id) occupancy[r.room_id] = (occupancy[r.room_id] || 0) + 1;
                });

                return (rooms || []).filter(r => (occupancy[r.room_id] || 0) < r.capacity);
            }

            // Danh sách phòng dùng khi SỬA hồ sơ — phải bao gồm cả phòng hiện tại
            // của cư dân đó (dù phòng đã đầy), chỉ loại các phòng đầy KHÁC.
            async function loadRoomsForEdit(residentId, currentRoomId) {
                const { data: rooms, error: roomsError } = await window.sb
                    .from("rooms")
                    .select("room_id, room_code, room_name, capacity")
                    .eq("is_active", true)
                    .order("room_code");

                if (roomsError) {
                    console.error(roomsError);
                    return [];
                }

                const { data: occupants, error: occError } = await window.sb
                    .from("residents")
                    .select("resident_id, room_id")
                    .eq("is_active", true);

                if (occError) console.error(occError);

                const occupancy = {};
                (occupants || []).forEach(r => {
                    if (r.room_id && r.resident_id !== residentId) {
                        occupancy[r.room_id] = (occupancy[r.room_id] || 0) + 1;
                    }
                });

                return (rooms || []).filter(r => r.room_id === currentRoomId || (occupancy[r.room_id] || 0) < r.capacity);
            }

            // Danh sách tài khoản có vai trò "Người nhà" — dùng cho dropdown liên hệ
            let familyProfilesCache = [];
            async function loadFamilyProfiles() {
                const { data, error } = await window.sb
                    .from("profiles")
                    .select("id, full_name, email, phone")
                    .eq("role", "family")
                    .eq("is_active", true)
                    .order("full_name");

                if (error) {
                    console.error(error);
                    familyProfilesCache = [];
                    return familyProfilesCache;
                }
                familyProfilesCache = data || [];
                return familyProfilesCache;
            }

            // Danh sách gói dịch vụ đang mở bán — dùng cho dropdown gán gói ở
            // phần chi tiết hồ sơ (đồng bộ với "Thanh toán & viện phí").
            let servicePackagesCache = [];
            async function loadServicePackages() {
                const { data, error } = await window.sb
                    .from("service_packages")
                    .select("service_package_id, name, monthly_price, is_active")
                    .eq("is_active", true)
                    .order("monthly_price");

                if (error) {
                    console.error(error);
                    servicePackagesCache = [];
                    return servicePackagesCache;
                }
                servicePackagesCache = data || [];
                return servicePackagesCache;
            }

            // Dùng chung cho dropdown "Gói dịch vụ" ở form Tạo mới / Chỉnh sửa
            function populatePackageSelect(selectEl, selectedId) {
                if (!selectEl) return;
                selectEl.innerHTML = `<option value="">-- Không gán gói --</option>` + servicePackagesCache.map(p =>
                    `<option value="${p.service_package_id}"${String(p.service_package_id) === String(selectedId) ? " selected" : ""}>${escapeHtml(p.name)} (${formatVND(p.monthly_price)}/tháng)</option>`
                ).join("");
            }

            // Hiển thị gói dịch vụ đang áp dụng (end_date null, mới nhất theo start_date)
            async function loadCurrentPackageForResident(residentId) {
                const infoEl = document.getElementById("detail-package-info");
                if (!infoEl) return;
                infoEl.innerText = "Đang tải...";

                const { data, error } = await window.sb
                    .from("resident_service_packages")
                    .select("start_date, service_packages(name, monthly_price)")
                    .eq("resident_id", residentId)
                    .is("end_date", null)
                    .order("start_date", { ascending: false })
                    .limit(1);

                if (error || !data || data.length === 0) {
                    infoEl.innerText = "Chưa gán gói dịch vụ nào.";
                    return;
                }
                const pkg = data[0];
                infoEl.innerText = `Đang áp dụng: ${pkg.service_packages.name} (${formatVND(pkg.service_packages.monthly_price)}/tháng) — từ ${formatDateVN(pkg.start_date)}`;
            }

            async function assignPackageToResident(residentId, packageId, startDate) {
                const { error } = await window.sb.from("resident_service_packages").insert({
                    resident_id: residentId,
                    service_package_id: parseInt(packageId, 10),
                    start_date: startDate
                });
                if (error) { alert("Không thể gán gói: " + error.message); return false; }
                return true;
            }

            // Tạo hồ sơ cư dân mới + người liên hệ chính (2 lệnh ghi, cùng một giao dịch nghiệp vụ)
            async function createResident(payload) {
                const { data: resident, error } = await window.sb
                    .from("residents")
                    .insert({
                        resident_code: payload.code,
                        full_name: payload.name,
                        age: payload.age,
                        gender: payload.gender,
                        room_id: payload.roomId,
                        blood_type: payload.blood,
                        status: payload.status,
                        admission_date: payload.admissionIso || null,
                        notes: payload.notes || null
                    })
                    .select("resident_id, resident_code")
                    .single();

                if (error) throw error;

                // Người liên hệ không bắt buộc (import Excel có thể bỏ trống)
                if (payload.familyName) {
                    const { error: famError } = await window.sb.from("family_members").insert({
                        resident_id: resident.resident_id,
                        full_name: payload.familyName,
                        relationship: payload.familyRel || null,
                        phone: payload.familyPhone || null,
                        address: payload.familyAddress || null,
                        is_primary_contact: true
                    });

                    if (famError) throw famError;
                }

                if (payload.packageId) {
                    const { error: pkgError } = await window.sb.from("resident_service_packages").insert({
                        resident_id: resident.resident_id,
                        service_package_id: parseInt(payload.packageId, 10),
                        start_date: new Date().toISOString().slice(0, 10)
                    });
                    if (pkgError) throw pkgError;
                }

                return resident;
            }

            // Gói dịch vụ đang áp dụng (end_date null, mới nhất) — dùng để so
            // sánh khi Lưu thay đổi ở form Chỉnh sửa, và để hiển thị ở form Chi tiết.
            async function getCurrentActivePackage(residentId) {
                const { data, error } = await window.sb
                    .from("resident_service_packages")
                    .select("resident_service_package_id, service_package_id, start_date, service_packages(name, monthly_price)")
                    .eq("resident_id", residentId)
                    .is("end_date", null)
                    .order("start_date", { ascending: false })
                    .limit(1);
                if (error || !data || data.length === 0) return null;
                return data[0];
            }

            // Chỉ tạo dòng resident_service_packages MỚI khi gói thực sự thay đổi
            // (tránh mỗi lần bấm "Lưu thay đổi" lại đẻ thêm 1 dòng trùng gói cũ).
            async function updateResidentPackage(residentId, newPackageId, currentPackage) {
                const currentId = currentPackage ? String(currentPackage.service_package_id) : "";
                const newId = newPackageId ? String(newPackageId) : "";
                if (currentId === newId) return;

                const today = new Date().toISOString().slice(0, 10);

                if (currentPackage) {
                    const { error } = await window.sb
                        .from("resident_service_packages")
                        .update({ end_date: today })
                        .eq("resident_service_package_id", currentPackage.resident_service_package_id);
                    if (error) throw error;
                }

                if (newId) {
                    const { error } = await window.sb.from("resident_service_packages").insert({
                        resident_id: residentId,
                        service_package_id: parseInt(newId, 10),
                        start_date: today
                    });
                    if (error) throw error;
                }
            }

            // Cập nhật hồ sơ cư dân + người liên hệ chính (update nếu đã có dòng
            // family_members, insert nếu hồ sơ cũ chưa có người liên hệ nào)
            async function updateResident(residentId, familyMemberId, payload, currentPackage) {
                const { error } = await window.sb
                    .from("residents")
                    .update({
                        full_name: payload.name,
                        age: payload.age,
                        gender: payload.gender,
                        room_id: payload.roomId,
                        blood_type: payload.blood,
                        status: payload.status,
                        admission_date: payload.admissionIso || null,
                        notes: payload.notes || null,
                        updated_at: new Date().toISOString()
                    })
                    .eq("resident_id", residentId);

                if (error) throw error;

                // Tài khoản người nhà không bắt buộc: bỏ chọn = gỡ liên kết tài khoản
                // (giữ nguyên tên người liên hệ cũ); hồ sơ chưa có người liên hệ và
                // không chọn tài khoản thì không tạo dòng family_members.
                const familyProfile = familyProfilesCache.find(p => p.id === payload.familyProfileId);
                const familyPayload = {
                    resident_id: residentId,
                    profile_id: familyProfile ? familyProfile.id : null,
                    relationship: payload.familyRel,
                    phone: payload.familyPhone || (familyProfile ? familyProfile.phone : null),
                    address: payload.familyAddress || null,
                    is_primary_contact: true
                };
                if (familyProfile) {
                    familyPayload.full_name = familyProfile.full_name;
                    familyPayload.email = familyProfile.email;
                }

                if (familyMemberId) {
                    const { error: famError } = await window.sb
                        .from("family_members")
                        .update(familyPayload)
                        .eq("family_member_id", familyMemberId);
                    if (famError) throw famError;
                } else if (familyProfile) {
                    const { error: famError } = await window.sb.from("family_members").insert(familyPayload);
                    if (famError) throw famError;
                }

                await updateResidentPackage(residentId, payload.packageId, currentPackage);
            }

            // Helper to get initials
            function computeInitials(name) {
                if (!name) return "NCT";
                const parts = name.trim().split(" ");
                if (parts.length >= 3) {
                    return `${parts[0][0]}${parts[parts.length - 2][0]}${parts[parts.length - 1][0]}`.toUpperCase();
                } else if (parts.length === 2) {
                    return `${parts[0][0]}${parts[1][0]}`.toUpperCase();
                }
                return name.substring(0, 2).toUpperCase();
            }

            // Helper for status badge
            function getStatusBadgeHtml(res) {
                if (!res.isActive) {
                    return `<span class="status-pill" style="background:#f2f4f7; color:#667085;">Ngừng hoạt động</span>`;
                }
                const status = res.status;
                if (status === "Đang ổn định") {
                    return `<span class="status-pill status-pill-stable">Đang ổn định</span>`;
                } else if (status === "Cần theo dõi") {
                    return `<span class="status-pill status-pill-monitoring">Cần theo dõi</span>`;
                } else if (status === "Trung bình") {
                    return `<span class="status-pill status-pill-medium">Trung bình</span>`;
                }
                return `<span class="status-pill" style="background:#f2f4f7; color:#344054;">${status}</span>`;
            }

            // Hồ sơ khớp bộ lọc + ô tìm kiếm hiện tại (dùng cho bảng và Export Excel)
            function getVisibleResidents() {
                const activePill = document.querySelector(".resident-pill.active");
                const selectedFilter = activePill ? activePill.getAttribute("data-filter") : "all";
                const searchVal = document.getElementById("residents-search").value.toLowerCase().trim();

                return currentResidents.filter(res => {
                    // Mọi pill trạng thái sức khỏe chỉ áp dụng cho hồ sơ đang hoạt động;
                    // pill "Ngừng hoạt động" tách riêng.
                    const matchesFilter = selectedFilter === "__inactive__"
                        ? !res.isActive
                        : (res.isActive && (selectedFilter === "all" || res.status === selectedFilter));

                    const textToSearch = `${res.id} ${res.name} ${res.room} ${res.familyName || ""} ${res.familyPhone || ""}`.toLowerCase();
                    return matchesFilter && textToSearch.includes(searchVal);
                });
            }

            // Render Table Rows
            function renderTable() {
                const tbody = document.getElementById("residents-table-body");
                const emptyState = document.getElementById("residents-empty-state");
                if (!tbody) return;

                tbody.innerHTML = "";

                const visibleResidents = getVisibleResidents();
                const visibleCount = visibleResidents.length;

                visibleResidents.forEach(res => {
                    const tr = document.createElement("tr");
                    if (!res.isActive) tr.style.opacity = "0.65";
                    const contactText = res.familyName
                        ? `${res.familyName}${res.familyPhone ? " - " + res.familyPhone : ""}`
                        : "Chưa có";
                    tr.innerHTML = `
                        <td class="cell-id">${res.id}</td>
                        <td>
                            <div class="profile-cell">
                                <div class="profile-avatar">${res.initials || computeInitials(res.name)}</div>
                                <span class="profile-name">${res.name}</span>
                            </div>
                        </td>
                        <td class="cell-age">${res.age}</td>
                        <td class="cell-gender">${res.gender}</td>
                        <td class="cell-room">${res.room}</td>
                        <td class="cell-blood">${res.blood}</td>
                        <td>${getStatusBadgeHtml(res)}</td>
                        <td class="cell-contact" title="${contactText}">${contactText}</td>
                        <td style="text-align: right; white-space: nowrap;">
                            <a href="#" class="btn-view-detail" data-id="${res.id}">
                                <svg viewBox="0 0 24 24">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <span>Xem chi tiết</span>
                            </a>
                            <a href="#" class="btn-view-detail btn-edit-resident" data-id="${res.id}" data-roles="admin,manager,staff" style="margin-left: 12px;">
                                <svg viewBox="0 0 24 24">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                                <span>Sửa</span>
                            </a>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });

                if (visibleCount === 0) {
                    emptyState.style.display = "block";
                } else {
                    emptyState.style.display = "none";
                }

                // Bind detail view triggers
                document.querySelectorAll(".btn-view-detail:not(.btn-edit-resident)").forEach(btn => {
                    btn.addEventListener("click", function (e) {
                        e.preventDefault();
                        const id = this.getAttribute("data-id");
                        openDetailModal(id);
                    });
                });

                // Bind edit triggers
                document.querySelectorAll(".btn-edit-resident").forEach(btn => {
                    btn.addEventListener("click", function (e) {
                        e.preventDefault();
                        const id = this.getAttribute("data-id");
                        openEditModal(id);
                    });
                });

                if (window.currentUser) applyDataRolesWithin(tbody, window.currentUser.role);
            }

            function applyDataRolesWithin(container, role) {
                container.querySelectorAll("[data-roles]").forEach(el => {
                    const allowed = el.getAttribute("data-roles").split(",").map(r => r.trim());
                    el.style.display = allowed.indexOf(role) === -1 ? "none" : "";
                });
            }

            // Toast helper
            function showToast(msg) {
                const toast = document.getElementById("toast-notify");
                const text = document.getElementById("toast-text");
                if (toast && text) {
                    text.innerText = msg;
                    toast.classList.add("show");
                    setTimeout(() => toast.classList.remove("show"), 3000);
                }
            }

            // Default care tasks baseline
            const defaultCareTasks = [
                { id: "task-1", name: "Uống thuốc sáng", time: "08:00", patientName: "Nguyễn Văn An", patientRoom: "201", status: "todo", type: "Chăm sóc", note: "Uống thuốc sau khi ăn no" },
                { id: "task-2", name: "Vật lý trị liệu", time: "10:00", patientName: "Lê Văn Bình", patientRoom: "102", status: "pending", type: "Y tế", note: "Tập phục hồi chức năng khớp gối" },
                { id: "task-3", name: "Đo huyết áp & khám định kỳ", time: "14:00", patientName: "Phạm Thị Cúc", patientRoom: "305", status: "todo", type: "Y tế", note: "Kiểm tra huyết áp và chỉ số sức khỏe chiều" },
                { id: "task-4", name: "Chăm sóc cá nhân", time: "16:00", patientName: "Nguyễn Văn An", patientRoom: "201", status: "todo", type: "Chăm sóc", note: "Hỗ trợ vận động nhẹ ngoài sân vườn" },
                { id: "task-5", name: "Uống thuốc tối", time: "20:00", patientName: "Lê Văn Bình", patientRoom: "102", status: "done", type: "Chăm sóc", note: "Uống thuốc theo đơn bác sĩ trước khi ngủ" }
            ];

            // ==========================================================================
            // DETAIL MODAL LOGIC
            // ==========================================================================
            const detailModal = document.getElementById("detail-resident-modal");
            const btnCloseDetail = document.getElementById("btn-close-detail-modal");
            const btnCloseDetailFooter = document.getElementById("btn-close-detail-footer");
            let activeDetailResident = null;

            async function openDetailModal(id) {
                const res = currentResidents.find(r => r.id === id);
                if (!res) return;
                activeDetailResident = res;

                // Update Sức khỏe button link directly to this resident's health chart
                const btnHealth = document.getElementById("btn-detail-health");
                if (btnHealth) {
                    btnHealth.href = `@Url.Action("Health", "Home")?residentId=${encodeURIComponent(res.id)}#chart-section`;
                }

                document.getElementById("detail-avatar").innerText = res.initials || computeInitials(res.name);
                document.getElementById("detail-fullname").innerText = res.name;
                document.getElementById("detail-id").innerText = res.id;
                document.getElementById("detail-room").innerText = `Phòng ${res.room}`;
                
                const statusEl = document.getElementById("detail-status");
                if (!res.isActive) {
                    statusEl.innerText = "Ngừng hoạt động";
                    statusEl.className = "status-pill";
                    statusEl.style.background = "#f2f4f7";
                    statusEl.style.color = "#667085";
                } else {
                    statusEl.innerText = res.status;
                    statusEl.className = "status-pill " + (res.status === "Đang ổn định" ? "status-pill-stable" : (res.status === "Cần theo dõi" ? "status-pill-monitoring" : "status-pill-medium"));
                    statusEl.style.background = "";
                    statusEl.style.color = "";
                }

                const btnToggleActive = document.getElementById("btn-detail-toggle-active");
                if (btnToggleActive) {
                    btnToggleActive.innerText = res.isActive ? "⏻ Ngừng hoạt động" : "⏻ Kích hoạt lại";
                    btnToggleActive.style.color = res.isActive ? "#d92d20" : "#027a48";
                }

                document.getElementById("detail-age").innerText = res.age;
                document.getElementById("detail-gender").innerText = res.gender;
                document.getElementById("detail-blood").innerText = res.blood;
                document.getElementById("detail-admission").innerText = res.admissionDate || "15/05/2024";

                document.getElementById("detail-family-name").innerText = res.familyName || "Chưa có";
                document.getElementById("detail-family-rel").innerText = res.familyRel || "Người thân";
                document.getElementById("detail-family-phone").innerText = res.familyPhone || "Chưa có";
                document.getElementById("detail-family-address").innerText = res.familyAddress || "123 Nguyễn Trãi, Quận 1, TP. HCM";

                document.getElementById("detail-notes").innerText = res.notes || "Chưa có ghi chú đặc biệt.";

                loadCurrentPackageForResident(res.residentId);

                detailModal.classList.add("active");
            }

            function closeDetailModal() {
                detailModal.classList.remove("active");
            }

            if (btnCloseDetail) btnCloseDetail.addEventListener("click", closeDetailModal);
            if (btnCloseDetailFooter) btnCloseDetailFooter.addEventListener("click", closeDetailModal);
            if (detailModal) {
                detailModal.addEventListener("click", function(e) {
                    if (e.target === detailModal) closeDetailModal();
                });
            }

            const btnDetailEdit = document.getElementById("btn-detail-edit");
            if (btnDetailEdit) {
                btnDetailEdit.addEventListener("click", function () {
                    if (!activeDetailResident) return;
                    closeDetailModal();
                    openEditModal(activeDetailResident.id);
                });
            }

            const btnDetailToggleActive = document.getElementById("btn-detail-toggle-active");
            if (btnDetailToggleActive) {
                btnDetailToggleActive.addEventListener("click", async function () {
                    if (!activeDetailResident) return;
                    const res = activeDetailResident;
                    const willActivate = !res.isActive;
                    const confirmMsg = willActivate
                        ? `Kích hoạt lại hồ sơ của ${res.name}?`
                        : `Ngừng hoạt động hồ sơ của ${res.name}? Cư dân sẽ không còn xuất hiện trong danh sách hoạt động (vẫn xem được qua bộ lọc "Ngừng hoạt động").`;

                    if (!confirm(confirmMsg)) return;

                    const { error } = await window.sb
                        .from("residents")
                        .update({ is_active: willActivate, updated_at: new Date().toISOString() })
                        .eq("resident_id", res.residentId);

                    if (error) {
                        alert("Không thể cập nhật trạng thái: " + error.message);
                        return;
                    }

                    closeDetailModal();
                    await loadResidents();
                    renderTable();
                    showToast(willActivate ? `Đã kích hoạt lại hồ sơ: ${res.name}` : `Đã ngừng hoạt động hồ sơ: ${res.name}`);
                });
            }


            // ==========================================================================
            // CARE SCHEDULE POPUP MODAL LOGIC
            // ==========================================================================
            const careScheduleModal = document.getElementById("resident-care-schedule-modal");
            const btnOpenCareSchedule = document.getElementById("btn-detail-schedule");
            const btnCloseCareSchedule = document.getElementById("btn-close-care-schedule-modal");
            const btnCloseCareScheduleFooter = document.getElementById("btn-close-care-schedule-footer");
            const careScheduleList = document.getElementById("care-schedule-list");
            const careScheduleResidentName = document.getElementById("care-schedule-resident-name");
            const careScheduleResidentMeta = document.getElementById("care-schedule-resident-meta");
            const btnCareScheduleViewFull = document.getElementById("btn-care-schedule-view-full");

            function openCareScheduleModal(res) {
                if (!res) return;

                if (careScheduleResidentName) careScheduleResidentName.innerText = res.name;
                if (careScheduleResidentMeta) careScheduleResidentMeta.innerHTML = `Mã: ${res.id} &middot; Phòng ${res.room}`;
                if (btnCareScheduleViewFull) {
                    const cleanRoom = res.room ? res.room.replace(/\D/g, '') : '';
                    btnCareScheduleViewFull.href = `@Url.Action("Schedule", "Home")?room=${encodeURIComponent(cleanRoom)}&name=${encodeURIComponent(res.name)}`;
                }

                // Get tasks from localStorage or default
                let allTasks = [];
                const savedTasks = localStorage.getItem("silvercare_schedules_v2");
                if (savedTasks) {
                    try {
                        allTasks = JSON.parse(savedTasks);
                    } catch (e) {
                        allTasks = [...defaultCareTasks];
                    }
                } else {
                    allTasks = [...defaultCareTasks];
                }

                // Filter tasks matching this resident
                const resNameNorm = res.name.toLowerCase().trim();
                const resRoomNorm = res.room ? res.room.replace(/\D/g, '').trim() : '';

                const matchedTasks = allTasks.filter(t => {
                    const tName = (t.patientName || "").toLowerCase().trim();
                    const tRoom = (t.patientRoom || "").replace(/\D/g, '').trim();

                    if (tName === resNameNorm) return true;
                    if (tName && resNameNorm && (tName.includes(resNameNorm) || resNameNorm.includes(tName))) return true;
                    if (resRoomNorm && tRoom && resRoomNorm === tRoom && tName.includes(resNameNorm.split(' ').pop())) return true;
                    return false;
                });

                if (matchedTasks.length > 0) {
                    // Sort by time
                    matchedTasks.sort((a, b) => (a.time || "").localeCompare(b.time || ""));

                    careScheduleList.innerHTML = matchedTasks.map(task => {
                        const isDone = task.status === "done";
                        const isPending = task.status === "pending";
                        const badgeClass = isDone ? "badge-done" : (isPending ? "badge-pending" : "badge-todo");
