@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Quản lý thuốc";
    ViewData["AllowedRoles"] = "admin,manager,staff,family";
}

<style>
    /* Medicine Management View Styling */
    .medicine-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .medicine-title {
        font-size: 22px;
        font-weight: 700;
        color: #101828;
        margin: 0;
        letter-spacing: -0.02em;
    }

    .btn-add-medicine {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background-color: #0ba5ec;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        padding: 10px 18px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05);
    }

    .btn-add-medicine:hover {
        background-color: #0284c7;
        box-shadow: 0 4px 12px rgba(11, 165, 236, 0.25);
    }

    .btn-add-medicine svg {
        width: 18px;
        height: 18px;
        stroke: #ffffff;
        stroke-width: 2.2;
    }

    /* Medicine Table Card */
    .medicine-table-card {
        background-color: #ffffff;
        border-radius: 16px;
        border: 1px solid #eaecf0;
        box-shadow: 0 1px 3px rgba(16, 24, 40, 0.04);
        overflow: hidden;
    }

    .medicine-table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .medicine-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    .medicine-table th {
        background-color: #ffffff;
        color: #667085;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 16px 20px;
        border-bottom: 1px solid #eaecf0;
        white-space: nowrap;
    }

    .medicine-table td {
        padding: 18px 20px;
        font-size: 14px;
        color: #344054;
        border-bottom: 1px solid #f2f4f7;
        vertical-align: middle;
        white-space: nowrap;
    }

    .medicine-table tr:last-child td {
        border-bottom: none;
    }

    .medicine-table tbody tr {
        transition: background-color 0.15s ease;
    }

    .medicine-table tbody tr:hover {
        background-color: #f8fafd;
    }

    /* Medicine Name Cell */
    .med-name-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .med-pill-icon {
        width: 32px;
        height: 32px;
        background-color: #f0f9ff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .med-pill-icon svg {
        width: 16px;
        height: 16px;
        stroke: #0ba5ec;
        stroke-width: 2;
        fill: none;
    }

    .med-name-text {
        font-weight: 600;
        color: #101828;
    }

    .med-resident-name {
        font-weight: 500;
        color: #101828;
    }

    /* Status Badges */
    .med-badge {
        display: inline-flex;
        align-items: center;
        padding: 3px 10px;
        border-radius: 16px;
        font-size: 12.5px;
        font-weight: 500;
    }

    .med-badge-active {
        background-color: #ecfdf3;
        color: #027a48;
    }

    .med-badge-paused {
        background-color: #fef0c7;
        color: #b54708;
    }

    .med-badge-stopped {
        background-color: #f2f4f7;
        color: #475467;
    }

    .med-notes {
        color: #667085;
        font-size: 13.5px;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Action Buttons */
    .med-actions-cell {
        display: flex;
        align-items: center;
        gap: 8px;
        justify-content: flex-end;
    }

    .btn-action-icon {
        background: none;
        border: none;
        cursor: pointer;
        padding: 6px;
        border-radius: 6px;
        color: #98a2b3;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
    }

    .btn-action-icon svg {
        width: 18px;
        height: 18px;
        stroke: currentColor;
        stroke-width: 1.8;
        fill: none;
    }

    .btn-action-edit:hover {
        background-color: #f0f9ff;
        color: #0ba5ec;
    }

    .btn-action-delete:hover {
        background-color: #fef3f2;
        color: #f04438;
    }

    /* Modals */
    .custom-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(16, 24, 40, 0.45);
        backdrop-filter: blur(4px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        animation: modalFadeIn 0.2s ease-out;
    }

    .custom-modal-overlay.show {
        display: flex;
    }

    @@keyframes modalFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .custom-modal-card {
        background-color: #ffffff;
        border-radius: 16px;
        width: 100%;
        max-width: 520px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        overflow: hidden;
        animation: modalSlideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes modalSlideUp {
        from { transform: translateY(16px) scale(0.97); }
        to { transform: translateY(0) scale(1); }
    }

    .custom-modal-header {
        padding: 20px 24px;
        border-bottom: 1px solid #eaecf0;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .custom-modal-title {
        font-size: 17px;
        font-weight: 700;
        color: #101828;
        margin: 0;
    }

    .btn-close-modal {
        background: none;
        border: none;
        cursor: pointer;
        color: #98a2b3;
        padding: 4px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-close-modal:hover {
        background-color: #f2f4f7;
        color: #101828;
    }

    .custom-modal-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        max-height: 70vh;
        overflow-y: auto;
    }

    .modal-form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .modal-form-label {
        font-size: 13.5px;
        font-weight: 500;
        color: #344054;
    }

    .modal-form-input, .modal-form-select {
        width: 100%;
        height: 42px;
        padding: 0 14px;
        background-color: #ffffff;
        border: 1px solid #d0d5dd;
        border-radius: 10px;
        font-size: 14px;
        color: #101828;
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s;
    }

    .modal-form-input:focus, .modal-form-select:focus {
        border-color: #0ba5ec;
        box-shadow: 0 0 0 3px rgba(11, 165, 236, 0.12);
    }

    .custom-modal-footer {
        padding: 16px 24px;
        border-top: 1px solid #eaecf0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        background-color: #f9fafb;
    }

    .btn-modal-cancel {
        background-color: #ffffff;
        border: 1px solid #d0d5dd;
        color: #344054;
        font-size: 14px;
        font-weight: 600;
        padding: 9px 18px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .btn-modal-cancel:hover {
        background-color: #f2f4f7;
    }

    .btn-modal-submit {
        background-color: #0ba5ec;
        border: 1px solid #0ba5ec;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        padding: 9px 20px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .btn-modal-submit:hover {
        background-color: #0284c7;
    }

    .btn-modal-danger {
        background-color: #f04438;
        border: 1px solid #f04438;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        padding: 9px 20px;
        border-radius: 8px;
        cursor: pointer;
    }

    .btn-modal-danger:hover {
        background-color: #d92d20;
    }

    /* Empty state */
    .med-empty-state {
        text-align: center;
        padding: 48px 24px;
        color: #667085;
    }

    .med-empty-state svg {
        width: 48px;
        height: 48px;
        stroke: #98a2b3;
        margin-bottom: 12px;
    }
</style>

<div class="medicine-header">
    <h1 class="medicine-title">Quản lý thuốc</h1>
    <button type="button" class="btn-add-medicine" data-roles="admin,manager,staff" onclick="openAddMedicineModal()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>Thêm thuốc</span>
    </button>
</div>

<!-- Medicine Table Card -->
<div class="medicine-table-card">
    <div class="medicine-table-responsive">
        <table class="medicine-table" id="medicineTable">
            <thead>
                <tr>
                    <th>TÊN THUỐC</th>
                    <th>LIỀU LƯỢNG</th>
                    <th>NGƯỜI DÙNG</th>
                    <th>GIỜ UỐNG</th>
                    <th>TẦN SUẤT</th>
                    <th>TRẠNG THÁI</th>
                    <th>GHI CHÚ</th>
                    <th style="text-align: right; width: 80px;" data-roles="admin,manager,staff"></th>
                </tr>
            </thead>
            <tbody id="medicineTableBody">
                <!-- Rows injected dynamically via JavaScript -->
            </tbody>
        </table>
    </div>
</div>

<!-- MAR — Sổ cấp phát hôm nay -->
<div class="medicine-header" style="margin-top: 32px;">
    <h1 class="medicine-title" style="font-size: 18px;">Sổ cấp phát hôm nay (MAR)</h1>
</div>
<div class="medicine-table-card" data-roles="admin,manager,staff">
    <div class="medicine-table-responsive">
        <table class="medicine-table" id="marTable">
            <thead>
                <tr>
                    <th>GIỜ UỐNG</th>
                    <th>NGƯỜI DÙNG</th>
                    <th>THUỐC / LIỀU</th>
                    <th>TRẠNG THÁI</th>
                    <th>THỰC HIỆN LÚC</th>
                    <th style="text-align: right; width: 140px;"></th>
                </tr>
            </thead>
            <tbody id="marTableBody"></tbody>
        </table>
    </div>
</div>

<!-- 1. Modal Thêm thuốc mới -->
<div class="custom-modal-overlay" id="addMedicineModal">
    <div class="custom-modal-card">
        <div class="custom-modal-header">
            <h2 class="custom-modal-title">Thêm thuốc mới</h2>
            <button type="button" class="btn-close-modal" onclick="closeModal('addMedicineModal')">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <form id="addMedicineForm" onsubmit="handleAddMedicine(event)">
            <div class="custom-modal-body">
                <div class="modal-form-group">
                    <label class="modal-form-label" for="addMedName">Tên thuốc</label>
                    <input type="text" id="addMedName" class="modal-form-input" placeholder="VD: Amlodipine 5mg" required />
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label" for="addDosage">Liều lượng</label>
                    <input type="text" id="addDosage" class="modal-form-input" placeholder="VD: 1 viên, 2 viên, 5ml" required />
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label" for="addResidentName">Người dùng (Người cao tuổi)</label>
                    <select id="addResidentName" class="modal-form-select" required></select>
                </div>
                <div class="modal-form-group" id="addAllergyWarning" style="display:none; background:#fef3f2; border:1px solid #fecdca; border-radius:8px; padding:10px 14px; color:#b42318; font-size:13px;"></div>
                <div class="modal-form-group">
                    <label class="modal-form-label" for="addScheduleTime">Giờ uống</label>
                    <input type="time" id="addScheduleTime" class="modal-form-input" required />
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label" for="addFrequency">Tần suất</label>
                    <input type="text" id="addFrequency" class="modal-form-input" placeholder="VD: 1 lần/ngày, 2 lần/ngày" required />
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label" for="addStatus">Trạng thái</label>
                    <select id="addStatus" class="modal-form-select">
                        <option value="Đang dùng">Đang dùng</option>
                        <option value="Tạm dừng">Tạm dừng</option>
                        <option value="Đã ngưng">Đã ngưng</option>
                    </select>
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label" for="addNotes">Ghi chú</label>
                    <input type="text" id="addNotes" class="modal-form-input" placeholder="VD: Uống sau bữa ăn" />
                </div>
            </div>
            <div class="custom-modal-footer">
                <button type="button" class="btn-modal-cancel" onclick="closeModal('addMedicineModal')">Hủy</button>
                <button type="submit" class="btn-modal-submit">Thêm thuốc</button>
            </div>
        </form>
    </div>
</div>

<!-- 2. Modal Chỉnh sửa thuốc -->
<div class="custom-modal-overlay" id="editMedicineModal">
    <div class="custom-modal-card">
        <div class="custom-modal-header">
            <h2 class="custom-modal-title">Chỉnh sửa thông tin thuốc</h2>
            <button type="button" class="btn-close-modal" onclick="closeModal('editMedicineModal')">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <form id="editMedicineForm" onsubmit="handleSaveEditMedicine(event)">
            <input type="hidden" id="editMedId" />
            <div class="custom-modal-body">
                <div class="modal-form-group">
                    <label class="modal-form-label" for="editMedName">Tên thuốc</label>
                    <input type="text" id="editMedName" class="modal-form-input" required />
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label" for="editDosage">Liều lượng</label>
                    <input type="text" id="editDosage" class="modal-form-input" required />
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label" for="editResidentName">Người dùng (Người cao tuổi)</label>
                    <select id="editResidentName" class="modal-form-select" required></select>
                </div>
                <div class="modal-form-group" id="editAllergyWarning" style="display:none; background:#fef3f2; border:1px solid #fecdca; border-radius:8px; padding:10px 14px; color:#b42318; font-size:13px;"></div>
                <div class="modal-form-group">
                    <label class="modal-form-label" for="editScheduleTime">Giờ uống</label>
                    <input type="time" id="editScheduleTime" class="modal-form-input" required />
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label" for="editFrequency">Tần suất</label>
                    <input type="text" id="editFrequency" class="modal-form-input" required />
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label" for="editStatus">Trạng thái</label>
                    <select id="editStatus" class="modal-form-select">
                        <option value="Đang dùng">Đang dùng</option>
                        <option value="Tạm dừng">Tạm dừng</option>
                        <option value="Đã ngưng">Đã ngưng</option>
                    </select>
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label" for="editNotes">Ghi chú</label>
                    <input type="text" id="editNotes" class="modal-form-input" />
                </div>
            </div>
            <div class="custom-modal-footer">
                <button type="button" class="btn-modal-cancel" onclick="closeModal('editMedicineModal')">Hủy</button>
                <button type="submit" class="btn-modal-submit">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

<!-- 3. Modal Xác nhận xóa thuốc -->
<div class="custom-modal-overlay" id="deleteMedicineModal">
    <div class="custom-modal-card" style="max-width: 440px;">
        <div class="custom-modal-header">
            <h2 class="custom-modal-title">Xác nhận xóa thuốc</h2>
            <button type="button" class="btn-close-modal" onclick="closeModal('deleteMedicineModal')">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <div class="custom-modal-body">
            <input type="hidden" id="deleteMedId" />
            <p id="deleteConfirmText" style="color: #475467; font-size: 14px; margin: 0; line-height: 1.5;">
                Bạn có chắc chắn muốn xóa đơn thuốc này không? Hành động này không thể hoàn tác.
            </p>
        </div>
        <div class="custom-modal-footer">
            <button type="button" class="btn-modal-cancel" onclick="closeModal('deleteMedicineModal')">Hủy</button>
            <button type="button" class="btn-modal-danger" onclick="confirmDeleteMedicine()">Xóa thuốc</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let medicinesList = [];
        let marRows = [];
        let residentsCache = []; // {residentId, name, room, allergies}

        async function loadResidentsCache() {
            const { data, error } = await window.sb
                .from("residents")
                .select("resident_id, full_name, allergies, rooms(room_code)")
                .eq("is_active", true)
                .order("full_name");

            if (error) {
                console.error(error);
                residentsCache = [];
                return;
            }

            residentsCache = (data || []).map(r => ({
                residentId: r.resident_id,
                name: r.full_name,
                room: r.rooms ? r.rooms.room_code : "",
                allergies: r.allergies || ""
            }));
        }

        function populateResidentSelects() {
            const addSel = document.getElementById("addResidentName");
            const editSel = document.getElementById("editResidentName");

            const html = residentsCache.map(r =>
                `<option value="${r.residentId}">${escapeHtml(r.name)} (Phòng ${escapeHtml(r.room || "---")})</option>`
            ).join("");

            if (addSel) addSel.innerHTML = html;
            if (editSel) editSel.innerHTML = html;
        }

        // Cảnh báo dị ứng: đối chiếu tên thuốc với ghi chú dị ứng của cư dân (residents.allergies)
        function checkAllergyWarning(residentId, medName, warningBoxEl) {
            warningBoxEl.style.display = "none";
            warningBoxEl.innerHTML = "";
            const res = residentsCache.find(r => r.residentId === residentId);
            if (!res || !res.allergies || !medName) return;

            const allergyText = res.allergies.toLowerCase();
            const words = medName.toLowerCase().split(/[\s0-9.,]+/).filter(w => w.length >= 4);
            const hit = words.find(w => allergyText.includes(w));

            if (hit) {
                warningBoxEl.style.display = "block";
                warningBoxEl.innerHTML = `⚠️ Cư dân có ghi chú dị ứng liên quan tới "<b>${escapeHtml(hit)}</b>" (${escapeHtml(res.allergies)}). Kiểm tra kỹ trước khi kê thuốc này.`;
            }
        }

        // Tìm thuốc theo tên, tạo mới nếu chưa có trong danh mục
        async function findOrCreateMedicine(name) {
            const { data: found } = await window.sb
                .from("medicines")
                .select("medicine_id")
                .ilike("medicine_name", name)
                .limit(1);

            if (found && found.length > 0) return found[0];

            const { data: created, error } = await window.sb
                .from("medicines")
                .insert({ medicine_name: name })
                .select("medicine_id")
                .single();

            if (error) throw error;
            return created;
        }

        // Load medicines (medication_schedules) từ Supabase
        async function loadMedicines() {
            const { data, error } = await window.sb
                .from("medication_schedules")
                .select("medication_schedule_id, dosage, frequency, administration_time, status, instructions, resident_id, residents(full_name), medicines(medicine_name)")
                .order("medication_schedule_id", { ascending: false });

            if (error) {
                console.error(error);
                medicinesList = [];
                renderMedicinesTable();
                return;
            }

            medicinesList = (data || []).map(row => ({
                scheduleId: row.medication_schedule_id,
                name: row.medicines ? row.medicines.medicine_name : "",
                dosage: row.dosage,
                residentId: row.resident_id,
                resident: row.residents ? row.residents.full_name : "",
                scheduleTime: row.administration_time ? row.administration_time.substring(0, 5) : "",
                frequency: row.frequency || "",
                status: row.status,
                notes: row.instructions || ""
            }));

            renderMedicinesTable();
        }

        // Render table
        function renderMedicinesTable() {
            const tbody = document.getElementById('medicineTableBody');
            if (!tbody) return;

            if (medicinesList.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="8" class="med-empty-state">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                            <p>Chưa có thông tin thuốc nào được lưu trữ.</p>
                        </td>
                    </tr>
                `;
                return;
            }

            let html = '';
            medicinesList.forEach(med => {
                let badgeClass = 'med-badge-active';
                if (med.status === 'Tạm dừng') badgeClass = 'med-badge-paused';
                else if (med.status === 'Đã ngưng') badgeClass = 'med-badge-stopped';

                html += `
                    <tr>
                        <td>
                            <div class="med-name-cell">
                                <div class="med-pill-icon">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M10.5 3a5.5 5.5 0 0 0-5.5 5.5v7a5.5 5.5 0 0 0 11 0v-7A5.5 5.5 0 0 0 10.5 3z" style="transform: rotate(45deg); transform-origin: 12px 12px;" />
                                        <line x1="6" y1="18" x2="18" y2="6" />
                                    </svg>
                                </div>
                                <span class="med-name-text">${escapeHtml(med.name)}</span>
                            </div>
                        </td>
                        <td>${escapeHtml(med.dosage)}</td>
                        <td><span class="med-resident-name">${escapeHtml(med.resident)}</span></td>
                        <td>${escapeHtml(med.scheduleTime)}</td>
                        <td>${escapeHtml(med.frequency)}</td>
                        <td><span class="med-badge ${badgeClass}">${escapeHtml(med.status)}</span></td>
                        <td><span class="med-notes" title="${escapeHtml(med.notes || '')}">${escapeHtml(med.notes || '—')}</span></td>
                        <td data-roles="admin,manager,staff">
                            <div class="med-actions-cell">
                                <button type="button" class="btn-action-icon btn-action-edit" title="Chỉnh sửa" onclick="openEditMedicineModal(${med.scheduleId})">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                    </svg>
                                </button>
                                <button type="button" class="btn-action-icon btn-action-delete" title="Xóa" onclick="openDeleteMedicineModal(${med.scheduleId})">
                                    <svg viewBox="0 0 24 24">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            tbody.innerHTML = html;
            if (window.currentUser) applyDataRolesWithin(tbody, window.currentUser.role);
        }

        // Open/Close Modal Utilities
        function openModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) modal.classList.add('show');
        }

        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) modal.classList.remove('show');
        }

        // Add Modal Handler
        function openAddMedicineModal() {
            document.getElementById('addMedicineForm').reset();
            document.getElementById('addAllergyWarning').style.display = 'none';
            openModal('addMedicineModal');
        }

        async function handleAddMedicine(e) {
            e.preventDefault();
            const submitBtn = e.target.querySelector('button[type="submit"]');
            const name = document.getElementById('addMedName').value.trim();
            const dosage = document.getElementById('addDosage').value.trim();
            const residentId = parseInt(document.getElementById('addResidentName').value, 10);
            const scheduleTime = document.getElementById('addScheduleTime').value;
            const frequency = document.getElementById('addFrequency').value.trim();
            const status = document.getElementById('addStatus').value;
            const notes = document.getElementById('addNotes').value.trim();

            submitBtn.disabled = true;
            submitBtn.textContent = 'Đang lưu...';
            try {
                const medicine = await findOrCreateMedicine(name);
                const { error } = await window.sb.from('medication_schedules').insert({
                    resident_id: residentId,
                    medicine_id: medicine.medicine_id,
                    prescribed_by: window.currentUser ? window.currentUser.id : null,
                    dosage: dosage,
                    frequency: frequency || null,
                    start_date: new Date().toISOString().slice(0, 10),
                    administration_time: scheduleTime + ':00',
                    instructions: notes || null,
                    status: status
                });
                if (error) throw error;

                closeModal('addMedicineModal');
                await loadMedicines();
                await loadMarToday();
            } catch (err) {
                console.error(err);
                alert('Không thể thêm thuốc: ' + err.message);
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Thêm thuốc';
            }
        }

        // Edit Modal Handler
        function openEditMedicineModal(scheduleId) {
            const med = medicinesList.find(m => m.scheduleId === scheduleId);
            if (!med) return;

            document.getElementById('editMedId').value = med.scheduleId;
            document.getElementById('editMedName').value = med.name;
            document.getElementById('editDosage').value = med.dosage;
            document.getElementById('editResidentName').value = med.residentId;
            document.getElementById('editScheduleTime').value = med.scheduleTime;
            document.getElementById('editFrequency').value = med.frequency;
            document.getElementById('editStatus').value = med.status;
            document.getElementById('editNotes').value = med.notes || '';
            document.getElementById('editAllergyWarning').style.display = 'none';

            openModal('editMedicineModal');
        }

        async function handleSaveEditMedicine(e) {
            e.preventDefault();
            const submitBtn = e.target.querySelector('button[type="submit"]');
            const scheduleId = parseInt(document.getElementById('editMedId').value, 10);
            const name = document.getElementById('editMedName').value.trim();
            const dosage = document.getElementById('editDosage').value.trim();
            const residentId = parseInt(document.getElementById('editResidentName').value, 10);
            const scheduleTime = document.getElementById('editScheduleTime').value;
            const frequency = document.getElementById('editFrequency').value.trim();
            const status = document.getElementById('editStatus').value;
            const notes = document.getElementById('editNotes').value.trim();

            submitBtn.disabled = true;
            submitBtn.textContent = 'Đang lưu...';
            try {
                const medicine = await findOrCreateMedicine(name);
                const { error } = await window.sb.from('medication_schedules').update({
                    resident_id: residentId,
                    medicine_id: medicine.medicine_id,
                    dosage: dosage,
                    frequency: frequency || null,
                    administration_time: scheduleTime + ':00',
                    instructions: notes || null,
                    status: status
                }).eq('medication_schedule_id', scheduleId);
                if (error) throw error;

                closeModal('editMedicineModal');
                await loadMedicines();
                await loadMarToday();
            } catch (err) {
                console.error(err);
                alert('Không thể lưu thay đổi: ' + err.message);
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Lưu thay đổi';
            }
        }

        // Delete Modal Handler
        function openDeleteMedicineModal(scheduleId) {
            const med = medicinesList.find(m => m.scheduleId === scheduleId);
            if (!med) return;

            document.getElementById('deleteMedId').value = med.scheduleId;
            document.getElementById('deleteConfirmText').innerHTML = `Bạn có chắc chắn muốn xóa thuốc <strong>${escapeHtml(med.name)}</strong> của cư dân <strong>${escapeHtml(med.resident)}</strong> không?`;
            openModal('deleteMedicineModal');
        }

        async function confirmDeleteMedicine() {
            const scheduleId = parseInt(document.getElementById('deleteMedId').value, 10);
            const { error } = await window.sb.from('medication_schedules').delete().eq('medication_schedule_id', scheduleId);
            if (error) {
                alert('Không thể xóa: ' + error.message);
                return;
            }
            closeModal('deleteMedicineModal');
            await loadMedicines();
            await loadMarToday();
        }

        function escapeHtml(text) {
            if (!text) return '';
            return String(text)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        // ==========================================================================
        // MAR — SỔ CẤP PHÁT HÔM NAY
        // ==========================================================================
        async function loadMarToday() {
            const todayIso = new Date().toISOString().slice(0, 10);

            const { data: schedules, error } = await window.sb
                .from('medication_schedules')
                .select('medication_schedule_id, administration_time, dosage, resident_id, residents(full_name), medicines(medicine_name)')
                .lte('start_date', todayIso)
                .eq('status', 'Đang sử dụng')
                .or(`end_date.is.null,end_date.gte.${todayIso}`);

            if (error) {
                console.error(error);
                marRows = [];
                renderMarTable();
                return;
            }

            const { data: admins } = await window.sb
                .from('medication_administrations')
                .select('medication_schedule_id, actual_time, status')
                .eq('scheduled_date', todayIso);

            const adminMap = {};
            (admins || []).forEach(a => { adminMap[a.medication_schedule_id] = a; });

            marRows = (schedules || []).map(s => {
                const admin = adminMap[s.medication_schedule_id];
                return {
                    scheduleId: s.medication_schedule_id,
                    time: s.administration_time ? s.administration_time.substring(0, 5) : '',
                    resident: s.residents ? s.residents.full_name : '',
                    medName: s.medicines ? s.medicines.medicine_name : '',
                    dosage: s.dosage,
                    done: !!admin,
                    actualTime: admin ? admin.actual_time : null
                };
            }).sort((a, b) => a.time.localeCompare(b.time));

            renderMarTable();
        }

        function renderMarTable() {
            const tbody = document.getElementById('marTableBody');
            if (!tbody) return;

            if (marRows.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="med-empty-state">Không có lịch cấp thuốc nào cho hôm nay.</td></tr>`;
                return;
            }

            const now = new Date();
            tbody.innerHTML = marRows.map(r => {
                let isLate = false;
                if (!r.done && r.time) {
                    const [hh, mm] = r.time.split(':').map(Number);
                    const schedDate = new Date();
                    schedDate.setHours(hh, mm, 0, 0);
                    isLate = (now - schedDate) / 60000 > 30;
                }

                const statusHtml = r.done
                    ? `<span class="med-badge med-badge-active">Đã thực hiện</span>`
                    : (isLate
                        ? `<span class="med-badge" style="background:#fef3f2;color:#b42318;">Trễ giờ</span>`
                        : `<span class="med-badge med-badge-paused">Chưa thực hiện</span>`);

                const actionHtml = r.done
                    ? '—'
                    : `<button type="button" class="btn-modal-submit" style="padding:6px 14px; font-size:13px;" onclick="confirmAdministration(${r.scheduleId})">Đã cho uống</button>`;

                return `
                    <tr>
                        <td>${escapeHtml(r.time)}</td>
                        <td>${escapeHtml(r.resident)}</td>
                        <td>${escapeHtml(r.medName)} — ${escapeHtml(r.dosage)}</td>
                        <td>${statusHtml}</td>
                        <td>${r.actualTime ? escapeHtml(r.actualTime.substring(0, 5)) : '—'}</td>
                        <td style="text-align:right;">${actionHtml}</td>
                    </tr>
                `;
            }).join('');
        }

        async function confirmAdministration(scheduleId) {
            const sched = marRows.find(r => r.scheduleId === scheduleId);
            const todayIso = new Date().toISOString().slice(0, 10);
            const now = new Date();
            const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:00`;

            const { error } = await window.sb.from('medication_administrations').insert({
                medication_schedule_id: scheduleId,
                administered_by: window.currentUser ? window.currentUser.id : null,
                scheduled_date: todayIso,
                scheduled_time: (sched ? sched.time : '00:00') + ':00',
                actual_time: timeStr,
                status: 'Đã thực hiện'
            });

            if (error) {
                alert('Không thể xác nhận đã cho uống: ' + error.message);
                return;
            }
            await loadMarToday();
        }

        function applyDataRolesWithin(container, role) {
            container.querySelectorAll('[data-roles]').forEach(el => {
                const allowed = el.getAttribute('data-roles').split(',').map(r => r.trim());
                el.style.display = allowed.indexOf(role) === -1 ? 'none' : '';
            });
        }

        document.getElementById('addResidentName')?.addEventListener('change', function () {
            checkAllergyWarning(parseInt(this.value, 10), document.getElementById('addMedName').value.trim(), document.getElementById('addAllergyWarning'));
        });
        document.getElementById('addMedName')?.addEventListener('input', function () {
            checkAllergyWarning(parseInt(document.getElementById('addResidentName').value, 10), this.value.trim(), document.getElementById('addAllergyWarning'));
        });
        document.getElementById('editResidentName')?.addEventListener('change', function () {
            checkAllergyWarning(parseInt(this.value, 10), document.getElementById('editMedName').value.trim(), document.getElementById('editAllergyWarning'));
        });
        document.getElementById('editMedName')?.addEventListener('input', function () {
            checkAllergyWarning(parseInt(document.getElementById('editResidentName').value, 10), this.value.trim(), document.getElementById('editAllergyWarning'));
        });

        document.addEventListener("DOMContentLoaded", async function () {
            await loadResidentsCache();
            populateResidentSelects();
            await loadMedicines();
            if (window.currentUser && ['admin', 'manager', 'staff'].indexOf(window.currentUser.role) !== -1) {
                await loadMarToday();
            }
            if (window.currentUser) {
                applyDataRolesWithin(document, window.currentUser.role);
            }
        });

        document.addEventListener("silvercare:auth-ready", async function (e) {
            if (['admin', 'manager', 'staff'].indexOf(e.detail.role) !== -1 && marRows.length === 0) {
                await loadMarToday();
            }
            applyDataRolesWithin(document, e.detail.role);
        });
    </script>
}
