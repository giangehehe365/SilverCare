            <!-- Resolved note if any -->
            <div id="detail-resolved-section" style="display: none; padding: 12px; background-color: #ecfdf3; border-radius: 8px; border: 1px solid #a6f4c5; margin-top: 12px;">
                <div style="font-weight: 700; color: #027a48; font-size: 13.5px; margin-bottom: 4px;">Thông tin can thiệp:</div>
                <div style="font-size: 13px; color: #027a48;" id="detail-resolved-text">Đã kiểm tra lại chỉ số và hỗ trợ người bệnh lúc 09:00 bởi Nguyễn Thị Lan.</div>
            </div>
        </div>

        <div class="modal-footer" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <div style="display: flex; gap: 8px;">
                <button class="modal-btn btn-secondary" id="btn-modal-view-record" title="Xem biểu đồ & nhật ký sức khỏe">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                    </svg>
                    Sức khỏe & Biểu đồ
                </button>
                <button class="modal-btn btn-secondary" id="btn-modal-view-resident" title="Xem hồ sơ người cao tuổi">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    Hồ sơ người cao tuổi
                </button>
            </div>
            <button class="modal-btn btn-success" id="btn-modal-quick-resolve">
                Ghi nhận xử lý
            </button>
        </div>
    </div>
</div>

<!-- ==========================================================================
   MODAL 2: GHI NHẬN XỬ LÝ CẢNH BÁO
   ========================================================================== -->
<div class="modal-overlay" id="modal-resolve-overlay">
    <div class="modal-dialog">
        <div class="modal-header">
            <div class="modal-header-left">
                <div class="modal-header-icon icon-box-resolved">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <div>
                    <h3 class="modal-title" id="resolve-modal-title">Xử lý cảnh báo - Nguyễn Văn An</h3>
                    <p class="modal-subtitle">Ghi nhận can thiệp y tế & cập nhật trạng thái</p>
                </div>
            </div>
            <button class="modal-close-btn" id="btn-close-resolve">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <div class="modal-body">
            <div class="form-group">
                <label class="form-label">Biện pháp can thiệp đã thực hiện</label>
                <select class="form-select" id="resolve-action-select">
                    <option value="Đã đo lại chỉ số sinh hiệu (Ổn định hơn)">Đã đo lại chỉ số sinh hiệu (Ổn định hơn)</option>
                    <option value="Đã cho uống thuốc theo chỉ định bác sĩ">Đã cho uống thuốc theo chỉ định bác sĩ</option>
                    <option value="Đã thực hiện lau mát và bù nước điện giải">Đã thực hiện lau mát và bù nước điện giải</option>
                    <option value="Đã thông báo bác sĩ điều trị và chăm sóc đặc biệt">Đã thông báo bác sĩ điều trị và chăm sóc đặc biệt</option>
                    <option value="Đã liên hệ và thông báo cho người nhà">Đã liên hệ và thông báo cho người nhà</option>
                    <option value="Người bệnh đã nghỉ ngơi và hồi phục">Người bệnh đã nghỉ ngơi và hồi phục</option>
                    <option value="Khác (Ghi rõ bên dưới)">Khác (Ghi rõ bên dưới)</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Ghi chú chi tiết của điều dưỡng / nhân viên</label>
                <textarea class="form-textarea" id="resolve-note-input" placeholder="Ví dụ: Đã đo lại HA sau 20 phút nghỉ ngơi, tinh thần người bệnh ổn định..."></textarea>
            </div>

            <div class="form-group">
                <label class="form-label">Người thực hiện xử lý</label>
                <input type="text" class="form-input" id="resolve-staff-name" readonly />
            </div>
        </div>

        <div class="modal-footer">
            <button class="modal-btn btn-secondary" id="btn-cancel-resolve">Hủy</button>
            <button class="modal-btn btn-primary" id="btn-confirm-resolve">Xác nhận hoàn tất</button>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast-notification" id="toast-notify">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#12b76a" stroke-width="2">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
    <span id="toast-message">Đã cập nhật cảnh báo thành công!</span>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", async function () {
    // Dữ liệu cảnh báo giờ lấy thật từ bảng health_alerts (Supabase) — được tạo
    // tự động bởi trigger trg_evaluate_health_alert mỗi khi có health_records
    // mới vượt ngưỡng an toàn (xem supabase/schema.sql).
    let alertsData = [];
    let currentFilter = "all";
    let searchQuery = "";
    let activeAlertId = null;

    // DOM Elements
    const alertsListContainer = document.getElementById("alerts-list-container");
    const alertsEmptyState = document.getElementById("alerts-empty-state");
    const searchInput = document.getElementById("alerts-search-input");
    const tabButtons = document.querySelectorAll(".alerts-tab-btn");

    // Badges
    const badgeAll = document.getElementById("badge-all");
    const badgeHigh = document.getElementById("badge-high");
    const badgeMedium = document.getElementById("badge-medium");
    const badgeLow = document.getElementById("badge-low");
    const badgeResolved = document.getElementById("badge-resolved");

    // Detail Modal Elements
    const modalDetailOverlay = document.getElementById("modal-detail-overlay");
    const btnCloseDetail = document.getElementById("btn-close-detail");
    const detailPatientName = document.getElementById("detail-patient-name");
    const detailPatientMeta = document.getElementById("detail-patient-meta");
    const detailPatientId = document.getElementById("detail-patient-id");
    const detailPatientAge = document.getElementById("detail-patient-age");
    const detailPatientGender = document.getElementById("detail-patient-gender");
    const detailPatientBlood = document.getElementById("detail-patient-blood");
    const detailPatientNotes = document.getElementById("detail-patient-notes");
    const detailBadgeLevel = document.getElementById("detail-badge-level");
    const detailAlertTitle = document.getElementById("detail-alert-title");
    const detailAlertDesc = document.getElementById("detail-alert-desc");
    const detailValBp = document.getElementById("detail-val-bp");
    const detailValHr = document.getElementById("detail-val-hr");
    const detailValTemp = document.getElementById("detail-val-temp");
    const detailValStaff = document.getElementById("detail-val-staff");
    const detailAiRecommendation = document.getElementById("detail-ai-recommendation");
    const detailResolvedSection = document.getElementById("detail-resolved-section");
    const detailResolvedText = document.getElementById("detail-resolved-text");
    const detailIconBox = document.getElementById("detail-icon-box");
    const btnModalViewRecord = document.getElementById("btn-modal-view-record");
    const btnModalViewResident = document.getElementById("btn-modal-view-resident");
    const btnModalQuickResolve = document.getElementById("btn-modal-quick-resolve");

    // Resolve Modal Elements
    const modalResolveOverlay = document.getElementById("modal-resolve-overlay");
    const btnCloseResolve = document.getElementById("btn-close-resolve");
    const btnCancelResolve = document.getElementById("btn-cancel-resolve");
    const btnConfirmResolve = document.getElementById("btn-confirm-resolve");
    const resolveModalTitle = document.getElementById("resolve-modal-title");
    const resolveActionSelect = document.getElementById("resolve-action-select");
    const resolveNoteInput = document.getElementById("resolve-note-input");
    const resolveStaffName = document.getElementById("resolve-staff-name");

    // Toast
    const toastNotify = document.getElementById("toast-notify");
    const toastMessage = document.getElementById("toast-message");

    function showToast(msg) {
        if (!toastNotify) return;
        toastMessage.innerText = msg;
        toastNotify.classList.add("show");
        setTimeout(() => {
            toastNotify.classList.remove("show");
        }, 3000);
    }

    // ==========================================================================
    // 2. LOAD ALERTS FROM SUPABASE (health_alerts + alert_resolutions)
    // ==========================================================================
    function formatDateTimeVN(iso) {
        if (!iso) return "";
        const d = new Date(iso);
        const dd = String(d.getDate()).padStart(2, "0");
        const mm = String(d.getMonth() + 1).padStart(2, "0");
        const hh = String(d.getHours()).padStart(2, "0");
        const mi = String(d.getMinutes()).padStart(2, "0");
        return `${hh}:${mi} ${dd}/${mm}`;
    }

    function mapSeverityToLevel(severity) {
        if (severity === "Cao") return "high";
        if (severity === "Trung bình") return "medium";
        return "low";
    }

    async function loadAlerts(showToastFeedback = false) {
        const { data, error } = await window.sb
            .from("health_alerts")
            .select(
                "alert_id, resident_id, alert_type, severity, title, message, trigger_value, ai_recommendation, status, created_at, resolved_at, " +
                "residents(resident_code, full_name, age, gender, blood_type, notes, rooms(room_code)), " +
                "health_records(systolic, diastolic, heart_rate, temperature), " +
                "alert_resolutions(resolution_type, action_taken, note, resolved_at, profiles(full_name))"
            )
            .order("created_at", { ascending: false })
            .order("resolved_at", { foreignTable: "alert_resolutions", ascending: false });

        if (error) {
            console.error(error);
            showToast("Không tải được danh sách cảnh báo: " + error.message);
            alertsData = [];
            renderAlerts();
            return;
        }

        alertsData = (data || []).map(row => {
            const res = row.residents || {};
            const vitals = row.health_records || {};
            const room = res.rooms ? `Phòng ${res.rooms.room_code}` : "Phòng ---";
            const latestResolution = (row.alert_resolutions && row.alert_resolutions[0]) || null;
            const isResolved = row.status === "Đã xử lý";

            return {
                id: row.alert_id,
                patientId: res.resident_code,
                patientResidentId: row.resident_id,
                patientName: res.full_name || "Người cao tuổi",
                patientAge: res.age,
                patientGender: res.gender,
                patientBlood: res.blood_type,
                patientNotes: res.notes,
                room: room,
                level: mapSeverityToLevel(row.severity),
                title: row.title,
                description: row.message || "",
                time: formatDateTimeVN(row.created_at),
                vitalsSummary: row.trigger_value,
                sys: vitals.systolic,
                dia: vitals.diastolic,
                hr: vitals.heart_rate,
                temp: vitals.temperature,
                aiRecommendation: row.ai_recommendation,
                isResolved: isResolved,
                resolvedAt: latestResolution ? formatDateTimeVN(latestResolution.resolved_at) : null,
                resolvedNote: latestResolution ? (latestResolution.action_taken || latestResolution.note) : null,
                resolvedBy: latestResolution && latestResolution.profiles ? latestResolution.profiles.full_name : null
            };
        });

        // Sort: unresolved trước (cao > trung bình > thấp), rồi tới đã xử lý
        alertsData.sort((a, b) => {
            if (a.isResolved !== b.isResolved) return a.isResolved ? 1 : -1;
            const weight = { high: 3, medium: 2, low: 1 };
            return (weight[b.level] || 0) - (weight[a.level] || 0);
        });

        renderAlerts();

        if (showToastFeedback) {
            const count = alertsData.filter(a => !a.isResolved).length;
            showToast(`Đã tải lại danh sách cảnh báo (${count} cảnh báo đang hoạt động).`);
        }
    }

    // ==========================================================================
    // 3. RENDER ALERTS LIST & BADGES
    // ==========================================================================
    function renderAlerts() {
        // Calculate counters
        const totalCount = alertsData.length;
        const highCount = alertsData.filter(a => !a.isResolved && a.level === "high").length;
        const mediumCount = alertsData.filter(a => !a.isResolved && a.level === "medium").length;
        const lowCount = alertsData.filter(a => !a.isResolved && a.level === "low").length;
        const resolvedCount = alertsData.filter(a => a.isResolved).length;

        if (badgeAll) badgeAll.innerText = totalCount;
        if (badgeHigh) badgeHigh.innerText = highCount;
        if (badgeMedium) badgeMedium.innerText = mediumCount;
        if (badgeLow) badgeLow.innerText = lowCount;
        if (badgeResolved) badgeResolved.innerText = resolvedCount;

        // Filter items
        let filtered = alertsData.filter(item => {
            // Tab filter
            if (currentFilter === "high") {
                if (item.isResolved || item.level !== "high") return false;
            } else if (currentFilter === "medium") {
                if (item.isResolved || item.level !== "medium") return false;
            } else if (currentFilter === "low") {
                if (item.isResolved || item.level !== "low") return false;
            } else if (currentFilter === "resolved") {
                if (!item.isResolved) return false;
            }

            // Search query filter
            if (searchQuery.trim() !== "") {
                const q = searchQuery.toLowerCase();
                const matchName = item.patientName.toLowerCase().includes(q);
                const matchRoom = item.room.toLowerCase().includes(q);
                const matchTitle = item.title.toLowerCase().includes(q);
                const matchDesc = item.description.toLowerCase().includes(q);
                if (!matchName && !matchRoom && !matchTitle && !matchDesc) return false;
            }

            return true;
        });

        if (filtered.length === 0) {
            alertsListContainer.innerHTML = "";
            alertsEmptyState.style.display = "flex";
            return;
        }

        alertsEmptyState.style.display = "none";
        alertsListContainer.innerHTML = "";

        filtered.forEach(alert => {
            const itemEl = document.createElement("div");
            itemEl.className = `alert-row-item ${alert.isResolved ? "is-resolved" : ""}`;

            // Priority config
            let iconBoxClass = "icon-box-medium";
            let badgeClass = "badge-level-medium";
            let badgeText = "Trung bình";
            let iconSvg = `
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            `;

            if (alert.isResolved) {
                iconBoxClass = "icon-box-resolved";
                badgeClass = "badge-level-resolved";
                badgeText = "Đã xử lý";
                iconSvg = `
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                `;
            } else if (alert.level === "high") {
                iconBoxClass = "icon-box-high";
                badgeClass = "badge-level-high";
                badgeText = "Cao";
                iconSvg = `
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                        <line x1="12" y1="9" x2="12" y2="13"></line>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                `;
            } else if (alert.level === "low") {
                iconBoxClass = "icon-box-low";
                badgeClass = "badge-level-low";
                badgeText = "Thấp";
                iconSvg = `
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                `;
            }

            // Action Buttons
            let resolveButtonHtml = "";
            if (alert.isResolved) {
                resolveButtonHtml = `
                    <button class="btn-alert-link btn-alert-resolved-done" title="Đã xử lý lúc ${alert.resolvedAt || ''}">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Đã xong</span>
                    </button>
                `;
            } else {
                resolveButtonHtml = `
                    <button class="btn-alert-link btn-alert-resolve" data-roles="admin,manager,staff" onclick="openResolveModal(${alert.id})" title="Ghi nhận can thiệp xử lý cảnh báo">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Xử lý</span>
                    </button>
                `;
            }

            itemEl.innerHTML = `
                <div class="alert-icon-box ${iconBoxClass}">
                    ${iconSvg}
                </div>
                <div class="alert-content-wrapper">
                    <div class="alert-header-line">
                        <span class="alert-level-badge ${badgeClass}">${badgeText}</span>
                        <span class="alert-patient-name" onclick="openDetailModal(${alert.id})">${alert.patientName}</span>
                        <span class="alert-patient-room">${alert.room}</span>
                        ${alert.isResolved ? `<span class="badge-resolved-status">✓ Đã xử lý</span>` : ""}
                    </div>
                    <h3 class="alert-title-text">${alert.title}</h3>
                    <p class="alert-description-text">${alert.description}</p>
                    <div class="alert-meta-line">
                        <span class="alert-meta-time">
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            ${alert.time}
                        </span>
                        ${alert.isResolved && alert.resolvedBy ? `<span class="alert-meta-assignee">Xử lý bởi: ${alert.resolvedBy}</span>` : ""}
                        ${alert.vitalsSummary ? `<span class="vital-pill-highlight">${alert.vitalsSummary}</span>` : ''}
                    </div>
                </div>
                <div class="alert-actions-col">
                    <button class="btn-alert-link btn-alert-detail" onclick="openDetailModal(${alert.id})" title="Xem phân tích y tế AI & hồ sơ">
                        Chi tiết
                    </button>
                    <a href="@Url.Action("Health", "Home")?residentId=${encodeURIComponent(alert.patientId)}&name=${encodeURIComponent(alert.patientName)}" class="btn-alert-link btn-alert-profile" title="Xem biểu đồ & nhật ký sức khỏe">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                        </svg>
                        <span>Hồ sơ</span>
                    </a>
                    ${resolveButtonHtml}
                </div>
            `;

            alertsListContainer.appendChild(itemEl);
        });

        if (window.currentUser) applyDataRolesWithin(alertsListContainer, window.currentUser.role);
    }

    function applyDataRolesWithin(container, role) {
        container.querySelectorAll("[data-roles]").forEach(el => {
            const allowed = el.getAttribute("data-roles").split(",").map(r => r.trim());
            el.style.display = allowed.indexOf(role) === -1 ? "none" : "";
        });
    }

    // ==========================================================================
    // 4. EVENT HANDLERS & MODAL ACTIONS
    // ==========================================================================

    // Tab buttons click
    tabButtons.forEach(btn => {
        btn.addEventListener("click", function () {
            tabButtons.forEach(b => b.classList.remove("active"));
            this.classList.add("active");
            currentFilter = this.getAttribute("data-filter");
            renderAlerts();
        });
    });

    // Search input
    if (searchInput) {
        searchInput.addEventListener("input", function (e) {
            searchQuery = e.target.value;
            renderAlerts();
        });
    }

    // Button "Làm mới" — tải lại danh sách cảnh báo mới nhất từ Supabase
    const btnSyncAi = document.getElementById("btn-sync-ai");
    if (btnSyncAi) {
        btnSyncAi.addEventListener("click", async function () {
            this.style.transform = "rotate(180deg)";
            await loadAlerts(true);
            setTimeout(() => { this.style.transform = "none"; }, 300);
        });
    }

    // Button Resolve All — ghi nhận xử lý hàng loạt (thật, vào alert_resolutions + health_alerts)
    const btnResolveAll = document.getElementById("btn-resolve-all");
    if (btnResolveAll) {
        btnResolveAll.addEventListener("click", async function () {
            const unresolved = alertsData.filter(a => !a.isResolved);
            if (unresolved.length === 0) {
                showToast("Tất cả các cảnh báo đã được xử lý trước đó!");
                return;
            }
            if (!confirm(`Bạn có chắc chắn muốn ghi nhận xử lý toàn bộ ${unresolved.length} cảnh báo sức khỏe?`)) return;

            const nowIso = new Date().toISOString();
            const resolvedById = window.currentUser ? window.currentUser.id : null;

            const resolutionRows = unresolved.map(a => ({
                alert_id: a.id,
                resolved_by: resolvedById,
                resolution_type: "Xử lý hàng loạt",
                action_taken: "Xử lý hàng loạt bởi nhân viên ca trực.",
                resolved_at: nowIso
            }));

            const { error: insError } = await window.sb.from("alert_resolutions").insert(resolutionRows);
            if (insError) {
                alert("Không thể ghi nhận xử lý: " + insError.message);
                return;
            }

            const { error: updError } = await window.sb
                .from("health_alerts")
                .update({ status: "Đã xử lý", resolved_at: nowIso })
                .in("alert_id", unresolved.map(a => a.id));

            if (updError) {
                alert("Không thể cập nhật trạng thái: " + updError.message);
                return;
            }

            await loadAlerts();
            showToast(`Đã ghi nhận xử lý toàn bộ ${unresolved.length} cảnh báo.`);
        });
    }

    // Global Modal Functions
    window.openDetailModal = function (alertId) {
        const item = alertsData.find(a => a.id === alertId);
        if (!item) return;
        activeAlertId = alertId;

        detailPatientName.innerText = item.patientName;
        detailPatientMeta.innerText = `${item.room} · ${item.time}`;
        detailPatientId.innerText = item.patientId;
        detailPatientAge.innerText = item.patientAge || 75;
        detailPatientGender.innerText = item.patientGender || "Nam";
        detailPatientBlood.innerText = item.patientBlood || "A+";
        detailPatientNotes.innerText = item.patientNotes || "Theo dõi định kỳ.";

        detailAlertTitle.innerText = item.title;
        detailAlertDesc.innerText = item.description;
        
        detailValBp.innerText = item.sys && item.dia ? `${item.sys}/${item.dia} mmHg` : "--/-- mmHg";
        detailValHr.innerText = item.hr ? `${item.hr} bpm` : "-- bpm";
        detailValTemp.innerText = item.temp ? `${item.temp} °C` : "-- °C";
        detailValStaff.innerText = item.isResolved ? (item.resolvedBy || "---") : "Chưa xử lý";
        detailAiRecommendation.innerText = item.aiRecommendation || "Chỉ số cần được theo dõi định kỳ và can thiệp kịp thời nếu bất thường.";

        // Badge styling
        detailBadgeLevel.className = `alert-level-badge ${item.isResolved ? 'badge-level-resolved' : (item.level === 'high' ? 'badge-level-high' : (item.level === 'low' ? 'badge-level-low' : 'badge-level-medium'))}`;
        detailBadgeLevel.innerText = item.isResolved ? 'Đã xử lý' : (item.level === 'high' ? 'Cao' : (item.level === 'low' ? 'Thấp' : 'Trung bình'));

        if (detailIconBox) {
            detailIconBox.className = `modal-header-icon ${item.isResolved ? 'icon-box-resolved' : (item.level === 'high' ? 'icon-box-high' : 'icon-box-medium')}`;
        }

        const canResolve = !item.isResolved && window.currentUser && ["admin", "manager", "staff"].indexOf(window.currentUser.role) !== -1;

        if (item.isResolved) {
            detailResolvedSection.style.display = "block";
            detailResolvedText.innerText = `${item.resolvedNote || 'Đã can thiệp và hoàn tất xử lý.'} (Bởi ${item.resolvedBy || 'Nhân viên'} lúc ${item.resolvedAt || 'hôm nay'})`;
            btnModalQuickResolve.style.display = "none";
        } else {
            detailResolvedSection.style.display = "none";
            btnModalQuickResolve.style.display = canResolve ? "inline-flex" : "none";
        }

        btnModalViewRecord.onclick = function () {
            window.location.href = `@Url.Action("Health", "Home")?residentId=${encodeURIComponent(item.patientId)}&name=${encodeURIComponent(item.patientName)}`;
        };

        btnModalViewResident.onclick = function () {
            window.location.href = `@Url.Action("Residents", "Home")?residentId=${encodeURIComponent(item.patientId)}`;
        };

        btnModalQuickResolve.onclick = function () {
            closeModal(modalDetailOverlay);
            openResolveModal(item.id);
        };

        openModal(modalDetailOverlay);
    };

    window.openResolveModal = function (alertId) {
        const item = alertsData.find(a => a.id === alertId);
        if (!item) return;
        activeAlertId = alertId;

        resolveModalTitle.innerText = `Xử lý cảnh báo - ${item.patientName}`;
        resolveNoteInput.value = `Đã can thiệp kiểm tra cho bệnh nhân ${item.patientName} (${item.title}), các dấu hiệu ổn định.`;
        resolveStaffName.value = window.currentUser ? window.currentUser.fullName : "";
        openModal(modalResolveOverlay);
    };

    function openModal(modal) {
        if (!modal) return;
        modal.classList.add("active");
        document.body.style.overflow = "hidden";
    }

    function closeModal(modal) {
        if (!modal) return;
        modal.classList.remove("active");
        document.body.style.overflow = "";
    }

    if (btnCloseDetail) btnCloseDetail.onclick = () => closeModal(modalDetailOverlay);
    if (btnCloseResolve) btnCloseResolve.onclick = () => closeModal(modalResolveOverlay);
    if (btnCancelResolve) btnCancelResolve.onclick = () => closeModal(modalResolveOverlay);

    // Click outside modal to close
    modalDetailOverlay.addEventListener("click", function (e) {
        if (e.target === modalDetailOverlay) closeModal(modalDetailOverlay);
    });
    modalResolveOverlay.addEventListener("click", function (e) {
        if (e.target === modalResolveOverlay) closeModal(modalResolveOverlay);
    });

    // Confirm Resolve — ghi thật vào alert_resolutions + cập nhật health_alerts.status
    if (btnConfirmResolve) {
        btnConfirmResolve.addEventListener("click", async function () {
            if (!activeAlertId) return;
            const item = alertsData.find(a => a.id === activeAlertId);
            if (!item) return;

            const actionSelect = resolveActionSelect.value;
            const noteText = resolveNoteInput.value.trim();
            const nowIso = new Date().toISOString();

            btnConfirmResolve.disabled = true;
            btnConfirmResolve.textContent = "Đang lưu...";

            try {
                const { error: insError } = await window.sb.from("alert_resolutions").insert({
                    alert_id: item.id,
                    resolved_by: window.currentUser ? window.currentUser.id : null,
                    resolution_type: actionSelect,
                    action_taken: noteText || actionSelect,
                    resolved_at: nowIso
                });
                if (insError) throw insError;

                const { error: updError } = await window.sb
                    .from("health_alerts")
                    .update({ status: "Đã xử lý", resolved_at: nowIso })
                    .eq("alert_id", item.id);
                if (updError) throw updError;

                await loadAlerts();
                closeModal(modalResolveOverlay);
                showToast(`Đã ghi nhận xử lý thành công cho bệnh nhân ${item.patientName}!`);
            } catch (err) {
                console.error(err);
                alert("Không thể ghi nhận xử lý: " + err.message);
            } finally {
                btnConfirmResolve.disabled = false;
                btnConfirmResolve.textContent = "Xác nhận hoàn tất";
            }
        });
    }

    // Initial load — dữ liệu thật từ Supabase
    await loadAlerts(false);
    if (window.currentUser) applyDataRolesWithin(document, window.currentUser.role);

    document.addEventListener("silvercare:auth-ready", function (e) {
        applyDataRolesWithin(document, e.detail.role);
        renderAlerts();
    });
});
</script>
}
