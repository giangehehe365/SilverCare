            // 4. EVALUATE PATIENT PROFILE MEDICAL CONDITIONS & NOTES
            if (resNotes.toLowerCase().includes("đường huyết") && !generatedAlerts.some(a => a.patientId === res.id && a.title.includes("đường huyết"))) {
