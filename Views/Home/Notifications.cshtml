@using System.Collections.Generic
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Cảnh báo & Thông báo";

    var fullName = TempData["FullName"] as string ?? "Nguyễn Thị Lan";
    var role = TempData["Role"] as string ?? "Nhân viên";
    TempData.Keep("FullName");
    TempData.Keep("Role");
}

<style>
    /* ==========================================================================
       NOTIFICATIONS & ALERTS PAGE STYLING (FIGMA ACCURATE)
       ========================================================================== */
    .alerts-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding-bottom: 60px;
    }

    /* Header */
    .alerts-header {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .alerts-title {
        font-size: 26px;
        font-weight: 700;
        color: #101828;
        letter-spacing: -0.02em;
        margin: 0;
    }

    .alerts-subtitle {
        font-size: 14px;
        color: #667085;
        margin: 0;
    }

    /* Top Control Bar */
    .alerts-control-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        background-color: #ffffff;
        border: 1px solid #eaecf0;
        border-radius: 12px;
        padding: 6px 16px;
        box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
    }

    /* Filter Tabs (Figma Style) */
    .alerts-tabs {
        display: flex;
        align-items: center;
        gap: 8px;
        overflow-x: auto;
        padding: 4px 0;
    }

    .alerts-tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #667085;
        background: transparent;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
        text-decoration: none;
        position: relative;
    }

    .alerts-tab-btn:hover {
        color: #101828;
        background-color: #f8fafd;
    }

    .alerts-tab-btn.active {
        color: #0ba5ec;
        background-color: #f0f9ff;
    }

    .alerts-tab-btn.active::after {
        content: "";
        position: absolute;
        bottom: -6px;
        left: 12px;
        right: 12px;
        height: 2px;
        background-color: #0ba5ec;
        border-radius: 2px;
    }

    /* Tab Counter Badges */
    .tab-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 600;
        background-color: #f2f4f7;
        color: #475467;
        transition: all 0.2s ease;
    }

    .alerts-tab-btn.active .tab-badge {
        background-color: #0ba5ec;
        color: #ffffff;
    }

    .tab-badge-high {
        background-color: #fee4e2;
        color: #d92d20;
    }

    .alerts-tab-btn.active .tab-badge-high {
        background-color: #f04438;
        color: #ffffff;
    }

    .tab-badge-medium {
        background-color: #fef0c7;
        color: #b54708;
    }

    .alerts-tab-btn.active .tab-badge-medium {
        background-color: #f79009;
        color: #ffffff;
    }

    .tab-badge-resolved {
        background-color: #dcfae6;
        color: #079455;
    }

    .alerts-tab-btn.active .tab-badge-resolved {
        background-color: #12b76a;
        color: #ffffff;
    }

    /* Header Actions */
    .alerts-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alerts-search-box {
        position: relative;
        display: flex;
        align-items: center;
    }

    .alerts-search-box svg {
        position: absolute;
        left: 10px;
        width: 16px;
        height: 16px;
        stroke: #98a2b3;
    }

    .alerts-search-input {
        padding: 7px 12px 7px 32px;
        font-size: 13.5px;
        border: 1px solid #d0d5dd;
        border-radius: 8px;
        outline: none;
        width: 220px;
        transition: all 0.2s ease;
        background-color: #ffffff;
    }

    .alerts-search-input:focus {
        border-color: #0ba5ec;
        box-shadow: 0 0 0 3px rgba(11, 165, 236, 0.15);
        width: 260px;
    }

    .alerts-btn-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid #d0d5dd;
        background-color: #ffffff;
        color: #344054;
        transition: all 0.2s ease;
    }

    .alerts-btn-action:hover {
        background-color: #f8fafd;
        border-color: #0ba5ec;
        color: #0ba5ec;
    }

    .alerts-btn-action svg {
        width: 15px;
        height: 15px;
    }

    /* Alert List Container */
    .alerts-card-list {
        background-color: #ffffff;
        border: 1px solid #eaecf0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(16, 24, 40, 0.05);
        display: flex;
        flex-direction: column;
    }

    /* Individual Alert Row */
    .alert-row-item {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 16px;
        padding: 20px 24px;
        border-bottom: 1px solid #f2f4f7;
        align-items: flex-start;
        transition: background-color 0.18s ease, transform 0.18s ease;
    }

    .alert-row-item:last-child {
        border-bottom: none;
    }

    .alert-row-item:hover {
        background-color: #f8fafd;
    }

    .alert-row-item.is-resolved {
        background-color: #fafbfc;
        opacity: 0.88;
    }

    /* Left Icon Box */
    .alert-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .alert-icon-box svg {
        width: 22px;
        height: 22px;
    }

    /* Priority Colors */
    .icon-box-high {
        background-color: #fee4e2;
        color: #f04438;
    }

    .icon-box-medium {
        background-color: #fef0c7;
        color: #f79009;
    }

    .icon-box-low {
        background-color: #e0f2fe;
        color: #0ba5ec;
    }

    .icon-box-resolved {
        background-color: #ecfdf3;
        color: #12b76a;
    }

    /* Center Content */
    .alert-content-wrapper {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .alert-header-line {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    /* Badges */
    .alert-level-badge {
        display: inline-flex;
        align-items: center;
        padding: 3px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .badge-level-high {
        background-color: #fee4e2;
        color: #b42318;
    }

    .badge-level-medium {
        background-color: #fef0c7;
        color: #b54708;
    }

    .badge-level-low {
        background-color: #e0f2fe;
        color: #026aa2;
    }

    .badge-level-resolved {
        background-color: #ecfdf3;
        color: #027a48;
    }

    .alert-patient-name {
        font-size: 15px;
        font-weight: 700;
        color: #101828;
        cursor: pointer;
        transition: color 0.15s ease;
    }

    .alert-patient-name:hover {
        color: #0ba5ec;
        text-decoration: underline;
    }

    .alert-patient-room {
        font-size: 13.5px;
        color: #98a2b3;
        font-weight: 500;
    }

    .badge-resolved-status {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 11.5px;
        font-weight: 600;
        background-color: #ecfdf3;
        color: #027a48;
        border: 1px solid #a6f4c5;
    }

    /* Alert Title */
    .alert-title-text {
        font-size: 16px;
        font-weight: 700;
        color: #101828;
        margin: 0;
    }

    /* Alert Detail */
    .alert-description-text {
        font-size: 13.5px;
        color: #475467;
        line-height: 1.5;
        margin: 0;
    }

    /* Meta Line */
    .alert-meta-line {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        font-size: 12.5px;
        color: #667085;
        margin-top: 2px;
    }

    .alert-meta-time {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: #667085;
    }

    .alert-meta-assignee {
        color: #667085;
    }

    .vital-pill-highlight {
        display: inline-flex;
        align-items: center;
        padding: 1px 8px;
        border-radius: 4px;
        background-color: #f2f4f7;
        color: #344054;
        font-weight: 600;
        font-size: 11.5px;
    }

    /* Right Action Buttons (Figma Style) */
    .alert-actions-col {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 2px;
    }

    .btn-alert-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid transparent;
        background: transparent;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .btn-alert-detail {
        color: #0ba5ec;
        background-color: #f0f9ff;
        border-color: #b9e6fe;
    }

    .btn-alert-detail:hover {
        background-color: #e0f2fe;
        color: #0284c7;
    }

    .btn-alert-profile {
        color: #475467;
        background-color: #f8fafd;
        border-color: #eaecf0;
    }

    .btn-alert-profile:hover {
        background-color: #f2f4f7;
        color: #101828;
    }

    .btn-alert-resolve {
        color: #079455;
        background-color: #edfcf2;
        border-color: #abefc6;
    }

    .btn-alert-resolve:hover {
        background-color: #d3f8df;
        color: #027a48;
    }

    .btn-alert-resolved-done {
        color: #98a2b3;
        background-color: #f2f4f7;
        border-color: #eaecf0;
        cursor: default;
    }

    /* Empty state */
    .alerts-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 24px;
        text-align: center;
        gap: 12px;
    }

    .alerts-empty-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background-color: #f0f9ff;
        color: #0ba5ec;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 4px;
    }

    .alerts-empty-icon svg {
        width: 32px;
        height: 32px;
    }

    .alerts-empty-title {
        font-size: 16px;
        font-weight: 700;
        color: #101828;
        margin: 0;
    }

    .alerts-empty-desc {
        font-size: 14px;
        color: #667085;
        max-width: 400px;
        margin: 0;
    }

    /* ==========================================================================
       MODAL STYLES (DETAIL & RESOLUTION)
       ========================================================================== */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(16, 24, 40, 0.6);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        opacity: 0;
        visibility: hidden;
        transition: all 0.25s ease;
        padding: 16px;
    }

    .modal-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    .modal-dialog {
        background-color: #ffffff;
        border-radius: 16px;
        width: 100%;
        max-width: 620px;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 20px 24px -4px rgba(16, 24, 40, 0.1), 0 8px 8px -4px rgba(16, 24, 40, 0.04);
        transform: translateY(20px) scale(0.98);
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
    }

    .modal-overlay.active .modal-dialog {
        transform: translateY(0) scale(1);
    }

    .modal-header {
        padding: 20px 24px;
        border-bottom: 1px solid #eaecf0;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .modal-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .modal-header-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-title {
        font-size: 18px;
        font-weight: 700;
        color: #101828;
        margin: 0;
    }

    .modal-subtitle {
        font-size: 13px;
        color: #667085;
        margin: 0;
    }

    .modal-close-btn {
        background: transparent;
        border: none;
        color: #98a2b3;
        cursor: pointer;
        padding: 6px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
    }

    .modal-close-btn:hover {
        background-color: #f2f4f7;
        color: #101828;
    }

    .modal-close-btn svg {
        width: 20px;
        height: 20px;
    }

    .modal-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid #eaecf0;
        background-color: #f8fafd;
        border-bottom-left-radius: 16px;
        border-bottom-right-radius: 16px;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    /* Modal Form Elements */
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-label {
        font-size: 13.5px;
        font-weight: 600;
        color: #344054;
    }

    .form-input, .form-select, .form-textarea {
        width: 100%;
        padding: 10px 14px;
        font-size: 14px;
        border: 1px solid #d0d5dd;
        border-radius: 8px;
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s ease;
        font-family: inherit;
    }

    .form-input:focus, .form-select:focus, .form-textarea:focus {
        border-color: #0ba5ec;
        box-shadow: 0 0 0 3px rgba(11, 165, 236, 0.15);
    }

    .form-textarea {
        min-height: 80px;
        resize: vertical;
    }

    /* Modal Info Cards */
    .detail-info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .detail-info-card {
        padding: 12px 14px;
        border-radius: 10px;
        background-color: #f8fafd;
        border: 1px solid #eaecf0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .detail-info-label {
        font-size: 12px;
        color: #667085;
        font-weight: 500;
    }

    .detail-info-value {
        font-size: 15px;
        font-weight: 700;
        color: #101828;
    }

    .detail-ai-box {
        padding: 14px 16px;
        border-radius: 10px;
        background-color: #f0f9ff;
        border: 1px solid #b9e6fe;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .detail-ai-title {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13.5px;
        font-weight: 700;
        color: #026aa2;
    }

    .detail-ai-text {
        font-size: 13px;
        color: #344054;
        line-height: 1.5;
        margin: 0;
    }

    .modal-btn {
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1px solid transparent;
    }

    .btn-secondary {
        background-color: #ffffff;
        border-color: #d0d5dd;
        color: #344054;
    }

    .btn-secondary:hover {
        background-color: #f8fafd;
    }

    .btn-primary {
        background-color: #0ba5ec;
        color: #ffffff;
    }

    .btn-primary:hover {
        background-color: #0284c7;
    }

    .btn-success {
        background-color: #12b76a;
        color: #ffffff;
    }

    .btn-success:hover {
        background-color: #079455;
    }

    /* Toast Notification */
    .toast-notification {
        position: fixed;
        bottom: 24px;
        right: 24px;
        padding: 12px 20px;
        border-radius: 10px;
        background-color: #101828;
        color: #ffffff;
        font-size: 14px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 10px 15px -3px rgba(16, 24, 40, 0.2);
        z-index: 2000;
        transform: translateY(100px);
        opacity: 0;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .toast-notification.show {
        transform: translateY(0);
        opacity: 1;
    }

    @@media (max-width: 768px) {
        .alerts-control-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .alerts-header-actions {
            flex-direction: column;
        }

        .alerts-search-input {
            width: 100% !important;
        }

        .alert-row-item {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .alert-actions-col {
            justify-content: flex-start;
            flex-wrap: wrap;
        }

        .detail-info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="alerts-container">
    <!-- Header -->
    <div class="alerts-header">
        <h1 class="alerts-title">Cảnh báo & Thông báo</h1>
        <p class="alerts-subtitle">Cảnh báo AI và thông báo hệ thống dựa trên chỉ số cập nhật</p>
    </div>

    <!-- Control & Filter Bar -->
    <div class="alerts-control-bar">
        <!-- Tabs -->
        <div class="alerts-tabs" role="tablist">
            <button class="alerts-tab-btn active" data-filter="all">
                <span>Tất cả</span>
                <span class="tab-badge" id="badge-all">0</span>
            </button>
            <button class="alerts-tab-btn" data-filter="high">
                <span>Cao</span>
                <span class="tab-badge tab-badge-high" id="badge-high">0</span>
            </button>
            <button class="alerts-tab-btn" data-filter="medium">
                <span>Trung bình</span>
                <span class="tab-badge tab-badge-medium" id="badge-medium">0</span>
            </button>
            <button class="alerts-tab-btn" data-filter="low">
                <span>Thấp</span>
                <span class="tab-badge" id="badge-low">0</span>
            </button>
            <button class="alerts-tab-btn" data-filter="resolved">
                <span>Đã xử lý</span>
                <span class="tab-badge tab-badge-resolved" id="badge-resolved">0</span>
            </button>
        </div>

        <!-- Right Tools -->
        <div class="alerts-header-actions">
            <div class="alerts-search-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" class="alerts-search-input" id="alerts-search-input" placeholder="Tìm theo tên, phòng, bệnh..." />
            </div>

            <button class="alerts-btn-action" id="btn-sync-ai" title="Quét và phân tích lại các chỉ số sức khỏe mới nhất">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
                <span>Quét AI</span>
            </button>

            <button class="alerts-btn-action" id="btn-resolve-all" title="Đánh dấu tất cả cảnh báo là đã xử lý">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Xử lý tất cả</span>
            </button>
        </div>
    </div>

    <!-- Main Alert List -->
    <div class="alerts-card-list" id="alerts-list-container">
        <!-- Rendered via JavaScript -->
    </div>

    <!-- Empty State -->
    <div class="alerts-card-list alerts-empty-state" id="alerts-empty-state" style="display: none;">
        <div class="alerts-empty-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>
        <h3 class="alerts-empty-title">Không tìm thấy cảnh báo phù hợp</h3>
        <p class="alerts-empty-desc">Tất cả các chỉ số sức khỏe của người cao tuổi hiện đang ở mức ổn định hoặc không khớp với bộ lọc tìm kiếm.</p>
    </div>
</div>

<!-- ==========================================================================
   MODAL 1: CHI TIẾT CẢNH BÁO & PHÂN TÍCH AI
   ========================================================================== -->
<div class="modal-overlay" id="modal-detail-overlay">
    <div class="modal-dialog">
        <div class="modal-header">
            <div class="modal-header-left">
