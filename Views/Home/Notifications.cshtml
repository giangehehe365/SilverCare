</div>

<!-- Toast -->
<div class="toast-notification" id="toast-notify">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#12b76a" stroke-width="2">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
    <span id="toast-message">Đã cập nhật cảnh báo thành công!</span>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    // ==========================================================================
    // 1. STORAGE KEYS (STRICT SINGLE SOURCE OF TRUTH)
    // ==========================================================================
    const ELDERLY_STORAGE_KEY = "silvercare_elderly_profiles_v3";
    const HEALTH_STORAGE_KEY = "silvercare_health_today_updates_v3";
    const RESOLVED_STORAGE_KEY = "silvercare_alerts_resolved_v3";
    const ACTIVITY_STORAGE_KEY = "silvercare_recent_activities_v2";

    // Clean up obsolete mock keys
    localStorage.removeItem("silvercare_alerts_notifications_v2");
    localStorage.removeItem("silvercare_alerts_notifications_v1");

    // Standard baseline residents if storage is empty
    const defaultBaselineResidents = [
        {
            id: "NCT001",
            initials: "NVA",
            name: "Nguyễn Văn An",
            age: 78,
            gender: "Nam",
            room: "201",
            blood: "A+",
            status: "Trung bình",
            admissionDate: "15/05/2024",
            notes: "Theo dõi huyết áp định kỳ mỗi sáng, chế độ ăn giảm muối."
        },
        {
            id: "NCT002",
            initials: "LVB",
            name: "Lê Văn Bình",
            age: 82,
            gender: "Nam",
            room: "102",
            blood: "B+",
            status: "Trung bình",
            admissionDate: "10/11/2023",
            notes: "Thoái hóa khớp gối, cần hỗ trợ vận động và vật lý trị liệu."
        },
        {
            id: "NCT003",
            initials: "PTC",
            name: "Phạm Thị Cúc",
            age: 75,
            gender: "Nữ",
            room: "305",
            blood: "O+",
            status: "Trung bình",
            admissionDate: "20/02/2024",
            notes: "Tiền sử đường huyết dao động, kiểm tra sức khỏe hàng ngày."
        }
    ];

    // Standard baseline health measurements
    const defaultBaselineHealth = {
        "NCT001": { sys: 132, dia: 85, hr: 74, temp: 36.8, time: "11:03 hôm nay", note: "Huyết áp ổn định hơn hôm qua" },
        "NCT002": { sys: 124, dia: 73, hr: 68, temp: 37.2, time: "14:43 hôm nay", note: "Thân nhiệt tăng nhẹ, 37.2°C" },
        "NCT003": { sys: 105, dia: 65, hr: 83, temp: 37.6, time: "14:43 hôm nay", note: "Thân nhiệt tăng nhẹ, 37.6°C" }
    };

    let alertsData = [];
    let currentFilter = "all";
    let searchQuery = "";
    let activeAlertId = null;

    // DOM Elements
    const alertsListContainer = document.getElementById("alerts-list-container");
    const alertsEmptyState = document.getElementById("alerts-empty-state");
    const searchInput = document.getElementById("alerts-search-input");
    const tabButtons = document.querySelectorAll(".alerts-tab-btn");

    // Badges
    const badgeAll = document.getElementById("badge-all");
    const badgeHigh = document.getElementById("badge-high");
    const badgeMedium = document.getElementById("badge-medium");
    const badgeLow = document.getElementById("badge-low");
    const badgeResolved = document.getElementById("badge-resolved");

    // Detail Modal Elements
    const modalDetailOverlay = document.getElementById("modal-detail-overlay");
    const btnCloseDetail = document.getElementById("btn-close-detail");
    const detailPatientName = document.getElementById("detail-patient-name");
    const detailPatientMeta = document.getElementById("detail-patient-meta");
    const detailPatientId = document.getElementById("detail-patient-id");
    const detailPatientAge = document.getElementById("detail-patient-age");
    const detailPatientGender = document.getElementById("detail-patient-gender");
    const detailPatientBlood = document.getElementById("detail-patient-blood");
    const detailPatientNotes = document.getElementById("detail-patient-notes");
    const detailBadgeLevel = document.getElementById("detail-badge-level");
    const detailAlertTitle = document.getElementById("detail-alert-title");
    const detailAlertDesc = document.getElementById("detail-alert-desc");
    const detailValBp = document.getElementById("detail-val-bp");
    const detailValHr = document.getElementById("detail-val-hr");
    const detailValTemp = document.getElementById("detail-val-temp");
    const detailValStaff = document.getElementById("detail-val-staff");
    const detailAiRecommendation = document.getElementById("detail-ai-recommendation");
    const detailResolvedSection = document.getElementById("detail-resolved-section");
    const detailResolvedText = document.getElementById("detail-resolved-text");
    const detailIconBox = document.getElementById("detail-icon-box");
    const btnModalViewRecord = document.getElementById("btn-modal-view-record");
    const btnModalViewResident = document.getElementById("btn-modal-view-resident");
    const btnModalQuickResolve = document.getElementById("btn-modal-quick-resolve");

    // Resolve Modal Elements
    const modalResolveOverlay = document.getElementById("modal-resolve-overlay");
    const btnCloseResolve = document.getElementById("btn-close-resolve");
    const btnCancelResolve = document.getElementById("btn-cancel-resolve");
    const btnConfirmResolve = document.getElementById("btn-confirm-resolve");
    const resolveModalTitle = document.getElementById("resolve-modal-title");
    const resolveActionSelect = document.getElementById("resolve-action-select");
    const resolveNoteInput = document.getElementById("resolve-note-input");
    const resolveStaffName = document.getElementById("resolve-staff-name");

    // Toast
    const toastNotify = document.getElementById("toast-notify");
    const toastMessage = document.getElementById("toast-message");

    function showToast(msg) {
        if (!toastNotify) return;
        toastMessage.innerText = msg;
        toastNotify.classList.add("show");
        setTimeout(() => {
            toastNotify.classList.remove("show");
        }, 3000);
    }

    // ==========================================================================
    // 2. DYNAMIC HEALTH RECORD SCANNING & ALERT GENERATION
    // ==========================================================================
    function generateAlertsFromHealthRecords(showToastFeedback = false) {
        // Step A: Load real residents list from Elderly Profiles
        let residentsList = [];
        const rawElderly = localStorage.getItem(ELDERLY_STORAGE_KEY);
        if (rawElderly) {
            try {
                const parsed = JSON.parse(rawElderly);
                if (Array.isArray(parsed) && parsed.length > 0) residentsList = parsed;
                else residentsList = [...defaultBaselineResidents];
            } catch(e) { residentsList = [...defaultBaselineResidents]; }
        } else {
            residentsList = [...defaultBaselineResidents];
            localStorage.setItem(ELDERLY_STORAGE_KEY, JSON.stringify(residentsList));
        }

        // Step B: Load real health measurements
        let healthUpdates = {};
        const rawHealth = localStorage.getItem(HEALTH_STORAGE_KEY);
        if (rawHealth) {
            try {
                const parsed = JSON.parse(rawHealth);
                delete parsed["row-1"];
                delete parsed["row-2"];
                delete parsed["row-3"];
                healthUpdates = { ...defaultBaselineHealth, ...parsed };
                localStorage.setItem(HEALTH_STORAGE_KEY, JSON.stringify(healthUpdates));
            } catch(e) { 
                healthUpdates = { ...defaultBaselineHealth }; 
                localStorage.setItem(HEALTH_STORAGE_KEY, JSON.stringify(healthUpdates));
            }
        } else {
            healthUpdates = { ...defaultBaselineHealth };
            localStorage.setItem(HEALTH_STORAGE_KEY, JSON.stringify(healthUpdates));
        }

        // Step C: Load resolved states map
        let resolvedMap = {};
        const rawResolved = localStorage.getItem(RESOLVED_STORAGE_KEY);
        if (rawResolved) {
            try {
                resolvedMap = JSON.parse(rawResolved);
            } catch(e) { resolvedMap = {}; }
        }

        const generatedAlerts = [];

        // Step D: Evaluate clinical thresholds strictly per patient
        residentsList.forEach(res => {
            const m = healthUpdates[res.id] || (defaultBaselineHealth[res.id] ? defaultBaselineHealth[res.id] : null);
            const roomLabel = res.room ? (res.room.toString().startsWith("Phòng") ? res.room : `Phòng ${res.room}`) : "Phòng ---";
            const resNotes = res.notes || "";

            if (!m || typeof m.sys !== "number" || m.time === "Chưa đo hôm nay") {
                // If patient has condition requiring monitoring from profile notes
                if (res.status === "Cần theo dõi" || resNotes.toLowerCase().includes("huyết áp") || resNotes.toLowerCase().includes("đường huyết")) {
                    const alertKey = `alt-${res.id}-profile-check`;
                    const resState = resolvedMap[alertKey] || null;
                    generatedAlerts.push({
                        id: alertKey,
                        patientId: res.id,
                        patientName: res.name,
                        patientAge: res.age || 75,
                        patientGender: res.gender || "---",
                        patientBlood: res.blood || "O+",
                        patientAdmission: res.admissionDate || "15/05/2024",
                        patientNotes: resNotes || "Cần theo dõi sức khỏe định kỳ theo hồ sơ bệnh án.",
                        room: roomLabel,
                        level: res.status === "Cần theo dõi" ? "high" : "medium",
                        title: "Cần đo & cập nhật chỉ số hôm nay",
                        description: `Hồ sơ bệnh án ghi nhận: ${resNotes || 'Bệnh nhân chưa có chỉ số sinh hiệu đo trong ngày hôm nay.'}`,
                        time: "Hôm nay",
                        assignee: "@fullName" || "Nguyễn Thị Lan",
                        vitalsSummary: "Chưa cập nhật sinh hiệu hôm nay",
                        sys: null,
                        dia: null,
                        hr: null,
                        temp: null,
                        isResolved: !!resState,
                        resolvedAt: resState?.resolvedAt || null,
                        resolvedNote: resState?.resolvedNote || null,
                        resolvedBy: resState?.resolvedBy || null,
                        aiRecommendation: "Khuyến nghị điều dưỡng ca trực thực hiện đo kiểm tra huyết áp, nhịp tim và thân nhiệt cho người bệnh."
                    });
                }
                return;
            }

            const sys = m.sys;
            const dia = m.dia;
            const hr = m.hr;
            const temp = m.temp;
            const timeStr = m.time || "Hôm nay";

            // 1. EVALUATE BLOOD PRESSURE
            if (sys >= 140 || dia >= 90) {
                const isHighGrade = sys >= 160 || dia >= 100;
                const alertKey = `alt-${res.id}-bp`;
                const resState = resolvedMap[alertKey] || null;
                generatedAlerts.push({
                    id: alertKey,
                    patientId: res.id,
                    patientName: res.name,
                    patientAge: res.age || 78,
                    patientGender: res.gender || "Nam",
                    patientBlood: res.blood || "A+",
                    patientAdmission: res.admissionDate || "15/05/2024",
                    patientNotes: resNotes || "Theo dõi huyết áp định kỳ.",
                    room: roomLabel,
                    level: "high",
                    title: isHighGrade ? "Huyết áp tăng cao bất thường (Độ 2)" : "Huyết áp cao",
                    description: `Huyết áp tâm thu/tâm trương cập nhật đạt ${sys}/${dia} mmHg, vượt ngưỡng tiêu chuẩn an toàn (140/90 mmHg).`,
                    time: timeStr,
                    assignee: "@fullName" || "Nguyễn Thị Lan",
                    vitalsSummary: `HA: ${sys}/${dia} mmHg · NT: ${hr} bpm`,
                    sys: sys,
                    dia: dia,
                    hr: hr,
                    temp: temp,
                    isResolved: !!resState,
                    resolvedAt: resState?.resolvedAt || null,
                    resolvedNote: resState?.resolvedNote || null,
                    resolvedBy: resState?.resolvedBy || null,
                    aiRecommendation: `Chỉ số huyết áp ${sys}/${dia} mmHg thuộc nhóm tăng huyết áp độ ${isHighGrade ? "2" : "1"}. Đề xuất nhân viên kiểm tra lại sau 30 phút nghỉ ngơi, nhắc nhở uống thuốc hạ áp theo đơn và hạn chế muối trong bữa ăn.`
                });
            } else if ((sys < 90 && sys > 0) || (dia < 60 && dia > 0)) {
                const alertKey = `alt-${res.id}-bp-low`;
                const resState = resolvedMap[alertKey] || null;
                generatedAlerts.push({
                    id: alertKey,
                    patientId: res.id,
                    patientName: res.name,
                    patientAge: res.age || 75,
                    patientGender: res.gender || "---",
                    patientBlood: res.blood || "O+",
                    patientAdmission: res.admissionDate || "15/05/2024",
                    patientNotes: resNotes || "Theo dõi huyết áp.",
                    room: roomLabel,
                    level: "medium",
                    title: "Huyết áp thấp",
                    description: `Huyết áp ghi nhận ở mức ${sys}/${dia} mmHg, thấp hơn ngưỡng chuẩn an toàn.`,
                    time: timeStr,
                    assignee: "@fullName" || "Nguyễn Thị Lan",
                    vitalsSummary: `HA: ${sys}/${dia} mmHg · NT: ${hr} bpm`,
                    sys: sys,
                    dia: dia,
                    hr: hr,
                    temp: temp,
                    isResolved: !!resState,
                    resolvedAt: resState?.resolvedAt || null,
                    resolvedNote: resState?.resolvedNote || null,
                    resolvedBy: resState?.resolvedBy || null,
                    aiRecommendation: "Cho người bệnh nằm nghỉ, nâng cao nhẹ chi dưới, bổ sung nước ấm và theo dõi sát tránh choáng ngất khi đổi tư thế."
                });
            }

            // 2. EVALUATE HEART RATE
            if (hr > 100) {
                const alertKey = `alt-${res.id}-hr-high`;
                const resState = resolvedMap[alertKey] || null;
                generatedAlerts.push({
                    id: alertKey,
