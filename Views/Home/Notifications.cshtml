            <!-- Vitals Grid -->
            <div class="detail-info-grid">
                <div class="detail-info-card">
                    <span class="detail-info-label">Huyết áp đo gần nhất</span>
                    <span class="detail-info-value" id="detail-val-bp">148/96 mmHg</span>
                </div>
                <div class="detail-info-card">
                    <span class="detail-info-label">Nhịp tim</span>
                    <span class="detail-info-value" id="detail-val-hr">74 bpm</span>
                </div>
                <div class="detail-info-card">
                    <span class="detail-info-label">Thân nhiệt</span>
                    <span class="detail-info-value" id="detail-val-temp">36.8 &deg;C</span>
                </div>
                <div class="detail-info-card">
                    <span class="detail-info-label">Điều dưỡng phụ trách</span>
                    <span class="detail-info-value" id="detail-val-staff">Nguyễn Thị Lan</span>
                </div>
            </div>

            <!-- AI Diagnosis & Action Plan -->
            <div class="detail-ai-box">
                <div class="detail-ai-title">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <span>Phân tích & Khuyến nghị y tế AI</span>
                </div>
                <p class="detail-ai-text" id="detail-ai-recommendation">
                    Chỉ số đo được vượt ngưỡng bình thường. Đề xuất nhân viên kiểm tra lại huyết áp sau 30 phút nghỉ ngơi, nhắc nhở uống thuốc hạ huyết áp theo đúng toa và báo cáo bác sĩ nếu tình trạng tiếp tục kéo dài.
                </p>
