@{
    var fullName = Context.Session.GetString("FullName") ?? TempData["FullName"] as string ?? "Nguyễn Thị Lan";
    var role = Context.Session.GetString("Role") ?? TempData["Role"] as string ?? "Nhân viên";
    
    // Compute initials for avatar (e.g., "Nguyễn Thị Lan" -> "NTL")
    string initials = "NTL";
    if (!string.IsNullOrEmpty(fullName))
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 3)
        {
            initials = $"{parts[0][0]}{parts[parts.Length-2][0]}{parts[parts.Length-1][0]}".ToUpper();
        }
        else if (parts.Length > 0)
        {
            initials = string.Join("", parts.Select(p => p[0])).ToUpper();
            if (initials.Length > 3) initials = initials.Substring(0, 3);
        }
    }

    var roleSubtitle = role == "Nhân viên" ? "Nhân viên chăm sóc" : (role == "Người nhà" ? "Người nhà thân nhân" : role);
    
    // Keep TempData values for the next request in case of redirects/refreshes
    TempData.Keep("FullName");
    TempData.Keep("Role");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>@ViewData["Title"] - SilverCare</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>

    <div class="dashboard-wrapper">
        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <!-- Logo Heart Icon -->
                    <svg viewBox="0 0 24 24">
                        <path d="M12 21s-7-4.35-9.33-8.36C.5 8.9 2.11 5 5.7 5 7.65 5 9.03 6.06 12 9 14.97 6.06 16.35 5 18.3 5 21.89 5 23.5 8.9 21.33 12.64 19 16.65 12 21 12 21z" />
                    </svg>
                </div>
                <span class="sidebar-brand-name">SilverCare</span>
            </div>

            <ul class="sidebar-menu">
                @{
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                }
                <!-- Dashboard -->
                <li class="sidebar-menu-item @(currentAction == "Dashboard" ? "active" : "")">
                    <a href="@Url.Action("Dashboard", "Home")" class="sidebar-menu-link">
                        <!-- Grid Icon -->
                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="3" width="7" height="9" rx="1" />
                            <rect x="14" y="3" width="7" height="5" rx="1" />
                            <rect x="14" y="12" width="7" height="9" rx="1" />
                            <rect x="3" y="16" width="7" height="5" rx="1" />
                        </svg>
                        <span>Dashboard</span>
                    </a>
                </li>

                <!-- Hồ sơ người cao tuổi -->
                <li class="sidebar-menu-item @(currentAction == "Residents" ? "active" : "")">
                    <a href="@Url.Action("Residents", "Home")" class="sidebar-menu-link">
                        <!-- Users Icon -->
                        <svg viewBox="0 0 24 24">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        <span>Hồ sơ người cao tuổi</span>
                    </a>
                </li>

                <!-- Lịch chăm sóc -->
                <li class="sidebar-menu-item @(currentAction == "Schedule" ? "active" : "")">
                    <a href="@Url.Action("Schedule", "Home")" class="sidebar-menu-link">
                        <!-- Calendar Icon -->
                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                            <line x1="16" y1="2" x2="16" y2="6" />
                            <line x1="8" y1="2" x2="8" y2="6" />
                            <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                        <span>Lịch chăm sóc</span>
                    </a>
                </li>

                <!-- Theo dõi sức khỏe -->
                <li class="sidebar-menu-item @(currentAction == "Health" ? "active" : "")">
                    <a href="@Url.Action("Health", "Home")" class="sidebar-menu-link">
                        <!-- Activity / Pulse Icon -->
                        <svg viewBox="0 0 24 24">
                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                        </svg>
                        <span>Theo dõi sức khỏe</span>
                    </a>
                </li>

                <!-- Cảnh báo & Thông báo -->
                <li class="sidebar-menu-item @(currentAction == "Notifications" || currentAction == "Alerts" ? "active" : "")">
                    <a href="@Url.Action("Notifications", "Home")" class="sidebar-menu-link">
                        <!-- Bell Icon -->
                        <svg viewBox="0 0 24 24">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                        </svg>
                        <span>Cảnh báo & Thông báo</span>
                    </a>
                </li>

                <!-- AI Assistant -->
                <li class="sidebar-menu-item">
                    <a href="#" class="sidebar-menu-link">
                        <!-- Message Sparkle Icon (AI) -->
                        <svg viewBox="0 0 24 24">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                        </svg>
                        <span>AI Assistant</span>
                    </a>
                </li>

                <!-- Báo cáo -->
                <li class="sidebar-menu-item @(currentAction == "Report" ? "active" : "")">
                    <a href="@Url.Action("Report", "Home")" class="sidebar-menu-link">
                        <!-- File Text Icon -->
                        <svg viewBox="0 0 24 24">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="16" y1="13" x2="8" y2="13" />
                            <line x1="16" y1="17" x2="8" y2="17" />
                            <polyline points="10 9 9 9 8 9" />
                        </svg>
                        <span>Báo cáo</span>
                    </a>
                </li>

                <!-- Quản lý thuốc -->
                <li class="sidebar-menu-item @(currentAction == "Medicine" ? "active" : "")">
                    <a href="@Url.Action("Medicine", "Home")" class="sidebar-menu-link">
                        <!-- Pill / Capsule Icon (Custom SVG) -->
                        <svg viewBox="0 0 24 24">
                            <path d="M10.5 3a5.5 5.5 0 0 0-5.5 5.5v7a5.5 5.5 0 0 0 11 0v-7A5.5 5.5 0 0 0 10.5 3z" style="transform: rotate(45deg); transform-origin: 12px 12px;" />
                            <line x1="6" y1="18" x2="18" y2="6" />
                        </svg>
                        <span>Quản lý thuốc</span>
                    </a>
                </li>

                <!-- Cài đặt -->
                <li class="sidebar-menu-item @(currentAction == "Profile" || currentAction == "Settings" ? "active" : "")">
                    <a href="@Url.Action("Profile", "Home")" class="sidebar-menu-link">
                        <!-- Settings / Gear Icon -->
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="3" />
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                        </svg>
                        <span>Cài đặt</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <button class="sidebar-toggle-btn" id="sidebar-toggle" title="Thu gọn sidebar">
                    <!-- Collapse / Menu Icon -->
                    <svg viewBox="0 0 24 24">
                        <line x1="3" y1="12" x2="21" y2="12" />
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <line x1="3" y1="18" x2="21" y2="18" />
                    </svg>
                </button>
            </div>
        </aside>

        <!-- MAIN CONTENT AREA -->
        <main class="main-content" id="main-content">
            <!-- TOPBAR -->
            <header class="topbar">
                <!-- Topbar Search -->
                <div class="topbar-search">
                    <svg viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" class="topbar-search-input" placeholder="Tìm kiếm hồ sơ, người cao tuổi, lịch hẹn..." />
                </div>

                <!-- Right Actions -->
                <div class="topbar-actions">
                    <!-- Bell Notifications -->
                    <a href="@Url.Action("Notifications", "Home")" class="topbar-icon-btn" title="Cảnh báo & Thông báo">
                        <svg viewBox="0 0 24 24">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                        </svg>
                        <span class="badge-dot"></span>
                    </a>

                    <!-- Messages -->
                    <button class="topbar-icon-btn" title="Tin nhắn">
                        <svg viewBox="0 0 24 24">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                        </svg>
                    </button>

                    <div class="topbar-divider"></div>

                    <!-- Profile Dropdown -->
                    <div class="topbar-profile-wrapper" id="userProfileWrapper">
                        <div class="topbar-profile" id="userProfileDropdown" role="button" aria-haspopup="true" aria-expanded="false" tabindex="0">
                            <div class="profile-avatar">@initials</div>
                            <span class="profile-name">@fullName</span>
                            <span class="profile-chevron">
                                <svg viewBox="0 0 24 24">
                                    <polyline points="6 9 12 15 18 9" />
                                </svg>
                            </span>
                        </div>

                        <!-- Dropdown Menu -->
                        <div class="profile-dropdown-menu" id="userProfileMenu">
                            <div class="profile-dropdown-header">
                                <div class="dropdown-user-name">@fullName</div>
                                <div class="dropdown-user-role">@roleSubtitle</div>
                            </div>
                            <div class="profile-dropdown-divider"></div>
                            <ul class="profile-dropdown-list">
                                <li>
                                    <a href="@Url.Action("Profile", "Home", new { tab = "profile" })" class="profile-dropdown-item">
                                        <svg class="dropdown-item-icon" viewBox="0 0 24 24">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="12" cy="7" r="4"></circle>
                                        </svg>
                                        <span>Hồ sơ cá nhân</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="@Url.Action("Profile", "Home", new { tab = "password" })" class="profile-dropdown-item">
                                        <svg class="dropdown-item-icon" viewBox="0 0 24 24">
                                            <circle cx="7.5" cy="15.5" r="4.5"></circle>
                                            <path d="m21 3-9.5 9.5"></path>
                                            <path d="m15.5 7.5 3 3"></path>
                                        </svg>
                                        <span>Đổi mật khẩu</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="@Url.Action("Profile", "Home", new { tab = "permissions" })" class="profile-dropdown-item">
                                        <svg class="dropdown-item-icon" viewBox="0 0 24 24">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                        </svg>
                                        <span>Phân quyền tài khoản</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="@Url.Action("Logout", "Home")" class="profile-dropdown-item logout-item" id="logoutBtn" onclick="handleLogout(event, '@Url.Action("Logout", "Home")')">
                                        <svg class="dropdown-item-icon logout-icon" viewBox="0 0 24 24">
                                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                            <polyline points="16 17 21 12 16 7"></polyline>
                                            <line x1="21" y1="12" x2="9" y2="12"></line>
                                        </svg>
                                        <span>Đăng xuất</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Content Body -->
            <section class="content-body">
                @RenderBody()
            </section>

            <!-- Floating Help Button -->
            <button type="button" class="floating-help-btn" title="Trợ giúp & Hỗ trợ">?</button>
        </main>
    </div>

    <!-- Scripts Section -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Sidebar toggle
            const sidebar = document.getElementById("sidebar");
            const mainContent = document.getElementById("main-content");
            const toggleBtn = document.getElementById("sidebar-toggle");

            if (toggleBtn && sidebar && mainContent) {
                toggleBtn.addEventListener("click", function () {
                    sidebar.classList.toggle("collapsed");
                    mainContent.classList.toggle("sidebar-collapsed");
                });
            }

            // Profile Dropdown Toggle
            const profileWrapper = document.getElementById("userProfileWrapper");
            const profileBtn = document.getElementById("userProfileDropdown");

            if (profileBtn && profileWrapper) {
                profileBtn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    const isExpanded = profileWrapper.classList.toggle("active");
                    profileBtn.setAttribute("aria-expanded", isExpanded);
                });

                document.addEventListener("click", function (e) {
                    if (!profileWrapper.contains(e.target)) {
                        profileWrapper.classList.remove("active");
                        profileBtn.setAttribute("aria-expanded", "false");
                    }
                });

                document.addEventListener("keydown", function (e) {
                    if (e.key === "Escape" && profileWrapper.classList.contains("active")) {
                        profileWrapper.classList.remove("active");
                        profileBtn.setAttribute("aria-expanded", "false");
                    }
                });
            }
        });

        // Logout handler function
        function handleLogout(event, logoutUrl) {
            if (event) event.preventDefault();
            try {
                sessionStorage.clear();
                localStorage.removeItem('silvercare_session');
            } catch (e) {}

            if (window.history && window.history.replaceState) {
                window.history.replaceState(null, '', '@Url.Action("Index", "Home")');
            }
            window.location.replace(logoutUrl || '@Url.Action("Logout", "Home")');
        }

        // Prevent restoring page from browser cache (bfcache) on Back button
        window.addEventListener('pageshow', function (event) {
            if (event.persisted || (window.performance && window.performance.getEntriesByType && window.performance.getEntriesByType("navigation")[0]?.type === "back_forward")) {
                window.location.reload();
            }
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
